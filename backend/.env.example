# ArchDisc Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyC8xY2BmdRQ_NewKey_Example_abc123xyz

# Optional: Specify Gemini model (defaults to gemini-pro if not set)
# Recommended models for 3D design generation:
#   - gemini-1.5-pro (best quality, uses v1beta API automatically)
#   - gemini-1.5-flash (faster, balanced quality)
#   - gemini-pro (stable, older model)
# Note: Gemini 1.5 models automatically use v1beta API
# GEMINI_MODEL=gemini-1.5-pro

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc
