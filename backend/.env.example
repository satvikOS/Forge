# ============ AWS Configuration ============

# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Bedrock Configuration (for basic autonomous agent)
BEDROCK_TEXT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_IMAGE_MODEL=stability.stable-diffusion-xl-v1
BEDROCK_VIDEO_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# AWS S3 for Model Storage
AWS_S3_BUCKET=archdisc-models

# AWS Lambda for AI Agents
AWS_LAMBDA_PREFIX=archdisc-agent

# ============ LLM APIs for Advanced Autonomous Agent ============

# PRIMARY: Anthropic Claude Sonnet 4.5 (for UI control and reasoning)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# VISION: Google Gemini 2.0 Flash (for screenshot validation)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=xxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash-exp

# ALTERNATIVE: OpenAI GPT-4 Vision (optional, for additional validation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_VISION_MODEL=gpt-4-vision-preview

# ============ Autonomous Agent Configuration ============

# Enable autonomous features
AUTONOMOUS_MODE=true
ENABLE_UI_CONTROL=true

# Browser automation (Playwright) - for UI-controlled agent
BROWSER_HEADLESS=false  # Set true for production/serverless
SCREENSHOT_INTERVAL=2000  # ms between screenshots
MAX_RETRIES=3  # Max retries per UI action
AUTO_VALIDATE=true  # Use vision to validate each step

# Frontend URL for agent to control
FRONTEND_URL=https://d3a7j7euh4gge.cloudfront.net
# Or for local dev: http://localhost:3000

# ============ Safety & Cost Limits ============

# Human approval required for certain actions
REQUIRE_APPROVAL_FOR_EXPORT=true
REQUIRE_APPROVAL_FOR_DELETE=true
REQUIRE_APPROVAL_FOR_SIMULATION=false

# Cost limits ($ per session)
MAX_LLM_COST_PER_SESSION=5.00
ALERT_AT_COST=2.50

# ============ Database ============

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=archdisc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ============ External APIs ============

MAPBOX_ACCESS_TOKEN=your_mapbox_token
SKETCHFAB_API_TOKEN=your_sketchfab_token

# ============ Server Configuration ============

PORT=3001
NODE_ENV=development
STAGE=dev

# API Base URL
API_BASE_URL=https://qmgj3s9wse.execute-api.us-east-1.amazonaws.com/dev

# ============ Monitoring & Logging ============

LOG_LEVEL=info  # debug|info|warn|error

# ============ Feature Flags ============

ENABLE_AUTONOMOUS_AGENT=true
ENABLE_BEDROCK=true
ENABLE_GEMINI_VISION=true
ENABLE_BROWSER_AUTOMATION=true
