# ==========================================
# ArchDisc Backend Configuration
# Complete Environment Variables Template
# ==========================================
# 
# Instructions:
# 1. Copy this file to `.env` in the backend directory
# 2. Replace all placeholder values (your_*_here) with actual keys
# 3. Enable/disable features by setting ENABLE_* flags to true/false
# 4. For Vercel: Add these same variables in Project Settings > Environment Variables
#
# Phase Guide:
# - Phase 1: Multi-variant generation (GEMINI_API_KEY required)
# - Phase 2: Axel 3D Voxel Engine (AXEL_* settings)
# - Phase 3: Full 3D generation (TRIPO_API_KEY or MESHY_API_KEY required)
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development

# ==========================================
# PHASE 1: CORE AI (REQUIRED FOR ALL PHASES)
# ==========================================

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# REQUIRED: This is the foundation for all AI-powered features
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ==========================================
# FREE APIs (Already integrated, just enable)
# ==========================================

# Master Orchestration System
ENABLE_ORCHESTRATOR=true

# Wikipedia API - Landmark and building information
ENABLE_WIKIPEDIA=true

# Wikidata API - Structured architectural data and dimensions
ENABLE_WIKIDATA=true

# Wikimedia Commons API - High-resolution reference images
ENABLE_WIKIMEDIA=true

# Overpass API (OpenStreetMap) - Real building data and road networks
ENABLE_OVERPASS=true

# Open-Elevation API - Terrain elevation data
ENABLE_OPEN_ELEVATION=true

# Open-Meteo API - Weather and lighting conditions
ENABLE_OPEN_METEO=true

# Tree Map - Vegetation and canopy data
ENABLE_TREE_MAP=true

# ==========================================
# 3D MODELS (Optional - You have the key!)
# ==========================================

# Sketchfab API Configuration
# Get your API token from: https://sketchfab.com/settings/password
SKETCHFAB_API_TOKEN=your_sketchfab_api_token_here
SKETCHFAB_ENABLED=false

# ==========================================
# GEOGRAPHIC DATA (Optional - You have the key!)
# ==========================================

# Mapbox API Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
# Provides: Satellite imagery, terrain data, building footprints, vector tiles
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
MAPBOX_ENABLED=false

# ==========================================
# STREET-LEVEL IMAGERY (Optional - You have the key!)
# ==========================================

# Mapillary API Configuration
# Get your client ID from: https://www.mapillary.com/dashboard/developers
# Provides: Street-level photos, building facades, environmental context
MAPILLARY_CLIENT_ID=your_mapillary_client_id_here
MAPILLARY_ENABLED=false

# ==========================================
# PHASE 3: AI 3D GENERATION (CRITICAL - REQUIRED FOR 3D MODELS)
# ==========================================

# Without these keys, variants will show but no 3D models will generate!
# You need at least ONE of: TRIPO_API_KEY or MESHY_API_KEY

# Tripo AI - Text-to-3D and Image-to-3D (Recommended - Faster & Cheaper)
# Sign up: https://www.tripo3d.ai/
# Free tier: 300 credits/month (enough for 15-30 models)
TRIPO_API_KEY=your_tripo_key_here

# Meshy AI - High-quality 3D with PBR materials (Premium Option)
# Sign up: https://www.meshy.ai/
# Free tier: 200 credits/month (enough for 7-10 models)
MESHY_API_KEY=your_meshy_key_here

# Google Cloud Vertex AI - Imagen for concept art
# Setup: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
GOOGLE_CLOUD_PROJECT_ID=your_project_id
VERTEX_AI_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagegeneration@006
GOOGLE_APPLICATION_CREDENTIALS=./config/vertex-ai-key.json

# Budget Controls
ENABLE_AI_3D_GENERATION=true
DEFAULT_GENERATION_MODE=ultra_cheap
USE_FREE_TIER_FIRST=true
ENABLE_IMAGE_TO_3D_PIPELINE=true

# Free Tier Limits (Monthly Reset on 1st)
TRIPO_FREE_CREDITS_MONTHLY=300
MESHY_FREE_CREDITS_MONTHLY=200
VERTEX_IMAGEN_FREE_MONTHLY=1000

# Cost per Generation (in credits/USD)
TRIPO_IMAGE_TO_3D_COST=20
TRIPO_TEXT_TO_3D_COST=10
MESHY_IMAGE_TO_3D_COST=30
MESHY_TEXT_TO_3D_COST=20
VERTEX_IMAGEN_COST=0.002

# Caching Strategy
ENABLE_MODEL_CACHE=true
MODEL_CACHE_TTL_DAYS=30
CACHE_SIMILARITY_THRESHOLD=0.85

# Budget Limits & Alerts
MAX_MONTHLY_BUDGET_USD=5
ALERT_AT_BUDGET_PERCENT=75
STOP_GENERATION_AT_BUDGET_PERCENT=95

# ==========================================
# PERFORMANCE
# ==========================================

# API timeout in milliseconds
API_TIMEOUT_MS=10000

# Maximum parallel API requests
MAX_PARALLEL_REQUESTS=10

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ==========================================
# PHASE 2: AXEL VOXEL ENGINE (True Vision - Micron-Level Analysis)
# ==========================================

# Master Toggle - Set to false to disable all Axel processing
AXEL_ENABLED=true

# Voxel Resolution Control
# Options: 'adaptive' (recommended), 'high', 'medium', 'low'
AXEL_RESOLUTION=adaptive

# Performance Tuning
AXEL_MAX_VOXELS=100000000
AXEL_LOD_LEVELS=1000,100,10,1,0.1,0.01
AXEL_TARGET_TIME=10000

# Analysis Layer Toggles (all default to true)
# Disable individual layers for faster processing if needed
AXEL_ENABLE_METROLOGY=true     # Geometry analysis (micron-level accuracy)
AXEL_ENABLE_CHEMICAL=true      # Material composition matching
AXEL_ENABLE_FLAWS=true         # Age-based wear and weathering
AXEL_ENABLE_TOOLING=true       # Period-correct manufacturing marks
AXEL_ENABLE_ENVIRONMENT=true   # Location/weather/lighting composition

# ==========================================
# CORS & SECURITY (CRITICAL FOR VERCEL DEPLOYMENT)
# ==========================================

# CORS Configuration
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For Vercel deployment, ADD YOUR FRONTEND DOMAIN:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc

# ==========================================
# QUICK START CHECKLIST
# ==========================================
# 
# Minimum Required (Phase 1 - Variants Only):
# ✅ GEMINI_API_KEY
# 
# For Full 3D Generation (Phase 3):
# ✅ GEMINI_API_KEY
# ✅ TRIPO_API_KEY or MESHY_API_KEY (at least one)
# 
# For Vercel Deployment:
# ✅ GEMINI_API_KEY
# ✅ TRIPO_API_KEY or MESHY_API_KEY
# ✅ ALLOWED_ORIGINS (with your frontend domain)
# 
# Optional Enhancements:
# ⭐ AXEL_ENABLED=true (Phase 2 - Micron-level realism)
# ⭐ SKETCHFAB_API_TOKEN (Reference 3D models)
# ⭐ MAPBOX_ACCESS_TOKEN (Geographic data)
# ⭐ All FREE APIs already enabled by default
# 
# ==========================================
