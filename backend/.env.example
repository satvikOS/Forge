# ==========================================
# ArchDisc Backend Configuration
# Complete Environment Variables Template - ALL PHASES
# ==========================================
# 
# Instructions:
# 1. Copy this file to `.env` in the backend directory
# 2. Replace all placeholder values (your_*_here) with actual keys
# 3. Enable/disable features by setting ENABLE_* flags to true/false
# 4. For Vercel: Add these same variables in Project Settings > Environment Variables
#
# ArchDisc Complete Pipeline Guide:
# - Phase 1: Multi-variant generation (GEMINI_API_KEY required)
# - Phase 2: Axel 3D Voxel Engine with micron-level precision (AXEL_* settings)
# - Phase 3: Full 3D model generation (TRIPO/MESHY required)
# - Phase 4: Real-world data enrichment (Wikipedia, OpenStreetMap, OpenMeteo, Mapbox, Mapillary)
# - Phase 5: Vertex AI integration for photorealistic rendering
# 
# This template includes EVERYTHING needed for start-to-end ArchDisc operation.
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development

# ==========================================
# PHASE 1: CORE AI (REQUIRED FOR ALL PHASES)
# ==========================================

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# REQUIRED: This is the foundation for all AI-powered features
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ==========================================
# PHASE 4: REAL-WORLD DATA PIPELINE (FREE APIs - NO KEYS NEEDED)
# ==========================================
# These services provide micron-level precision through real-world data enrichment

# Master Orchestration System
# Coordinates all data sources for optimal accuracy
ENABLE_ORCHESTRATOR=true

# Wikipedia API - Landmark and building information
# Provides: Historical context, construction dates, materials, dimensions
# Free: Unlimited requests (rate limit: 200 req/sec)
ENABLE_WIKIPEDIA=true

# Wikidata API - Structured architectural data and dimensions
# Provides: Precise measurements, GPS coordinates, architectural styles
# Free: Unlimited requests (rate limit: 500 req/sec)
ENABLE_WIKIDATA=true

# Wikimedia Commons API - High-resolution reference images
# Provides: Photos for photogrammetry, texture analysis, visual verification
# Free: Unlimited image access
ENABLE_WIKIMEDIA=true

# Overpass API (OpenStreetMap) - Real building data and road networks
# Provides: Building footprints, heights, materials, street layouts, POI data
# Free: Unlimited (rate limit: 2 req/sec, be respectful)
ENABLE_OVERPASS=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Open-Elevation API - Terrain elevation data
# Provides: DEM data for terrain modeling, slope analysis
# Free: Unlimited requests
ENABLE_OPEN_ELEVATION=true
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# Open-Meteo API - Weather and lighting conditions
# Provides: Historical weather, solar position, atmospheric conditions
# Free: 10,000 requests/day (no key needed)
ENABLE_OPEN_METEO=true
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# Tree Map - Vegetation and canopy data
# Provides: Urban greenery, tree species, canopy coverage
# Free: Available through OpenStreetMap
ENABLE_TREE_MAP=true

# ==========================================
# REFERENCE 3D MODELS (Optional)
# ==========================================

# Sketchfab API Configuration
# Get your API token from: https://sketchfab.com/settings/password
# Provides: Reference 3D models for architectural elements, styles
# Free tier: Browse and download CC-licensed models
# Paid: $15/month for premium access
SKETCHFAB_API_TOKEN=your_sketchfab_api_token_here
SKETCHFAB_ENABLED=false

# ==========================================
# ADVANCED GEOGRAPHIC DATA (Optional but Recommended for Precision)
# ==========================================

# Mapbox API Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
# Provides: High-res satellite imagery, 3D terrain, building footprints, vector tiles
# Free tier: 50,000 tile requests/month
# Paid: $5 per 1,000 requests after free tier
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
MAPBOX_ENABLED=false
MAPBOX_STYLE=mapbox://styles/mapbox/satellite-v9

# ==========================================
# STREET-LEVEL IMAGERY (Recommended for Facade Analysis)
# ==========================================

# Mapillary API Configuration
# Get your client ID from: https://www.mapillary.com/dashboard/developers
# Provides: Street-level photos, building facades, architectural details
# Free: Unlimited image access via API
MAPILLARY_CLIENT_ID=your_mapillary_client_id_here
MAPILLARY_ENABLED=false

# ==========================================
# PHASE 3: AI 3D GENERATION (CRITICAL - REQUIRED FOR 3D MODELS)
# ==========================================

# Without these keys, variants will show but no 3D models will generate!
# You need at least ONE of: TRIPO_API_KEY or MESHY_API_KEY

# Tripo AI - Text-to-3D and Image-to-3D (Recommended - Faster & Cheaper)
# Sign up: https://www.tripo3d.ai/
# Free tier: 300 credits/month (enough for 15-30 models)
TRIPO_API_KEY=your_tripo_key_here

# Meshy AI - High-quality 3D with PBR materials (Premium Option)
# Sign up: https://www.meshy.ai/
# Free tier: 200 credits/month (enough for 7-10 models)
MESHY_API_KEY=your_meshy_key_here

# ==========================================
# PHASE 5: GOOGLE CLOUD VERTEX AI (Micron-Level Perfection)
# ==========================================

# Google Cloud Vertex AI - Advanced AI for photorealistic rendering
# Setup Guide: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
# 
# Services used:
# - Imagen 3: Photorealistic concept images for architectural visualization
# - Custom Vision Models: Material texture analysis, facade recognition
# - AutoML: Training custom models on architectural styles
#
# Setup Steps:
# 1. Create GCP project: https://console.cloud.google.com/projectcreate
# 2. Enable Vertex AI API: https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
# 3. Create service account with Vertex AI User role
# 4. Download JSON key and place in backend/config/vertex-ai-key.json
# 5. Enable billing (free tier: $300 credit for 90 days)
#
# Cost (after free tier):
# - Imagen: $0.002 per image
# - Predictions: $0.50 per 1,000 predictions
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
VERTEX_AI_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagegeneration@006
GOOGLE_APPLICATION_CREDENTIALS=./config/vertex-ai-key.json
ENABLE_VERTEX_AI=false

# Budget Controls
ENABLE_AI_3D_GENERATION=true
DEFAULT_GENERATION_MODE=ultra_cheap
USE_FREE_TIER_FIRST=true
ENABLE_IMAGE_TO_3D_PIPELINE=true

# Free Tier Limits (Monthly Reset on 1st)
TRIPO_FREE_CREDITS_MONTHLY=300
MESHY_FREE_CREDITS_MONTHLY=200
VERTEX_IMAGEN_FREE_MONTHLY=1000

# Cost per Generation (in credits/USD)
TRIPO_IMAGE_TO_3D_COST=20
TRIPO_TEXT_TO_3D_COST=10
MESHY_IMAGE_TO_3D_COST=30
MESHY_TEXT_TO_3D_COST=20
VERTEX_IMAGEN_COST=0.002

# Caching Strategy
ENABLE_MODEL_CACHE=true
MODEL_CACHE_TTL_DAYS=30
CACHE_SIMILARITY_THRESHOLD=0.85

# Budget Limits & Alerts
MAX_MONTHLY_BUDGET_USD=5
ALERT_AT_BUDGET_PERCENT=75
STOP_GENERATION_AT_BUDGET_PERCENT=95

# ==========================================
# PERFORMANCE
# ==========================================

# API timeout in milliseconds
API_TIMEOUT_MS=10000

# Maximum parallel API requests
MAX_PARALLEL_REQUESTS=10

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ==========================================
# PHASE 2: AXEL VOXEL ENGINE (True Vision - Micron-Level Analysis)
# ==========================================

# Master Toggle - Set to false to disable all Axel processing
AXEL_ENABLED=true

# Voxel Resolution Control
# Options: 'adaptive' (recommended), 'high', 'medium', 'low'
AXEL_RESOLUTION=adaptive

# Performance Tuning
AXEL_MAX_VOXELS=100000000
AXEL_LOD_LEVELS=1000,100,10,1,0.1,0.01
AXEL_TARGET_TIME=10000

# Analysis Layer Toggles (all default to true)
# Disable individual layers for faster processing if needed
AXEL_ENABLE_METROLOGY=true     # Geometry analysis (micron-level accuracy)
AXEL_ENABLE_CHEMICAL=true      # Material composition matching
AXEL_ENABLE_FLAWS=true         # Age-based wear and weathering
AXEL_ENABLE_TOOLING=true       # Period-correct manufacturing marks
AXEL_ENABLE_ENVIRONMENT=true   # Location/weather/lighting composition

# ==========================================
# CORS & SECURITY (CRITICAL FOR VERCEL DEPLOYMENT)
# ==========================================

# CORS Configuration
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For Vercel deployment, ADD YOUR FRONTEND DOMAIN:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc

# ==========================================
# QUICK START CHECKLIST - COMPLETE PIPELINE
# ==========================================
# 
# 🎯 MINIMUM REQUIRED (Phase 1 - Variants Only):
# ✅ GEMINI_API_KEY
# ✅ All FREE APIs (enabled by default - no keys needed)
# 
# 🚀 FULL 3D GENERATION (Phase 3):
# ✅ GEMINI_API_KEY
# ✅ TRIPO_API_KEY or MESHY_API_KEY (at least one)
# ✅ AXEL_ENABLED=true (Phase 2 - Micron-level analysis)
# 
# ☁️ VERCEL DEPLOYMENT:
# ✅ GEMINI_API_KEY
# ✅ TRIPO_API_KEY or MESHY_API_KEY
# ✅ ALLOWED_ORIGINS=https://your-frontend.vercel.app
# ✅ AXEL_ENABLED=true
# 
# 🎨 MICRON-LEVEL PERFECTION (Complete Pipeline):
# ✅ All above requirements
# ⭐ MAPBOX_ACCESS_TOKEN (High-res satellite & 3D terrain)
# ⭐ MAPILLARY_CLIENT_ID (Street-level facade analysis)
# ⭐ SKETCHFAB_API_TOKEN (Reference models)
# ⭐ GOOGLE_CLOUD_PROJECT_ID + credentials (Vertex AI for photorealism)
# ⭐ All FREE APIs (Wikipedia, OpenStreetMap, OpenMeteo) - already enabled!
# 
# 💰 COST ESTIMATE (Full Pipeline):
# - Phase 1-3 (Basic): ~$0-5/month (free tiers sufficient)
# - With Mapbox: +$0-5/month (50K free tiles)
# - With Vertex AI: +$0-10/month ($300 free credit for 90 days)
# - Total: $0-20/month depending on usage
# 
# 📚 See ENVIRONMENT_SETUP_GUIDE.md for detailed setup instructions
# 
# ==========================================
