# ArchDisc Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Configuration
# Set to 'demo-mode' to run without API key (uses demo responses)
# Or set to your actual Google Gemini API key for real AI functionality
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=demo-mode

# Gemini Model Selection (optional)
# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro
# Default: gemini-1.5-pro (most capable model)
GEMINI_MODEL=gemini-1.5-pro

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc
