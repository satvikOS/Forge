# ArchDisc Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# OpenAI API Configuration
# Set to 'demo-mode' to run without API key (uses demo responses)
# Or set to your actual OpenAI API key for real AI functionality
OPENAI_API_KEY=demo-mode

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc
