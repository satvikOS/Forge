# ArchDisc Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════
# CORE AI
# ═══════════════════════════════════════════════════════════

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyC8xY2BmdRQ_NewKey_Example_abc123xyz

# Optional: Specify Gemini model (defaults to gemini-2.0-flash-exp if not set)
# Recommended models for 3D design generation:
#   - gemini-2.0-flash-exp (best balance, fast, 1M tokens, default)
#   - gemini-1.5-pro (high quality, requires v1beta API, 2M tokens)
#   - gemini-1.5-flash (fast, requires v1beta API, 1M tokens)
# Note: Gemini 1.5 models automatically use v1beta API, 2.x models use stable v1 API
GEMINI_MODEL=gemini-2.0-flash-exp

# ═══════════════════════════════════════════════════════════
# 3D MODELS & ASSETS
# ═══════════════════════════════════════════════════════════

# Sketchfab API Configuration
# Get your API token from: https://sketchfab.com/settings/password
# To enable Sketchfab integration, set these variables:
SKETCHFAB_API_TOKEN=your_sketchfab_api_token_here
SKETCHFAB_CLIENT_ID=your_client_id_here
SKETCHFAB_CLIENT_SECRET=your_client_secret_here
# Feature flag to enable/disable Sketchfab integration
SKETCHFAB_ENABLED=false

# ═══════════════════════════════════════════════════════════
# GEOGRAPHIC SERVICES
# ═══════════════════════════════════════════════════════════

# Mapbox API Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
# Provides: Satellite imagery, terrain data, building footprints, vector tiles
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
MAPBOX_ENABLED=false

# ═══════════════════════════════════════════════════════════
# VISUAL CONTEXT (OPTIONAL)
# ═══════════════════════════════════════════════════════════

# Mapillary API Configuration (Street-level imagery)
# Get your client ID from: https://www.mapillary.com/dashboard/developers
# Provides: Street-level photos, building facades, environmental context
MAPILLARY_CLIENT_ID=your_mapillary_client_id_here
MAPILLARY_ENABLED=false

# ═══════════════════════════════════════════════════════════
# FREE API FEATURE FLAGS (No keys required)
# ═══════════════════════════════════════════════════════════

# Wikipedia API - Landmark and building information
ENABLE_WIKIPEDIA=true

# Wikidata API - Structured architectural data and dimensions
ENABLE_WIKIDATA=true

# Wikimedia Commons API - High-resolution reference images
ENABLE_WIKIMEDIA=true

# Overpass API (OpenStreetMap) - Real building data and road networks
ENABLE_OVERPASS=true

# Open-Elevation API - Terrain elevation data
ENABLE_OPEN_ELEVATION=true

# Open-Meteo API - Weather and lighting conditions
ENABLE_OPEN_METEO=true

# Tree Map - Vegetation and canopy data
ENABLE_TREE_MAP=true

# ═══════════════════════════════════════════════════════════
# API ORCHESTRATOR
# ═══════════════════════════════════════════════════════════

# Enable the master orchestration system
ENABLE_ORCHESTRATOR=true

# ═══════════════════════════════════════════════════════════
# PERFORMANCE & OPTIMIZATION
# ═══════════════════════════════════════════════════════════

# API timeout in milliseconds
API_TIMEOUT_MS=5000

# Maximum parallel API requests
MAX_PARALLEL_REQUESTS=10

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ═══════════════════════════════════════════════════════════
# AI 3D GENERATION (BUDGET-OPTIMIZED)
# ═══════════════════════════════════════════════════════════

# Tripo AI - Text-to-3D and Image-to-3D
# Sign up: https://www.tripo3d.ai/
TRIPO_API_KEY=your_tripo_key_here

# Meshy AI - High-quality 3D with PBR materials
# Sign up: https://www.meshy.ai/
MESHY_API_KEY=your_meshy_key_here

# Google Cloud Vertex AI - Imagen for concept art
# Setup: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
GOOGLE_CLOUD_PROJECT_ID=your_project_id
VERTEX_AI_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagegeneration@006
GOOGLE_APPLICATION_CREDENTIALS=./config/vertex-ai-key.json

# Budget Controls
ENABLE_AI_3D_GENERATION=true
DEFAULT_GENERATION_MODE=ultra_cheap
USE_FREE_TIER_FIRST=true
ENABLE_IMAGE_TO_3D_PIPELINE=true

# Free Tier Limits (Monthly Reset on 1st)
TRIPO_FREE_CREDITS_MONTHLY=300
MESHY_FREE_CREDITS_MONTHLY=200
VERTEX_IMAGEN_FREE_MONTHLY=1000

# Cost per Generation (in credits/USD)
TRIPO_IMAGE_TO_3D_COST=20
TRIPO_TEXT_TO_3D_COST=10
MESHY_IMAGE_TO_3D_COST=30
MESHY_TEXT_TO_3D_COST=20
VERTEX_IMAGEN_COST=0.002

# Caching Strategy
ENABLE_MODEL_CACHE=true
MODEL_CACHE_TTL_DAYS=30
CACHE_SIMILARITY_THRESHOLD=0.85

# Budget Limits & Alerts
MAX_MONTHLY_BUDGET_USD=5
ALERT_AT_BUDGET_PERCENT=75
STOP_GENERATION_AT_BUDGET_PERCENT=95

# ═══════════════════════════════════════════════════════════
# CORS & SECURITY
# ═══════════════════════════════════════════════════════════

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc
