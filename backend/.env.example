# ArchDisc Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Set to 'demo-mode' to run without API key (uses demo responses)
# Or set to your actual Gemini API key for real AI functionality
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (optional)
# Available models: gemini-1.5-pro (default), gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-pro

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (for future use)
# DATABASE_URL=mongodb://localhost:27017/archdisc

# Deployment Checklist:
# 1. Set GEMINI_API_KEY to your actual API key
# 2. Set NODE_ENV=production for production deployments
# 3. Update ALLOWED_ORIGINS with your production domain
# 4. Ensure all environment variables are set in your deployment platform (Vercel, Heroku, etc.)

