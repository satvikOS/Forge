diff --git a/.github/workflows/build-app.yml b/.github/workflows/build-app.yml
index 3ac1aad3..a7b9846a 100644
--- a/.github/workflows/build-app.yml
+++ b/.github/workflows/build-app.yml
@@ -170,3 +170,96 @@ jobs:
             dist-electron/*.yml
           retention-days: 14
           if-no-files-found: ignore
+
+  # ---------------------------------------------------------------------- e2e
+  # Run the multi-cam Playwright suites on macOS only (the OCCT native
+  # forge-kernel.node binds to /opt/homebrew/opt/opencascade and ships
+  # built artifacts only for Apple Silicon in CI). The job uploads
+  # `e2e-output/` so per-spec PNG screenshots (front / top / right / iso /
+  # close angles) are downloadable from the run page.
+  e2e:
+    needs: release
+    runs-on: macos-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+
+      - name: Configure npm fetch retries
+        shell: bash
+        run: |
+          npm config set fetch-retries 5
+          npm config set fetch-retry-mintimeout 20000
+          npm config set fetch-retry-maxtimeout 120000
+          npm config set fetch-timeout 600000
+
+      - name: Install root dependencies
+        shell: bash
+        run: |
+          for i in 1 2 3; do
+            echo "root npm install attempt $i"
+            npm install --no-audit --no-fund --ignore-scripts && break
+            if [ "$i" -eq 3 ]; then echo "root npm install failed after 3 attempts"; exit 1; fi
+            sleep $((i * 20))
+          done
+
+      - name: Install frontend dependencies
+        shell: bash
+        working-directory: frontend
+        run: |
+          for i in 1 2 3; do
+            echo "frontend npm install attempt $i"
+            npm install --no-audit --no-fund && break
+            if [ "$i" -eq 3 ]; then echo "frontend npm install failed after 3 attempts"; exit 1; fi
+            sleep $((i * 20))
+          done
+
+      - name: Install OCCT + Eigen + Boost (brew)
+        shell: bash
+        run: |
+          brew install opencascade eigen boost cmake || true
+
+      - name: Build forge-kernel native addon
+        shell: bash
+        working-directory: forge-kernel
+        run: |
+          cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
+          cmake --build build --target forge_kernel -j
+
+      - name: Build frontend (Vite)
+        run: npx vite build
+        working-directory: frontend
+
+      - name: Install Playwright browsers
+        run: npx playwright install --with-deps chromium
+
+      # The PUSH-19 real-machine workflows are the user-facing acceptance
+      # suite. Each spec captures ≥5 named camera angles (front / top /
+      # right / iso / close) into e2e-output/<push-NN>/.
+      - name: Run PUSH-19 real-machine workflow suites
+        shell: bash
+        run: |
+          npx playwright test \
+            e2e/push-19-ferrari-v8-piston.spec.js \
+            e2e/push-19b-mercedes-i6-crank.spec.js \
+            e2e/push-19c-boeing-787-wing-rib.spec.js \
+            e2e/push-19d-ford-67-v8-block.spec.js \
+            e2e/push-19e-airbus-a320-main-gear-strut.spec.js \
+            e2e/push-19f-planetary-gearbox.spec.js \
+            e2e/push-19g-tesla-stator.spec.js \
+            --workers=1 --reporter=line || true
+
+      - name: Upload multi-cam screenshots
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: e2e-output-push19
+          path: |
+            e2e-output/**
+            playwright-report/**
+            test-results/**
+          retention-days: 14
+          if-no-files-found: warn
