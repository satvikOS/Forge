# ArchDisc Production Environment Variables Template
# Copy these to your Vercel project settings: https://vercel.com/dashboard

# ==========================================
# REQUIRED - Gemini AI (PRIMARY)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# OPTIONAL - Additional AI Services
# ==========================================
# Tripo AI - Text-to-3D
TRIPO_API_KEY=your_tripo_key_here

# Meshy AI - High-quality 3D
MESHY_API_KEY=your_meshy_key_here

# Google Cloud Vertex AI
GOOGLE_CLOUD_PROJECT_ID=your_project_id
VERTEX_AI_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagegeneration@006

# ==========================================
# CONFIGURATION
# ==========================================
NODE_ENV=production
VARIANT_COUNT=3
AXEL_ENABLED=true

# API Settings
API_TIMEOUT_MS=60000
MAX_PARALLEL_REQUESTS=10

# CORS - Add your Vercel deployment URL
ALLOWED_ORIGINS=https://your-app.vercel.app

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 1. DO NOT commit this file to git
# 2. Set these in Vercel dashboard: Project Settings > Environment Variables
# 3. Only GEMINI_API_KEY is absolutely required for basic functionality
# 4. Other services are optional enhancements
