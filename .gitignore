# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Dependencies. NO trailing slash, on purpose: `node_modules/` matches a
# DIRECTORY only, and forge-kernel/scripts/tkdrop_build_baseline.sh creates a
# SYMLINK to the primary checkout's node_modules in every worktree it builds in
# ("safe to delete afterwards", its own comment says). With the slash that
# symlink shows as untracked, so every worktree that has built the kernel looks
# dirty to the reaper — the exact thing the rule was written to prevent.
node_modules
package-lock.json

# Cache directory (but keep creditUsage.json)
backend/db/cache/

# Test scripts
test-*.js

# Environment variables
.env
.env.local
.env.production

# Local LLM credentials — NEVER commit
.llm-credentials.local.json

# Build output
dist/
build/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.backup
.serverless/

# Test render / screenshot artifacts (regenerated each run; never committed)
test-results/
e2e/forge/shots/
e2e/demo/shots/
forge-kernel/test/_turbofan_out/
lambda-deployment.zip
*.zip
.serverless/
lambda-*.zip
test-results/
dist-electron/
ge9x-deliverable/
autonomous-output/
engine-output/

# E2E artefacts (regenerated on every run; never commit)
e2e-output/
e2e/screenshots/

# Large local reference media — never commit (course videos in repo root)
*.mp4
*.webm
*.mov

# AI-orchestration scratch / wakeup notes
docs/superpowers/notes/custom-occt-build-recon.md

# Hermes reference zip (scraped into Archie; never commit)
hermes-agent-main.zip
_scrape_hermes/

# Video-611 reference + extraction scratch
Video-611.mp4
video611-frames/
_extract611.mjs
test-results/
# Claude Code local state. `worktrees/` is the single largest disk sink in this
# repo (agent worktrees), so the directory stays ignored by default and only the
# shared, reviewable agent definitions are tracked.
.claude/*
!.claude/agents/

# Forge — autonomous-build cruft
dist-electron/
*.dmg
*.AppImage
*.zip
*.exe
forge-kernel/build-native/
forge-kernel/build-desktop-ui/
# The node-free kernel core the C++ desktop app links, and the app's own build
# tree. `build/` above only matches a directory literally named build.
forge-kernel/build-app/
forge-kernel/test/native/gdt/fcf_evaluator_test.cpp
# Object cache + run outputs of test/build_corpus_ab_coverage.sh (the corpus A/B
# coverage gate). The .a and the per-run JSONL are regenerable from the scripts;
# the committed baseline lives in forge-kernel/reports/corpus_ab/ instead.
forge-kernel/.build-corpus-ab/
forge-kernel/.build-cam-offset-ab/
# Same deal for test/build_draft_defer_probe.sh's object cache and binary; its
# committed results live in reports/corpus_ab/draft_defer_probe.jsonl.gz.
forge-kernel/.build-draft-probe/
# Same deal for test/build_draft_local_probe.sh's object cache, binary and run
# outputs; its committed results live in
# reports/corpus_ab/draft_local_probe.jsonl.gz.
forge-kernel/.build-draft-local/
# test/ft/ft_smoke.mjs and ft_organic_smoke.mjs write their exported STEP files
# here. That path used to be the PRIMARY checkout's, which made two agents in
# two worktrees write the SAME file; it is now tree-local, so every tree grows
# one of these and none of them is an artefact.
forge-kernel/scratchpad/
# Same deal for test/build_offsetshape_defer_census.sh (family H attribution).
forge-kernel/.build-offsetshape-census/
forge-kernel/.build-pipeshell-guided/
# test/run_tkoffset_gh_defer_census.sh's binary; its committed rows live in
# reports/corpus_ab/tkoffset_gh_defer_census_600.tsv and the write-up in
# reports/TKOFFSET_GH_DEFER_CENSUS.md.
forge-kernel/.build-gh-census/
# test/run_thicksolid_nesting_gate.sh's binary — a gate, so it has no committed
# artefact; it is rebuilt and rerun from source every time.
forge-kernel/.build-thicksolid-nesting/
# test/sarc_ring_mutation.sh's default build dir. It holds a CMake tree that is
# deliberately built against a mutated source and then restored, so nothing in it
# is ever a fact about the repository.
forge-kernel/build-sarc-mutation/
# test/ft/build_s0_acceptance.sh and test/ft/build_surface_round_trip.sh keep
# their objects + binaries here. Both are gates, so there is no committed
# artefact: they are rebuilt and rerun from source every time.
forge-kernel/test/ft/.s0build/
forge-kernel/test/ft/.surfacebuild/
# test/build_section_op_gate.sh's objects + binary. Same reasoning: it is a GATE,
# not a census, so there is no artefact to commit — it is rebuilt and rerun from
# source every time, and its three mutations are re-proved on every run.
forge-kernel/test/.section_gate/

# --- Forge local dependency plane (Sacrosanct 3.1 s10.6 / s21.2) -------------
# .forge-local/ is the workstation execution plane: source mirror, build trees,
# activated prefixes, binary and model caches. It carries its own .gitignore,
# which is the only tracked file inside it.
.forge-local/*
!.forge-local/.gitignore
# deps.resolved.json records the realized build + host facts of ONE workstation
# (absolute prefixes, toolchain paths). The LOCK is what belongs in Git; the
# resolved file is generated by `tools/deps/forge_deps.py resolve`.
third_party/manifest/deps.resolved.json
