  "build_recipe_stages": [
    { "id": 1,  "label": "Sketch crank main journal profile (Ø70 on XY plane)",                          "tool": "sketchCircle" },
    { "id": 2,  "label": "Extrude main journal 26 mm",                                                    "tool": "extrude" },
    { "id": 3,  "label": "Linear pattern: 7 main journals along crank axis (106 mm pitch)",              "tool": "linearPattern" },
    { "id": 4,  "label": "Sketch + extrude 6 crank throw pins (Ø60 × 24, at 60° firing angles)",         "tool": "sketchCircle+extrude" },
    { "id": 5,  "label": "Sketch + extrude crank web profile + linear pattern",                          "tool": "sketchPolyline+extrude" },
    { "id": 6,  "label": "Apply fillet 3.5 mm to crank fillets (stress concentration relief)",           "tool": "fillet" },
    { "id": 7,  "label": "Assign material 4140 chrome-moly (E=205 GPa, Sy=655 MPa)",                     "tool": "material" },
    { "id": 8,  "label": "Start new part: cylinder block. Sketch Ø89 bore profile on XY",                "tool": "sketchCircle" },
    { "id": 9,  "label": "Extrude bore profile 86 mm",                                                    "tool": "extrude" },
    { "id": 10, "label": "Linear pattern: 6 bores down bank A (-30° tilt, pitch 106 mm)",                "tool": "linearPattern+rotate" },
    { "id": 11, "label": "Mirror to bank B (+30° tilt, 60° V-angle)",                                    "tool": "linearPattern+rotate" },
    { "id": 12, "label": "Boolean cut bores from solid block",                                           "tool": "cut" },
    { "id": 13, "label": "Fillet all bore-to-deck edges 1 mm",                                            "tool": "fillet" },
    { "id": 14, "label": "Assign material Al-7075 (E=72 GPa, Sy=503 MPa)",                               "tool": "material" },
    { "id": 15, "label": "Attach PMI: 4 datums (A/B/C/D) + 7 FCFs + 4 surface finishes + 4 linear dims", "tool": "pmi" },
    { "id": 16, "label": "Assembly: position crank concentric in block",                                 "tool": "matelib" },
    { "id": 17, "label": "FEA peak-combustion: 9.5 MPa cylinder pressure → animated displacement + von Mises (5 s loop)", "tool": "fea-anim" },
    { "id": 18, "label": "FEA modal: 6 lowest free-free modes → animated mode shape oscillation",        "tool": "modal-anim" },
    { "id": 19, "label": "CFD intake port: peak lift, 0.072 kg/s → animated streamlines",                "tool": "cfd-anim" },
    { "id": 20, "label": "Topology optimisation: lighten block while keeping vM < 95 MPa",                "tool": "topology" },
    { "id": 21, "label": "Generate 2D HLR drawings: FRONT / TOP / RIGHT / SECTION views",                "tool": "drawings" },
    { "id": 22, "label": "Export to DXF + SVG + STEP deliverable bundle",                                 "tool": "export" },
    { "id": 23, "label": "PBR render: aluminium block + chrome crank + heat-bluing on exhaust runners",  "tool": "render" },
    { "id": 24, "label": "PDM vault check-in: M120-rev C, 24 stages, full design history",               "tool": "pdm" }
  ],

