#!/bin/zsh
# Actuator fault-injection. Sources the REAL daemon in library mode so this
# suite tests the shipped code, not a re-extracted copy of it.
# The failure being prevented is real and measured: a machine-wide pkill once
# killed every parallel agent's server at once.
#
# PRIVATE DOMAIN. This suite used to `mv` the LIVE registry (~/.forge-health/jobs)
# aside while it ran -- so for its duration the live governor could not see, shed
# or count the real jobs (the archie-sidecar among them), and a crash mid-suite
# left them hidden. It now plants envelopes only in a private FORGE_HEALTH_DIR
# (made here when the caller did not set one) and refuses to run in the live one.
#   which daemon: $FORGE_GUARDIAN_UNDER_TEST, else the forge-guardian beside this script.
set -u
setopt NULL_GLOB
zmodload zsh/datetime
G=${FORGE_GUARDIAN_UNDER_TEST:-${0:A:h}/forge-guardian}
PRIV=""
if [[ -z ${FORGE_HEALTH_DIR:-} ]]; then
  PRIV=$(mktemp -d "${TMPDIR:-/tmp}/fg_actuator.XXXXXX") || exit 1
  export FORGE_HEALTH_DIR=$PRIV
fi
if [[ ${FORGE_HEALTH_DIR:A} == ${HOME:A}/.forge-health ]]; then
  print -u2 "forge-guardian-actuator-test: refusing to plant test envelopes in the LIVE domain ($FORGE_HEALTH_DIR)."
  print -u2 "  unset FORGE_HEALTH_DIR (a private domain is made for you) or point it at a scratch dir."
  exit 2
fi
export ARCHIE_HEALTH_DIR=${ARCHIE_HEALTH_DIR:-$FORGE_HEALTH_DIR/archie_health}
export FORGE_GUARDIAN_LIB=1
source "$G" || { print "  FAIL  could not source $G"; exit 1; }
unset FORGE_GUARDIAN_LIB
PASS=0; FAIL=0
chk() { if [[ "$2" == "$3" ]]; then print "  PASS  $1"; (( PASS++ )); else print "  FAIL  $1 -> got '$3' want '$2'"; (( FAIL++ )); fi }
print "daemon under test: $G"
print "private domain:    $FORGE_HEALTH_DIR"

# Every process this suite starts, in a FILE (a command substitution cannot append
# to the parent's array), and every envelope it plants -- nothing else is touched.
PIDS="$FORGE_HEALTH_DIR/.actuator.pids"; : > "$PIDS"
PLANTED=()
O1=$(mktemp); O2=$(mktemp); O3=$(mktemp); O4=$(mktemp); VICT=$(mktemp)
cleanup() {
  local p
  while read -r p; do [[ -n $p ]] && kill -9 "$p" 2>/dev/null; done < "$PIDS"
  for p in $PLANTED; do rm -f -- "$JOBS_DIR/$p"; done
  rm -f "$O1" "$O2" "$O2.un" "$O3" "$O4" "$VICT" 2>/dev/null
  [[ -n $PRIV ]] && rm -rf "$PRIV"
  kill -TERM $WD 2>/dev/null          # TERM, not KILL: the watchdog reaps its own sleep
}
# (the watchdog's sleep is its own child and is reaped with it: a KILLed watchdog used to
# orphan `sleep N`, which held the caller's stdout pipe open until it expired)
{ trap 'kill $wsp 2>/dev/null; exit 0' TERM
  sleep 240 & wsp=$!; wait $wsp                                  # includes one sensor build
  print -u2 "[actuator] WALL-CLOCK EXCEEDED"; kill -TERM $$ } &!
WD=$!
trap cleanup EXIT
trap 'exit 143' TERM INT

# Find the supervising claude PID robustly: pgrep -x matches comm exactly, which
# can miss it; fall back to a full-cmdline match. If we cannot identify it we
# must SKIP, never silently test `kill -0 1` and call the result a pass.
CLAUDEPID=$(pgrep -x claude 2>/dev/null | head -1)
[[ -z "$CLAUDEPID" ]] && CLAUDEPID=$(pgrep -f '(^|/)claude( |$)' 2>/dev/null | head -1)
[[ -z "$CLAUDEPID" ]] && CLAUDEPID=$(ps -Ao pid=,comm= | awk '$2 ~ /\/claude$|^claude$/ {print $1; exit}')

cat > "$VICT" <<'V'
#!/bin/zsh
trap 'print USR1 >> "$1"' USR1
trap 'print TERM >> "$1"; exit 0' TERM
while true; do sleep 0.2; done
V
chmod +x "$VICT"
spawn() { "$VICT" "$1" & REPLY=$!; print $REPLY >> "$PIDS" }
# An envelope the way forge-job writes it: v1 keys in order, started=, cmd LAST.
plant() { # plant FILE PID NAME PRIORITY CAN_RESTART [STARTED]
  { print "pid=$2"; print "name=$3"; print "priority=$4"; print "can_restart=$5"; print "peak_gb=1"; print "gpu=0"
    [[ -n ${6:-} ]] && print "started=$6"; print "cmd=victim"; } > "$JOBS_DIR/$1"
  PLANTED+=("$1")
}
spawn "$O1"; SPEC=$REPLY
spawn "$O2"; CRIT=$REPLY
sleep 0.4
NOW=$EPOCHSECONDS
plant spec.job "$SPEC" speculative 8 1 $NOW
plant crit.job "$CRIT" critical-ui 0 0 $NOW
if [[ -n "$CLAUDEPID" ]]; then
  plant bogus.job "$CLAUDEPID" BOGUS-claude-entry 9 1 $NOW
fi

print "== shed order: most speculative first =="
ORDER=$(for f in $(shed_order); do job_field "$f" name; done | tr '\n' ',')
print "  order: $ORDER"
WANT_FIRST=$([[ -n "$CLAUDEPID" ]] && print "BOGUS-claude-entry" || print "speculative")
chk "highest priority number sheds first" "$WANT_FIRST" "${ORDER%%,*}"

print "== ORANGE: SIGUSR1 to priority>=7 only, protected REFUSED =="
B=$(grep -E "REFUSED to signal protected" "$LOG" 2>/dev/null | wc -l | tr -d ' ')
for f in $(shed_order); do p=$(job_field "$f" priority); (( ${p:-5} >= 7 )) || continue; signal_job "$f" USR1 >/dev/null 2>&1; done
sleep 0.6
chk "speculative job checkpointed" "USR1" "$(head -1 $O1 2>/dev/null)"
chk "CRITICAL job untouched at ORANGE" "" "$(cat $O2 2>/dev/null)"
A=$(grep -E "REFUSED to signal protected" "$LOG" 2>/dev/null | wc -l | tr -d ' ')
if [[ -n "$CLAUDEPID" ]]; then
  chk "bogus claude entry REFUSED (protected)" "1" "$(( A - B ))"
  chk "claude pid $CLAUDEPID still alive" "alive" "$(kill -0 $CLAUDEPID 2>/dev/null && print alive || print DEAD)"
else
  print "  SKIP  protected-refusal: could not identify the claude pid (NOT a pass)"
fi

print "== RED stage3: TERM the most speculative RESTARTABLE, one at a time =="
for f in $(shed_order); do [[ "$(job_field "$f" can_restart)" == "1" ]] || continue; signal_job "$f" TERM >/dev/null 2>&1 && break; done
sleep 0.8
chk "speculative job terminated" "TERM" "$(grep -m1 TERM $O1 2>/dev/null)"
chk "critical job STILL alive after RED" "alive" "$(kill -0 $CRIT 2>/dev/null && print alive || print DEAD)"
[[ -n "$CLAUDEPID" ]] && chk "claude STILL alive after RED" "alive" "$(kill -0 $CLAUDEPID 2>/dev/null && print alive || print DEAD)"

print "== unregistered processes are invisible to Guardian =="
spawn "$O2.un"; UNREG=$REPLY
sleep 0.3
for f in $(shed_order); do signal_job "$f" TERM >/dev/null 2>&1; done
sleep 0.5
chk "unregistered process untouched" "alive" "$(kill -0 $UNREG 2>/dev/null && print alive || print DEAD)"

print "== reaping dead job files =="
kill -9 $CRIT $UNREG 2>/dev/null; sleep 0.3
reap_dead_jobs
chk "dead job files reaped" "0" "$(ls $JOBS_DIR/spec.job $JOBS_DIR/crit.job 2>/dev/null | wc -l | tr -d ' ')"

print "== IDENTITY (SCHEMA §5): a number is not a process =="
# A REUSED pid: the envelope says its process was registered an hour ago, but the
# process now holding that pid started seconds ago -- a stranger that inherited
# the number. It must never be signalled, and the envelope must be reaped.
spawn "$O3"; REUSED=$REPLY
spawn "$O4"; UNVER=$REPLY
sleep 0.4
plant reused.job "$REUSED" reused-pid 9 1 $(( EPOCHSECONDS - 3600 ))
plant unver.job "$UNVER" no-identity 9 1          # neither started= nor pstart=
signal_job "$JOBS_DIR/reused.job" TERM >/dev/null 2>&1; r1=$?
signal_job "$JOBS_DIR/unver.job" TERM >/dev/null 2>&1; r2=$?
signal_job "$JOBS_DIR/unver.job" USR1 >/dev/null 2>&1
sleep 0.6
chk "reused pid: signal_job refuses"                  1 "$r1"
chk "reused pid: the stranger received nothing"       "" "$(cat $O3 2>/dev/null)"
chk "reused pid: the stranger is alive"               alive "$(kill -0 $REUSED 2>/dev/null && print alive || print DEAD)"
chk "reused pid: the envelope was reaped"             0 "$(ls $JOBS_DIR/reused.job 2>/dev/null | wc -l | tr -d ' ')"
chk "reused pid: the refusal names the identity"      1 "$(grep -c "pid=$REUSED .*identity mismatch" "$LOG" 2>/dev/null)"
chk "unverifiable: signal_job refuses"                1 "$r2"
chk "unverifiable: neither TERM nor USR1 delivered"   "" "$(cat $O4 2>/dev/null)"
reap_dead_jobs
chk "unverifiable: the envelope is KEPT (not reaped)" 1 "$(ls $JOBS_DIR/unver.job 2>/dev/null | wc -l | tr -d ' ')"
plant launchd.job 1 BOGUS-launchd 9 1 $EPOCHSECONDS
signal_job "$JOBS_DIR/launchd.job" TERM >/dev/null 2>&1; r3=$?
chk "pid 1 is never signalled"                        1 "$r3"
ROOTPID=$(ps -axo pid=,uid=,comm= | awk '$2 == 0 && $1 > 1 && $3 !~ /kernel_task|launchd/ {print $1; exit}')
if [[ -n $ROOTPID ]]; then
  plant root.job "$ROOTPID" BOGUS-root 9 1 $EPOCHSECONDS
  signal_job "$JOBS_DIR/root.job" USR1 >/dev/null 2>&1; r4=$?
  chk "another uid's pid ($ROOTPID) is refused before kill" 1 "$r4"
  chk "  ...and the refusal says why"                 1 "$(grep -c "pid=$ROOTPID .*owned by uid 0" "$LOG" 2>/dev/null)"
else
  print "  SKIP  other-uid refusal: no root-owned process found (NOT a pass)"
fi

print "== ACT-1: a protected name with a SPACE, with the REAL sensor beside the governor =="
# Review 2026-10-08 ACT-1: `pidinfo` prints comm= percent-encoded (Claude%20Helper), the
# governor matched `Claude Helper*` against that and signalled every Claude helper --
# but only with the sensor installed, which this suite never ran. So: build the real
# sensor, and a victim whose process name is exactly "Claude Helper" (a compiled
# binary: p_comm is the executable's name, and a copied /bin/sleep is killed by code
# signing). Both are this suite's own; nothing else is ever signalled.
SB="$FORGE_HEALTH_DIR/.act_sensor"; mkdir -p "$SB"
O5=$(mktemp); O6=$(mktemp)
cat > "$SB/victim.c" <<'C'
#include <signal.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>
#include <stdlib.h>
static const char* out;
static void h(int s) { int fd = open(out, O_WRONLY | O_APPEND | O_CREAT, 0600);
  if (fd >= 0) { const char* m = s == SIGUSR1 ? "USR1\n" : "TERM\n"; write(fd, m, strlen(m)); close(fd); }
  if (s == SIGTERM) _exit(0); }
int main(int c, char** v) { out = c > 1 ? v[1] : "/dev/null"; int life = c > 2 ? atoi(v[2]) : 60;
  signal(SIGUSR1, h); signal(SIGTERM, h); for (int i = 0; i < life * 10; i++) usleep(100000); return 0; }
C
if zsh "${0:A:h}/sensor/build.sh" --out "$SB" >"$SB/build.log" 2>&1 && [[ -x $SB/forge-guardian-sensor ]] \
   && xcrun clang -O1 -o "$SB/Claude Helper" "$SB/victim.c" >>"$SB/build.log" 2>&1; then
  "$SB/Claude Helper" "$O5" 60 & HP=$!; print $HP >> "$PIDS"
  sleep 0.4
  plant helper.job "$HP" helper 9 1 $EPOCHSECONDS
  SAVED_SENSOR_BIN=$SENSOR_BIN
  SENSOR_BIN=$SB/forge-guardian-sensor
  print "  pidinfo: $("$SENSOR_BIN" pidinfo $HP)"
  B=$(grep -c "REFUSED to signal protected pid=$HP " "$LOG" 2>/dev/null)
  signal_job "$JOBS_DIR/helper.job" USR1 >/dev/null 2>&1; r=$?
  sleep 0.5
  chk "sensor path: signal_job refuses 'Claude Helper'"            1 "$r"
  chk "  ...the refusal is logged as protected"                    1 "$(( $(grep -c "REFUSED to signal protected pid=$HP " "$LOG" 2>/dev/null) - ${B:-0} ))"
  chk "  ...the helper received nothing and is alive"              "alive:" "$(kill -0 $HP 2>/dev/null && print alive || print DEAD):$(cat $O5 2>/dev/null)"
  SENSOR_BIN=""
  signal_job "$JOBS_DIR/helper.job" USR1 >/dev/null 2>&1; r=$?
  sleep 0.3
  chk "control, ps path: refused too"                              "1:" "$r:$(cat $O5 2>/dev/null)"
  # protected=1 alone protects: a pidinfo that names an ordinary process but says
  # protected=1 (a list entry the governor's own copy might lack, another uid, ...).
  spawn "$O6"; PV=$REPLY; sleep 0.4
  plant pflag.job "$PV" pflag 9 1 $EPOCHSECONDS
  for flag in 1 0; do
    print -r -- "#!/bin/zsh
[[ \$1 == pidinfo ]] || exit 2; p=\${@[-1]}                # the governor asks: pidinfo --state-dir D PID
out=\$(LC_ALL=C ps -o ppid=,uid=,lstart= -p \$p 2>/dev/null); w=(\${=out})
(( \${#w} >= 7 )) || { print \"pid=\$p identity=dead\"; exit 0; }
zmodload zsh/datetime; LC_ALL=C strftime -r -s t '%a %b %d %H:%M:%S %Y' \"\$w[3] \$w[4] \$w[5] \$w[6] \$w[7]\"
print \"pid=\$p ppid=\$w[1] pstart=\$t uid=\$w[2] protected=$flag comm=ordinary-victim identity=alive\"" > "$SB/pidinfo-stub-$flag"
    chmod +x "$SB/pidinfo-stub-$flag"
  done
  SENSOR_BIN="$SB/pidinfo-stub-1"; signal_job "$JOBS_DIR/pflag.job" USR1 >/dev/null 2>&1; r=$?; sleep 0.4
  chk "pidinfo protected=1 on an ordinary name: refused"           "1:" "$r:$(cat $O6 2>/dev/null)"
  chk "  ...as protected (not for some other reason)"              1 "$(grep -c "REFUSED to signal protected pid=$PV " "$LOG" 2>/dev/null)"
  SENSOR_BIN="$SB/pidinfo-stub-0"; signal_job "$JOBS_DIR/pflag.job" USR1 >/dev/null 2>&1; r=$?; sleep 0.4
  chk "  control: the same stub with protected=0 is signalled"     "0:USR1" "$r:$(head -1 $O6 2>/dev/null)"
  # protected=1 that only the DOMAIN knows (review 2026-10-08 round 2, verify 4a): the
  # holder of this domain's sensor.lock is protected whatever its name (SCHEMA §5), and the
  # real sensor says so only when asked `pidinfo --state-dir D`. c249d838's governor asked
  # `pidinfo PID`, got protected=0 comm=lockholder, and SIGUSR1'd it. A compiled holder of
  # an fcntl write lock on $STATE_DIR/sensor.lock (the sensor's own lock), registered as a
  # valid job: nothing may reach it.
  O7=$(mktemp)
  cat > "$SB/lockholder.c" <<'C'
#include <fcntl.h>
#include <signal.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
static const char* out;
static void h(int s) { int fd = open(out, O_WRONLY | O_APPEND | O_CREAT, 0600);
  if (fd >= 0) { const char* m = s == SIGUSR1 ? "USR1\n" : "TERM\n"; write(fd, m, strlen(m)); close(fd); } }
int main(int c, char** v) { if (c < 4) return 2; out = v[2]; int life = atoi(v[3]);
  int fd = open(v[1], O_RDWR | O_CREAT, 0600); struct flock q; memset(&q, 0, sizeof q);
  q.l_type = F_WRLCK; q.l_whence = SEEK_SET; if (fd < 0 || fcntl(fd, F_SETLK, &q) != 0) return 1;
  signal(SIGUSR1, h); signal(SIGTERM, h); for (int i = 0; i < life * 10; i++) usleep(100000); return 0; }
C
  if xcrun clang -O1 -o "$SB/lockholder" "$SB/lockholder.c" >>"$SB/build.log" 2>&1; then
    "$SB/lockholder" "$STATE_DIR/sensor.lock" "$O7" 60 & LKP=$!; print $LKP >> "$PIDS"
    sleep 0.4
    plant lockholder.job "$LKP" lockholder 9 1 $EPOCHSECONDS
    SENSOR_BIN=$SB/forge-guardian-sensor
    pi=$("$SENSOR_BIN" pidinfo --state-dir "$STATE_DIR" $LKP 2>/dev/null)
    print "  pidinfo --state-dir: $pi"
    chk "the real sensor marks this domain's sensor.lock holder protected=1 (and only with --state-dir)" "1:0" \
        "$([[ $pi == *' protected=1 '* ]] && print 1 || print 0):$("$SENSOR_BIN" pidinfo $LKP 2>/dev/null | grep -c ' protected=1 ')"
    B=$(grep -c "REFUSED to signal protected pid=$LKP " "$LOG" 2>/dev/null)
    signal_job "$JOBS_DIR/lockholder.job" USR1 >/dev/null 2>&1; r=$?
    signal_job "$JOBS_DIR/lockholder.job" TERM >/dev/null 2>&1; r2=$?
    sleep 0.5
    chk "sensor.lock holder registered as a valid job: signal_job refuses USR1 and TERM" "1 1:" "$r $r2:$(cat $O7 2>/dev/null | tr '\n' ' ')"
    chk "  ...as protected (pidinfo --state-dir said protected=1)"  2 "$(( $(grep -c "REFUSED to signal protected pid=$LKP " "$LOG" 2>/dev/null) - ${B:-0} ))"
    chk "  ...and it is alive"                                       alive "$(kill -0 $LKP 2>/dev/null && print alive || print DEAD)"
    kill -9 $LKP 2>/dev/null
  else
    chk "built the sensor.lock holder (see $SB/build.log)" built FAILED
  fi
  rm -f "$O7"
  SENSOR_BIN=$SAVED_SENSOR_BIN
  kill -9 $HP $PV 2>/dev/null
else
  chk "built the real sensor and a 'Claude Helper' victim (see $SB/build.log)" built FAILED
  sed -n '1,20p' "$SB/build.log" 2>/dev/null | sed 's/^/    /'
fi

print "== ACT-3: a non-canonical pid in an envelope is invalid: never signalled, reaped =="
spawn "$O3.pad"; PADV=$REPLY; sleep 0.4
plant pad.job "0$PADV" padded-pid 9 1 $EPOCHSECONDS
signal_job "$JOBS_DIR/pad.job" USR1 >/dev/null 2>&1; r=$?; sleep 0.4
chk "pid=0$PADV: signal_job refuses"                               1 "$r"
chk "  ...the process behind the padded number received nothing"   "" "$(cat $O3.pad 2>/dev/null)"
touch -t $(date -v-1M +%Y%m%d%H%M.%S) "$JOBS_DIR/pad.job"
reap_dead_jobs
chk "  ...and the envelope is reaped as invalid"                   0 "$(ls $JOBS_DIR/pad.job 2>/dev/null | wc -l | tr -d ' ')"
kill -9 $PADV 2>/dev/null

print "== R7: an envelope over 64 KiB is unverifiable -- kept and counted, never signalled =="
spawn "$O4.big"; BIGV=$REPLY; sleep 0.4
{ print "pid=$BIGV"; print "name=longargs"; print "priority=9"; print "can_restart=1"; print "peak_gb=20"; print "gpu=0"
  print "started=$EPOCHSECONDS"; print -n "cmd="; head -c 70000 /dev/zero | tr '\0' a; print; } > "$JOBS_DIR/big.job"
PLANTED+=(big.job)
reap_dead_jobs
chk "a live job's 70 KB envelope is NOT reaped"                    1 "$(ls $JOBS_DIR/big.job 2>/dev/null | wc -l | tr -d ' ')"
chk "  ...it is counted in registered_jobs"                         1 "$(( O_JOBS >= 1 ))"
chk "  ...and its declared 20 GiB reservation is counted"          1 "$(( ENV_RESERVED_MILLI >= 20000 ))"
signal_job "$JOBS_DIR/big.job" TERM >/dev/null 2>&1; r=$?; sleep 0.4
chk "  ...but it is never signalled (unverifiable)"                "1:alive:" "$r:$(kill -0 $BIGV 2>/dev/null && print alive || print DEAD):$(cat $O4.big 2>/dev/null)"
kill -9 $BIGV 2>/dev/null; sleep 0.3
reap_dead_jobs
chk "  ...once its pid is dead, the oversize envelope is reaped"   0 "$(ls $JOBS_DIR/big.job 2>/dev/null | wc -l | tr -d ' ')"

print "== R1: a FIFO named *.job never blocks a reader =="
mkfifo "$JOBS_DIR/424242.job"
( read_envelope "$JOBS_DIR/424242.job"; print "rc=$?" ) > "$O1.fifo" 2>&1 & RP=$!; print $RP >> "$PIDS"
for i in {1..20}; do kill -0 $RP 2>/dev/null || break; sleep 0.1; done
if kill -0 $RP 2>/dev/null; then kill -9 $RP 2>/dev/null; FR=BLOCKED; else FR=$(<"$O1.fifo"); fi
chk "read_envelope on a FIFO returns at once, refusing it"          "rc=1" "$FR"
( reap_dead_jobs; shed_list; print "done ${#SHED_LIST}" ) > "$O1.fifo" 2>&1 & RP=$!; print $RP >> "$PIDS"
for i in {1..20}; do kill -0 $RP 2>/dev/null || break; sleep 0.1; done
if kill -0 $RP 2>/dev/null; then kill -9 $RP 2>/dev/null; FR=BLOCKED; else FR=$(<"$O1.fifo"); FR=${FR%% *}; fi
chk "the reaper and shed_list pass over it"                          done "$FR"
chk "  ...and leave it alone (never opened, never deleted)"          1 "$([[ -p $JOBS_DIR/424242.job ]] && print 1 || print 0)"
rm -f "$JOBS_DIR/424242.job" "$O1.fifo" "$O3.pad" "$O4.big" "$O5" "$O6"

print ""
print "RESULT: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
