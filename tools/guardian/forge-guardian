#!/bin/zsh
# ============================================================================
# FORGE GUARDIAN — workstation resource governor (spec doc 06, L0)
#
# The predecessor (healthmon.sh) was a DETECTOR: it emitted text and nothing
# acted on it. Guardian is a GOVERNOR. It publishes a machine-readable pressure
# state that every heavy job must consult before and during execution, and it
# actuates load-shedding when the machine is genuinely in danger.
#
# DOCTRINE (doc 06):
#   - macOS memory pressure is the PRIMARY truth; RSS/swap/pageouts corroborate.
#   - Never wait for an allocation failure before reacting.
#   - The UI, project state and supervisor survive worker failures.
#
# HARD SAFETY RULES (learned, do not relax):
#   1. A LEVEL IS NOT A TREND. Escalation requires a moving signal, not a large
#      steady one. A 30B model resident at 7GB is WANTED, not an emergency.
#   2. NEVER kill an unregistered process. Machine-wide pkill patterns kill every
#      parallel agent's work (measured 2026-08-21). Guardian may only signal PIDs
#      that registered themselves with an envelope and declared can_restart.
#   3. A VECTOR OF OBSERVABLES, never one. Any single number can be clean while
#      the machine is dying.
#   4. HYSTERESIS. Escalate only after N consecutive confirming polls; de-escalate
#      only after M. A flapping governor is worse than none.
#   5. Cooperative before coercive: publish -> SIGUSR1 (checkpoint+shed) ->
#      SIGTERM -> SIGKILL, in that order, with grace periods.
#
# v2 (T-173..T-176). The binding contract is tools/guardian/SCHEMA.md; every file,
# key and exit code a consumer reads is defined there. In one paragraph: a native
# sensor (`forge-guardian-sensor run`, a CHILD of this daemon) samples the machine
# and writes sensor.env; this governor supervises it, classifies, applies
# hysteresis, publishes, and is the only thing that signals registered jobs. While
# the sensor is down the governor samples for itself and marks every signal it
# cannot sample `unavailable`. An unavailable signal is NEVER given a value that
# reads as healthy. That was T-173's core defect: `pmset -g therm` prints no
# CPU_Speed_Limit line on Apple Silicon, and the v1 sampler defaulted thermal to
# 100% -- "healthy, forever" -- on the very machine this governs.
# ============================================================================
set -u
setopt NULL_GLOB 2>/dev/null || true
# Everything this governor creates is private to its user (SCHEMA §2: dirs 0700,
# files 0600). In library mode this also applies to the sourcing shell -- a test.
umask 077

# ---- argv: this program takes no arguments ------------------------------------
# Guardian IS the daemon, not a CLI. Until 2026-09-11 every argument was silently
# ignored and the daemon started anyway, so a typo -- `forge-guardian status` --
# launched a SECOND governor beside the launchd-owned one. RED_STAGE, the
# hysteresis counters and the TERM grace periods are all per-process state, so
# while two run, Hard Safety Rules 4 (hysteresis) and 5 (cooperative-before-
# coercive) above are both void: two independent escalation ladders shed the
# same job set. Reject arguments and name the tool that does take them.
if [[ -z "${FORGE_GUARDIAN_LIB:-}" ]] && (( $# > 0 )); then
  print -u2 "forge-guardian: takes no arguments (it is the daemon itself), got: $*"
  print -u2 "  to inspect or control it:  forge-guardian-ctl {start|stop|status|tail}"
  exit 2
fi
STATE_DIR=${FORGE_HEALTH_DIR:-$HOME/.forge-health}
JOBS_DIR="$STATE_DIR/jobs"
LOG="$STATE_DIR/log/guardian.log"
STATE_F="$STATE_DIR/state"
STATE_J="$STATE_DIR/state.json"
# Law-7 health signal consumed by the archdisc-Models training fleet.
AH_DIR=${ARCHIE_HEALTH_DIR:-/tmp/archie_health}
AH_F="$AH_DIR/status.json"
mkdir -p "$JOBS_DIR" "$STATE_DIR/log"

# ---- zsh modules: the steady state forks nothing but its poll sleep ------------
# v1 forked ~30 processes per poll (date, sed, awk, cat, mv, sysctl...). A governor
# that is itself a fork storm is measured by the thing it is supposed to protect.
# `-F ... b:zstat` and the zf_ names load ONLY those builtins: a test that sources
# this file keeps /usr/bin/stat, /bin/mv and /bin/rm under their usual names.
zmodload zsh/datetime 2>/dev/null                               # EPOCHSECONDS, EPOCHREALTIME, strftime
zmodload -F zsh/stat b:zstat 2>/dev/null
zmodload -F zsh/files b:zf_mv b:zf_rm b:zf_mkdir 2>/dev/null
# sysopen/sysread: an envelope is opened O_NONBLOCK|O_NOFOLLOW and fstat'ed BEFORE it
# is read, so a FIFO named *.job can never block the governor (review 2026-10-08 R1:
# `mkfifo jobs/424242.job` wedged it in open(2) -- nothing published, nothing actuated).
zmodload -F zsh/system b:sysopen b:sysread 2>/dev/null
# syswrite/sysseek/systell: a JSONL record is appended with ONE counted write, so a short
# write (ENOSPC) knows exactly which bytes it left behind and can take them back (R6).
zmodload -F zsh/system b:syswrite b:sysseek f:systell 2>/dev/null
(( ${+builtins[zf_mv]} ))    || zf_mv()    { command mv "$@" }
(( ${+builtins[zf_rm]} ))    || zf_rm()    { command rm "$@" }
(( ${+builtins[zf_mkdir]} )) || zf_mkdir() { command mkdir "$@" }

# ---- single instance ----------------------------------------------------------
# THE BUG (measured 2026-09-11): argv was ignored, so `forge-guardian status`
# started a SECOND governor beside the launchd-owned one. RED_STAGE, the
# hysteresis counters and the TERM grace periods are all per-process, so while
# two run, Hard Safety Rules 4 and 5 above are void -- two independent ladders
# shed the same jobs.
#
# BIAS: FAIL OPEN. launchd runs this KeepAlive=true, ThrottleInterval=10. A guard
# that wrongly refuses leaves the machine with NO governor while respawning every
# 10s -- far worse than the duplicate it prevents. So every refusal must rest on
# positive, DOMAIN-SCOPED evidence, and every ambiguous case must start.
#
# WHAT ACTUALLY CONFLICTS is the domain: $STATE_DIR's job registry, state files
# and Law-7 signal. Two guardians on different FORGE_HEALTH_DIRs share none of
# it and must not block each other. `ps -E` is SIP-restricted here, so a peer's
# FORGE_HEALTH_DIR cannot be read from the process table and PROCESS IDENTITY
# CANNOT BE DOMAIN-SCOPED. Both signals below therefore live inside $STATE_DIR:
#   1. the lock       -- authoritative, atomic, and per-domain by its path
#   2. state freshness -- the governor republishes $STATE_F every poll, so a
#                         fresh file means this domain is governed right now
LOCK_D="$STATE_DIR/guardian.lock"
GUARD_SELF=${0:A}
GUARD_BASE=${GUARD_SELF:t}
LOCK_HELD=0

# Is $1 a live process running this same guardian script? Checked per-PID with
# `ps -p`, never by grepping the process table: a table grep matches its own grep
# and the zsh wrapper, which cost two healthy autopilots (measured 2026-08-21).
# Exact-basename matching on a shell word also excludes the siblings
# forge-guardian-ctl / -selftest / -actuator-test for free.
is_live_guardian() {
  local p=$1 a w
  [[ -n "$p" && "$p" == <-> ]] || return 1
  (( p == $$ )) && return 1
  kill -0 "$p" 2>/dev/null || return 1
  a=$(ps -p "$p" -o args= 2>/dev/null) || return 1
  [[ -n "$a" ]] || return 1
  # ${(z)a} splits into shell words. A bare `for w in $a` iterates ONCE in zsh.
  for w in ${(z)a}; do
    [[ ${w:t} == "$GUARD_BASE" ]] && return 0
  done
  return 1
}

# Is THIS domain being governed right now? Only a live governor keeps $STATE_F
# rewritten. 3 polls of slack: the poll that matters is the one under memory
# pressure, which is exactly when a cycle runs long.
domain_is_governed() {
  [[ -f "$STATE_F" ]] || return 1
  local -i lim=$(( ${FORGE_GUARDIAN_POLL:-5} * 3 ))
  (( lim < 3 )) && lim=3
  local -i mt=$(stat -f %m "$STATE_F" 2>/dev/null || print 0)
  (( mt > 0 )) || return 1
  (( $(date +%s) - mt <= lim ))
}

# Best-effort pid for the refusal message only -- NEVER for the decision. It
# matches by basename, so it can name a guardian from another domain.
# THE TRAP IT AVOIDS: `$(ps | awk)` forks a subshell that inherits THIS script's
# argv verbatim, so a naive scan finds itself and every guardian refuses to start.
name_a_guardian() {
  local anc="," p=$PPID ; local -i d=0
  while [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] && (( d++ < 64 )); do
    anc="$anc$p,"; p=$(ps -p "$p" -o ppid= 2>/dev/null | tr -d ' ')
  done
  ps -axo pid=,ppid=,args= 2>/dev/null | awk -v base="$GUARD_BASE" -v self="$$" -v anc="$anc" '
    { par[$1]=$2; a=""; for (i=3;i<=NF;i++) a=a " " $i; argv[$1]=a; order[++n]=$1 }
    END {
      for (k=1;k<=n;k++) {
        p=order[k]
        if (p==self || index(anc, "," p ",")) continue
        q=p; d=0; mine=0
        while (q!="" && q!="0" && q!="1" && d++<64) { if (q==self) { mine=1; break } q=par[q] }
        if (mine) continue
        m=split(argv[p], w, " ")
        for (i=1;i<=m;i++) { nn=split(w[i], z, "/"); if (z[nn]==base) { print p; exit } }
      }
    }'
}

refuse_duplicate() {
  print -u2 "forge-guardian: $1 is already governing $STATE_DIR; refusing to start a second governor."
  print -u2 "  two governors keep independent RED_STAGE, hysteresis and grace-period state,"
  print -u2 "  which voids the staged load-shedding doctrine for every registered job."
  print -u2 "  to inspect it:  forge-guardian-ctl status"
  exit 3
}

release_lock() {
  # ANY exit of a governing daemon -- including an error exit (`set -u` has killed it
  # before) -- retracts what it published: UNKNOWN, heavy_jobs_ok=false, -j at the
  # UNKNOWN value, into state.json AND the Law-7 status.json. Before this, only `state`
  # was back-dated, so state.json and status.json kept asserting a fresh GREEN for up
  # to 60 s after the governor was gone (review 2026-10-08 FO-4). Never on a refusal
  # path (DAEMON_UP=0): another governor owns the domain then.
  if (( DAEMON_UP && ! STOP_PUBLISHED )); then
    STOP_PUBLISHED=1
    {
      set +u
      EVIDENCE_COMPLETE=0; CRITICAL_NOW=0; MISSING=(guardian); MISSING_DESC="guardian exited"
      publish UNKNOWN "guardian exited unexpectedly" 2
    } always {
      TRY_BLOCK_ERROR=0
    }
  fi
  (( LOCK_HELD )) || return 0
  [[ -d "$LOCK_D" ]] || return 0
  [[ "$(cat "$LOCK_D/pid" 2>/dev/null)" == "$$" ]] || return 0
  rm -rf "$LOCK_D" 2>/dev/null
  # We are no longer publishing, so the domain must not look governed. This lets
  # a replacement start AT ONCE after an orderly stop, and tells every age-based
  # consumer the truth immediately instead of after their staleness window.
  [[ -f "$STATE_F" ]] && touch -t 197001020000 "$STATE_F" 2>/dev/null
  return 0
}
# Signals whose default action would end the daemon silently: each now runs the orderly
# stop (publish UNKNOWN, stop the sensor). Subshells reset them (see notify).
# VTALRM PROF SYS ABRT EMT (review 2026-10-08 round 2, FO-4 residual): trappable and
# terminating by default too; after any of them the governor was dead while state.json
# and the Law-7 status.json stayed a fresh GREEN. Not trapped: KILL and STOP (they cannot
# be), and the synchronous fault signals SEGV BUS ILL FPE TRAP -- a handler that returns
# re-runs a real faulting instruction and would hang the governor instead of ending it
# (a hang is worse: launchd restarts a dead governor, never a wedged one). A real abort()
# still kills (it restores the default action before re-raising).
typeset -ga STOP_SIGNALS; STOP_SIGNALS=(HUP QUIT ALRM USR1 PIPE XCPU XFSZ VTALRM PROF SYS ABRT EMT)
POLL=${FORGE_GUARDIAN_POLL:-5}
ESCALATE_N=2      # 2 polls (~10s) to escalate — fast enough to beat an OOM
DEESCALATE_N=6    # 6 polls (~30s) to relax — slow, so we do not flap
NCPU=$(sysctl -n hw.ncpu)
NPERF=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null || echo $((NCPU/2)))
RAM_BYTES=$(sysctl -n hw.memsize)
RAM_GB=$(( RAM_BYTES / 1073741824 ))
PAGE=$(sysctl -n hw.pagesize)
GUARDIAN_VERSION=2.0.0

# Processes Guardian must NEVER signal, even if they somehow appear registered.
# (v1's regex, kept for anything that reads it; is_protected_comm is the v2 list.)
PROTECTED_RE='(^|/)(claude|node|WindowServer|loginwindow|Finder|kernel_task|launchd|forge-guardian)$'

# ---- appends (guardian.log, events.jsonl, history.jsonl) ------------------------
# One WHOLE record per line, or none (SCHEMA §7). THE BUG (review 2026-10-08 R6): on a
# full volume write(2) fills the last block's slack and returns short, leaving a torn
# fragment with no newline, and the next record appended to that file -- ours or the
# sensor's -- was glued onto it and lost (`{"ts":...,"kind{"ts": ..., "kind":
# "transition", ...}`: the RED->GREEN transition itself unreadable). Round 1 only
# started our NEXT record on a new line, so the fragment stayed an invalid line and the
# sensor's next events.jsonl record was still swallowed by it (round 2).
#
# Now each record is ONE counted write on an O_APPEND fd (syswrite -c: the bytes that
# made it). A short write ends exactly at systell(fd); while the file still ends there
# (no other writer appended after it) those bytes are cut off again, so the file keeps
# its previous length -- every line parses and the next record, anyone's, survives.
# The cut needs ftruncate, which zsh has no builtin for: `forge-guardian-sensor append
# --truncate-to N --if-size M` (it re-checks the size in-process right before cutting),
# else `dd` when no sensor binary exists (then nothing else appends to the domain's
# files). That fork happens ONLY on a failed write: the steady state stays fork-free.
# A file that does not end in a newline (another writer's fragment that could not be
# undone) gets our record on a new line, so a fragment is never more than its own line.
# The first failure of a streak is logged and reported as a publish_error (best effort:
# the disk that refused one file usually refuses the others too).
typeset -gA APPEND_TORN APPEND_FAILING
APPEND_IN_ERR=0
APPEND_UNDO_HELPER=1    # 0: the sensor binary has no `append` subcommand (an older one)
append_undo() { # append_undo FILE N M: cut FILE back to N bytes iff it is still M bytes long
  local f=${1:A} rc
  local -A st
  if [[ -n ${SENSOR_BIN:-} ]] && (( APPEND_UNDO_HELPER )); then
    "$SENSOR_BIN" append --file "$f" --truncate-to "$2" --if-size "$3" </dev/null >/dev/null 2>&1; rc=$?
    (( rc == 2 )) || return $rc          # 0 cut; 1 not cut (it grew: another writer's record)
    APPEND_UNDO_HELPER=0                 # usage error: a sensor that predates `append`
  fi
  zstat -H st -- "$f" 2>/dev/null && (( st[size] == $3 )) || return 1
  dd if=/dev/null of="$f" bs=1 seek="$2" 2>/dev/null </dev/null >/dev/null
}
append_rec() { # append_rec FILE LINE -> 0, or 1 when the append failed (nothing torn is left when it can be helped)
  local LC_ALL=C                       # byte lengths, not characters
  local f=$1 data="$2"$'\n' fd last="" known=0 end left=0
  local -i n=0
  local -A st
  # (a symlinked log or ledger is followed, as `print >>` always did: a gate keeps the
  # evidence of a full volume on another disk that way; the TARGET must be a regular file)
  if ! sysopen -r -a -o creat,nonblock,cloexec -m 600 -u fd -- "$f" 2>/dev/null; then
    append_failed "$f" 0; return 1
  fi
  if ! zstat -H st -f $fd 2>/dev/null || (( (st[mode] & 8#170000) != 8#100000 )); then
    exec {fd}>&- 2>/dev/null; append_failed "$f" 0; return 1          # never into a FIFO or device
  fi
  if (( st[size] == 0 )); then known=1; last=$'\n'
  elif sysseek -u $fd -w start $(( st[size] - 1 )) 2>/dev/null && sysread -s 1 -i $fd last 2>/dev/null; then known=1; fi
  if (( known )); then [[ $last == $'\n' ]] || data=$'\n'$data
  elif (( ${+APPEND_TORN[$f]} )); then data=$'\n'$data; fi
  if syswrite -c n -o $fd -- "$data" 2>/dev/null; then
    exec {fd}>&- 2>/dev/null; unset "APPEND_TORN[$f]" "APPEND_FAILING[$f]"; return 0
  fi
  # Short or failed: our bytes are exactly [end - n, end).
  if (( n > 0 )); then
    end=$(( systell(fd) ))
    left=1
    if zstat -H st -f $fd 2>/dev/null && (( st[size] == end && end >= n )) && append_undo "$f" $(( end - n )) $end; then
      left=0
    fi
  fi
  exec {fd}>&- 2>/dev/null
  append_failed "$f" $left
  return 1
}
append_failed() { # append_failed FILE LEFT: LEFT=1 when a torn fragment could not be taken back
  local f=$1
  if (( $2 )); then APPEND_TORN[$f]=1; fi
  (( APPEND_IN_ERR || ${+APPEND_FAILING[$f]} )) && return 0     # reported once per streak
  APPEND_FAILING[$f]=1
  APPEND_IN_ERR=1
  if (( $2 )); then log "APPEND FAILED: ${f:t} -- a partial record remains (it could not be cut off); the next append to it starts on a new line"
  else log "APPEND FAILED: ${f:t} -- the record was not written; the file keeps its previous length"; fi
  event publish_error "\"file\": \"${f:t}\", \"errno\": -1"
  APPEND_IN_ERR=0
  return 0
}
log() { local _t; strftime -s _t '%Y-%m-%dT%H:%M:%S' $EPOCHSECONDS; append_rec "$LOG" "$_t $1"; return 0; }
emit() { print -r -- "$1"; log "$1"; }

# ---- small pure helpers (no forks) ---------------------------------------------
# REPLY carries every helper's result: make sure it is a plain scalar, whatever the
# sourcing shell (or a builtin like `strftime -r -s`) did to it before.
typeset -g +i +F +E REPLY 2>/dev/null; REPLY=""
is_uint() { [[ $1 == <-> ]] && (( ${#1} <= 18 )) }
is_int()  { [[ $1 == (|-)<-> ]] && (( ${#1} <= 19 )) }
is_udec() { [[ $1 == <->(|.<->) ]] && (( ${#1} <= 32 )) }
# A pid is CANONICAL decimal (SCHEMA §5): no sign, no leading zero, <= 99999. Anything
# else in an envelope is invalid -- review 2026-10-08 ACT-3: `pid=034023` slipped past
# the string-keyed ancestor check while `kill` read it as 34023.
is_pid()  { [[ $1 == [1-9]* && $1 == <1-99999> ]] }
# %XX -> the byte (env_word's encoding: pidinfo comm=, policy disk_volumes, vol mounts).
pct_decode() { setopt localoptions extendedglob; REPLY=${1//(#b)%([0-9A-Fa-f][0-9A-Fa-f])/${(#):-0x$match[1]}} }
# A signal status is one of four words (SCHEMA §3). Anything else is `invalid`.
st_norm() { case $1 in ok|unavailable|stale|invalid) REPLY=$1 ;; *) REPLY=invalid ;; esac }
# decimal string -> integer thousandths, without floating point or the locale
to_milli() {
  local v=$1 i f=""
  i=${v%%.*}; [[ $v == *.* ]] && f=${v#*.}
  f=${f[1,3]}; while (( ${#f} < 3 )); do f+=0; done
  REPLY=$(( 10#$i * 1000 + 10#$f ))
}
# integer thousandths -> "x.y" (one decimal)
milli_1dp() { local t=$(( $1 / 100 )); (( t < 0 )) && t=0; REPLY="$(( t / 10 )).$(( t % 10 ))" }
json_esc() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
  REPLY=${s//[[:cntrl:]]/}
}
utc_iso() { local TZ=UTC; strftime -s REPLY '%Y-%m-%dT%H:%M:%SZ' $1 }
event() { # event KIND ['"k": v, ...'] -> one line of events.jsonl (SCHEMA §7)
  setopt localoptions extendedglob
  local t=$EPOCHREALTIME
  [[ $t == (#b)(<->).(<->) ]] && t="$match[1].${match[2][1,3]}"
  append_rec "$STATE_DIR/events.jsonl" "{\"ts\": $t, \"kind\": \"$1\"${2:+, $2}}"
  return 0
}

# ---- policy (SCHEMA §6) -------------------------------------------------------
# policy.env is the sensor's flattening of policy.json. Read with a builtin loop;
# every value is validated by type; a missing file means the built-in defaults,
# which equal tools/guardian/policy.default.json. The env vars the gates use
# (FORGE_GUARDIAN_POLL / _SETTLE / _TERM_GRACE) keep overriding.
typeset -gA POL POL_DEF
POL_DEF=(
  poll_s 5  escalate_polls 2  deescalate_polls 6  sensor_stale_polls 3
  required_signals "vm_pressure swap pageouts disk thermal"
  memory_os_reserve_gb 6  memory_instant_margin_gb 2  memory_enforce_instant_fit 1  memory_light_job_gb 0.5
  disk_floors_gib_yellow 45  disk_floors_gib_orange 25  disk_floors_gib_red 12  disk_admission_floor yellow
  disk_volumes "~ /private/tmp"
  thermal_fair YELLOW  thermal_serious ORANGE  thermal_critical RED
  eviction_settle_s 180  eviction_term_grace_s 45
  crash_loop_max_crashes 3  crash_loop_window_s 900  crash_loop_crash_signals "SEGV BUS ILL ABRT FPE TRAP SYS KILL"
  guardian_restart_loop_max_starts 5  guardian_restart_loop_window_s 900  guardian_restart_loop_backoff_s 300
  logs_cap_mib 64  logs_rotate_mib 4  logs_generations 3  logs_history_mib 6  logs_incident_max_kib 512  logs_retention_days 30
  notifications_enabled 1  notifications_min_interval_s 1800
  reports_scan_interval_s 600  smart_interval_s 21600
)
# SCHEMA §6 bounds -- ONE table, the same one the sensor enforces on policy.json. The
# governor re-checks policy.env defensively: a value outside its range rejects THAT key
# (default + policy_error). Review 2026-10-08: poll_s=4000 was accepted here and refused
# by `sensor run` (the sensor never started again, sticky); logs.generations=1e9 wedged
# the rotation loop at 100% CPU; sensor_stale_polls=1e9 kept GREEN on a frozen sensor.
typeset -gA POL_RANGE
POL_RANGE=(
  poll_s 1:60  escalate_polls 1:10  deescalate_polls 1:60  sensor_stale_polls 2:12
  disk_floors_gib_yellow 1:10000  disk_floors_gib_orange 1:10000  disk_floors_gib_red 1:10000
  eviction_settle_s 0:3600  eviction_term_grace_s 1:600
  crash_loop_max_crashes 1:100  crash_loop_window_s 60:86400
  guardian_restart_loop_max_starts 2:100  guardian_restart_loop_window_s 60:86400  guardian_restart_loop_backoff_s 10:3600
  logs_cap_mib 8:1024  logs_rotate_mib 1:64  logs_generations 1:10  logs_history_mib 1:64
  logs_incident_max_kib 64:4096  logs_retention_days 1:365
  notifications_min_interval_s 60:86400  reports_scan_interval_s 60:86400  smart_interval_s 600:604800
)
# decimal keys, in thousandths (memory.os_reserve_gb's upper bound is RAM-2: see policy_value)
typeset -gA POL_DEC_RANGE
POL_DEC_RANGE=( memory_os_reserve_gb 2000:-1  memory_instant_margin_gb 0:16000  memory_light_job_gb 0:2000 )
# required_signals: a set drawn from these five that contains at least the core four
# (an empty or core-less list published GREEN with every signal unavailable: review FO-3).
typeset -ga REQ_ALLOWED REQ_CORE
REQ_ALLOWED=(vm_pressure swap pageouts disk thermal); REQ_CORE=(vm_pressure swap pageouts disk)
POLICY_ERRORS=""; POLICY_MTIME=-1; POLICY_SOURCE=defaults; POLL_SET=0
policy_value() { # policy_value KEY VALUE -> REPLY normalised, or 1 when the value is wrong for the key
  local k=$1 v=$2 lo hi s
  local -a got
  if (( ${+POL_RANGE[$k]} )); then
    lo=${POL_RANGE[$k]%%:*}; hi=${POL_RANGE[$k]##*:}
    is_uint "$v" && (( ${#v} <= 9 && v >= lo && v <= hi )) && { REPLY=$(( 10#$v )); return 0 }
    return 1
  fi
  if (( ${+POL_DEC_RANGE[$k]} )); then
    lo=${POL_DEC_RANGE[$k]%%:*}; hi=${POL_DEC_RANGE[$k]##*:}
    # memory.os_reserve_gb: 2 .. RAM-2 GiB (SCHEMA §6). It was RAM/2, which refused the
    # shipped default 6 on an 8 GiB Mac (RAM/2 = 4), so the installed policy.json lost
    # that key at every start. RAM-2 leaves at least 2 GiB of budget whatever the reserve.
    # RAM_BYTES is the hook a library-mode test sets to stand in for another Mac.
    (( hi < 0 )) && hi=$(( RAM_BYTES * 1000 / 1073741824 - 2000 ))
    is_udec "$v" && (( ${#v} <= 12 )) || return 1
    to_milli "$v"; (( REPLY >= lo && REPLY <= hi )) || return 1
    # to_milli keeps three decimals, so 6.0005 was 6000 thousandths and passed an upper bound
    # of 6 that the sensor refuses whole (review 2026-10-08 round 2, verify item 5): AT the
    # bound, any non-zero digit past the third decimal is over it.
    (( REPLY == hi )) && [[ $v == *.* && ${${v#*.}[4,-1]} == *[1-9]* ]] && return 1
    REPLY=$v; return 0
  fi
  case $k in
    memory_enforce_instant_fit|notifications_enabled)
      case $v in 1|true) REPLY=1 ;; 0|false) REPLY=0 ;; *) return 1 ;; esac; return 0 ;;
    thermal_fair|thermal_serious|thermal_critical) [[ $v == (GREEN|YELLOW|ORANGE|RED) ]] && { REPLY=$v; return 0 }; return 1 ;;
    disk_admission_floor) [[ $v == (yellow|orange|red) ]] && { REPLY=$v; return 0 }; return 1 ;;
    required_signals)
      for s in ${=v}; do
        (( ${REQ_ALLOWED[(Ie)$s]} )) || return 1
        (( ${got[(Ie)$s]} )) || got+=($s)
      done
      for s in $REQ_CORE; do (( ${got[(Ie)$s]} )) || return 1; done
      REPLY=${(j: :)got}; return 0 ;;
    *) [[ -n $v ]] && { REPLY=$v; return 0 }; return 1 ;;
  esac
}
load_policy() {
  local f="$STATE_DIR/policy.env" line k v n=0
  local -a bad
  POL=("${(@kv)POL_DEF}")
  POLICY_SOURCE=defaults
  if [[ -f $f && -r $f ]]; then
    POLICY_SOURCE=$f
    while IFS= read -r line || [[ -n $line ]]; do
      (( ++n > 2000 )) && break
      [[ $line == [a-z]*=* ]] || continue
      k=${line%%=*}; v=${line#*=}
      (( ${+POL_DEF[$k]} )) || continue          # keys this governor does not interpret
      if policy_value "$k" "$v"; then POL[$k]=$REPLY; else bad+=("$k=$v"); fi
    done < "$f"
  fi
  # SCHEMA §6: floors must be strictly ordered red < orange < yellow, else defaults.
  if ! (( POL[disk_floors_gib_red] < POL[disk_floors_gib_orange] && POL[disk_floors_gib_orange] < POL[disk_floors_gib_yellow] )); then
    bad+=("disk floors not strictly ordered red<orange<yellow (${POL[disk_floors_gib_red]}/${POL[disk_floors_gib_orange]}/${POL[disk_floors_gib_yellow]})")
    POL[disk_floors_gib_red]=$POL_DEF[disk_floors_gib_red]
    POL[disk_floors_gib_orange]=$POL_DEF[disk_floors_gib_orange]
    POL[disk_floors_gib_yellow]=$POL_DEF[disk_floors_gib_yellow]
  fi
  POLICY_ERRORS=${(j:; :)bad}
  apply_policy
}
class_pct() { case $1 in GREEN) REPLY=100 ;; YELLOW) REPLY=85 ;; ORANGE) REPLY=65 ;; RED) REPLY=30 ;; *) REPLY=100 ;; esac }
# The sensor reports NSProcessInfo.thermalState as a WORD. classify() is a pure
# function of a percentage (v1's CPU_Speed_Limit), so the word is mapped onto the
# same ladder: nominal 100, fair 85 (<90 YELLOW), serious 65 (<70 ORANGE),
# critical 30 (<40 RED) -- or wherever policy thermal_* puts each word.
thermal_pct() {
  case $1 in
    nominal)  REPLY=100 ;;
    fair)     class_pct "${POL[thermal_fair]}" ;;
    serious)  class_pct "${POL[thermal_serious]}" ;;
    critical) class_pct "${POL[thermal_critical]}" ;;
    *) return 1 ;;
  esac
  return 0
}
thermal_word() { # CPU_Speed_Limit % -> the same four words
  if (( $1 < 40 )); then REPLY=critical; elif (( $1 < 70 )); then REPLY=serious; elif (( $1 < 90 )); then REPLY=fair; else REPLY=nominal; fi
}
apply_policy() {
  if (( ! POLL_SET )); then
    if is_uint "${FORGE_GUARDIAN_POLL:-}" && (( ${#FORGE_GUARDIAN_POLL} <= 3 && FORGE_GUARDIAN_POLL >= 1 && FORGE_GUARDIAN_POLL <= 60 )); then
      POLL=$(( 10#$FORGE_GUARDIAN_POLL ))
    else POLL=$POL[poll_s]; fi
  fi
  ESCALATE_N=$POL[escalate_polls]; DEESCALATE_N=$POL[deescalate_polls]
  STALE_POLLS=$POL[sensor_stale_polls]
  DISK_FLOOR_YELLOW=$POL[disk_floors_gib_yellow]
  DISK_FLOOR_ORANGE=$POL[disk_floors_gib_orange]
  DISK_FLOOR_RED=$POL[disk_floors_gib_red]
  case $POL[disk_admission_floor] in
    red) ADM_FLOOR=$DISK_FLOOR_RED ;; orange) ADM_FLOOR=$DISK_FLOOR_ORANGE ;; *) ADM_FLOOR=$DISK_FLOOR_YELLOW ;;
  esac
  REQUIRED_SIGNALS=(${=POL[required_signals]})
  # (a non-numeric override would reach arithmetic under `set -u` and kill the daemon)
  is_uint "${FORGE_GUARDIAN_SETTLE:-}" && GRACE_SETTLE=$FORGE_GUARDIAN_SETTLE || GRACE_SETTLE=$POL[eviction_settle_s]
  is_uint "${FORGE_GUARDIAN_TERM_GRACE:-}" && GRACE_TERM=$FORGE_GUARDIAN_TERM_GRACE || GRACE_TERM=$POL[eviction_term_grace_s]
  # (a test override, like FORGE_GUARDIAN_POLL: policy smart_interval_s is >= 600 s)
  if is_uint "${FORGE_GUARDIAN_SMART_S:-}" && (( ${#FORGE_GUARDIAN_SMART_S} <= 6 && FORGE_GUARDIAN_SMART_S >= 1 )); then
    SMART_S=$(( 10#$FORGE_GUARDIAN_SMART_S ))
  else SMART_S=$POL[smart_interval_s]; fi
  # policy.env carries each volume percent-encoded (env_word: a space is %20). Decode
  # BEFORE use: `df -g .../vol%20space` fails, and the encoded path was published as the
  # mount (review 2026-10-08 R11).
  local v; DISK_VOLUMES=()
  for v in ${=POL[disk_volumes]}; do
    pct_decode "$v"; v=$REPLY
    case $v in "~") v=$HOME ;; "~/"*) v=$HOME/${v#\~/} ;; esac
    DISK_VOLUMES+=("$v")
  done
  (( ${#DISK_VOLUMES} )) || DISK_VOLUMES=(/)
}
load_policy
POLL_SET=1

# ---- observation state ---------------------------------------------------------
# O_* are classify()'s inputs. When a signal is not `ok` its O_* holds the value
# that triggers NOTHING (so missing evidence never fabricates pressure), its O_ST_*
# says why, and every publisher prints -1 for it (so it never reads as healthy
# either). The evidence step, not classify(), turns "missing" into UNKNOWN.
O_VMP=1; O_FREE=100; O_SWU=0; O_SWT=1; O_PORATE=0; O_DISK=999; O_LOAD=0; O_THERM=100; O_JOBS=0
O_SWT_RAW=0; O_THERM_STATE=none; O_PEVENT=none
# Where O_THERM came from: `pct` = a MEASURED CPU_Speed_Limit (pmset, Intel), `word` =
# the sensor's NSProcessInfo.thermalState mapped onto the ladder. Only a measured value
# is ever published as cpu_speed_limit_pct (review 2026-10-08 SEM-5: 85/65/30 were
# invented from the word and published under pmset's v1 key).
O_THERM_SRC=pct
O_ST_VMP=unavailable; O_ST_FREE=unavailable; O_ST_SWAP=unavailable; O_ST_PAGEOUTS=unavailable
O_ST_DISK=unavailable; O_ST_THERMAL=unavailable; O_ST_PEVENT=unavailable; O_ST_MEM=unavailable; O_ST_CPU=unavailable
CRITICAL_NOW=0; CRIT_WHY=""; PEVENT_CRIT_NEW=0; PUBLISH_FAILED=0; PUB_FAIL=""
EVIDENCE_COMPLETE=0; MISSING=(); MISSING_DESC=""
EV_SOURCE=fallback; SENSOR_AGE=-1; SENSOR_FRESH=0; SENSOR_ENABLED=0; SENSOR_PID=0; SENSOR_WHY="not started"
SENSOR_STARTED=0; SENSOR_LAST_FRESH=0; SENSOR_GIVEUP_UNTIL=0; SENSOR_STARTS=(); SNAP_TS=0
SNAP_PID=""; LAST_CRIT_N=0; PREV_POLL_EPOCH=0
GPU_JOBS=0; ENV_RESERVED_MILLI=0; ENV_JOBS_OK=0
# The registry (SCHEMA §6 limits): JOBS_ST ok|unavailable, published like the sensor's
# jobs_st. ENV_LIMIT = the 1024-envelope limit; above it nothing is counted, and at most
# ENV_LIMIT envelopes per poll are read -- only to reap the dead (REAP_CURSOR: where the
# next over-limit batch starts).
JOBS_ST=ok; JOBS_WHY=""; ENV_LIMIT=1024; REAP_CURSOR=0
# RES_*_OK=0: the sensor said that quantity is unavailable (-1). It is then PUBLISHED as
# -1 and overcommit as null -- never as a measured-looking 0.0 (review 2026-10-08 SEM-6).
RES_FROM=envelopes; RES_RESERVED_MILLI=0; RES_BUDGET_MILLI=0; RES_OVERCOMMIT=0; RES_JOBS=0
RES_RESERVED_OK=1; RES_BUDGET_OK=1
VOL_MOUNT=(); VOL_AVAIL=(); VOL_ST=()
DISK_HW=UNKNOWN; SEQ=0; GUARD_STARTED=$EPOCHSECONDS; LAW7_REFUSED=""; BOOT_UUID=""
STATE=UNKNOWN; CAND=UNKNOWN; CONFIRM=0; CLASS=UNKNOWN; REASON="starting: awaiting sustained evidence"
NEW=UNKNOWN; NEED=1; OLD=UNKNOWN; TRANSITIONED=0; JMAX=2; WOKE=0; WAKE_STREAK=0; POLL_T0=$EPOCHREALTIME
PREV_PO=""; PREV_PO_T=""
# Hysteresis counts EVIDENCE, not loop iterations (review 2026-10-08 R5: six USR2
# wake-ups re-read one snapshot six times and RED de-escalated in 0.8 s). POLL_FRESH:
# this poll read new evidence (a new sensor seq, or >= POLL s since the previous poll
# in fallback). WAKE_POLL: it ran early because of a SIGUSR2. A library-mode caller
# that drives advance() itself gets the defaults: every call is a fresh, ordinary poll.
POLL_FRESH=1; WAKE_POLL=0; NEED_ESC=0; LAST_SEQ=""; LAST_SEQ_PID=""; LAST_POLL_T=0
# Daemon lifecycle: DAEMON_UP once this process governs the domain; STOP_PUBLISHED once
# it has published its own exit. GUARD_LSTART: this process's `ps -o lstart=` text in the
# C locale, as recorded in guardian.lock/started and published for consumers (FO-4).
# GUARD_PSTART: its start in EPOCH seconds, as recorded in guardian.lock/pstart and
# published as guardian_pstart (-1 when unknown) -- the time-zone-proof form of the same.
DAEMON_UP=0; STOP_PUBLISHED=0; GUARD_LSTART=""; GUARD_PSTART=-1
typeset -gA SV SJOB_ID SJOB_HB SJOB_FID EV IDCACHE ANCESTORS CANCEL_T0 STALLED UNVERIFIABLE_NOTED
SJOB_HAS_FILE=0; SJOBS_ST=ok
ANCESTORS_DONE=0; ENV_MTIME=0
SENSOR_ENV="$STATE_DIR/sensor.env"
OUT_F="$STATE_DIR/log/guardian.out"; PUB_ERRNO=0; STARTS_IN_WINDOW=0; HK_NEXT=0; PUB_REASON=""

# ---- the sensor binary ---------------------------------------------------------
# One lookup, shared with forge-gate / forge-job: $FORGE_GUARDIAN_SENSOR_BIN, else
# beside this script (the installed release), else the domain's bin/.
SENSOR_BIN=""
if [[ -n ${FORGE_GUARDIAN_SENSOR_BIN:-} ]]; then
  [[ -f $FORGE_GUARDIAN_SENSOR_BIN && -x $FORGE_GUARDIAN_SENSOR_BIN ]] && SENSOR_BIN=$FORGE_GUARDIAN_SENSOR_BIN
else
  for _c in "${GUARD_SELF:h}/forge-guardian-sensor" "$STATE_DIR/bin/forge-guardian-sensor"; do
    [[ -f $_c && -x $_c ]] && { SENSOR_BIN=$_c; break; }
  done
  unset _c
fi

# ---- atomic writes -------------------------------------------------------------
# SCHEMA §2: `<name>.tmp.<pid>` then rename(2). A failed or short write is never
# renamed: the previous good file stays (and goes stale, which consumers handle).
# The tmp name carries the pid because two writers once shared `status.json.tmp`
# and the live guardian.err filled with "mv: rename ... No such file or directory".
write_atomic() { # write_atomic PATH CONTENT -> 0, or 1 with PUB_ERRNO set
  local f=$1 tmp="$1.tmp.$$"
  # zf_mv has mv(1) semantics, not rename(2)'s: onto a directory (or a symlink to one) it
  # moves the tmp file INTO it and returns 0 -- a failed publication reported as success
  # (review 2026-10-08 R12: `mkdir status.json` -> status.json/status.json.tmp.<pid>
  # rewritten every poll, no PUBLISH FAILED). Refuse it as EISDIR.
  if [[ -d $f ]]; then PUB_ERRNO=21; return 1; fi
  if ! { print -r -- "$2" } 2>/dev/null >| "$tmp"; then
    zf_rm -f -- "$tmp" 2>/dev/null
    errno_of_write "$tmp" "$2"; PUB_ERRNO=$REPLY
    return 1
  fi
  if ! zf_mv -f -- "$tmp" "$f" 2>/dev/null; then
    PUB_ERRNO=-1; zf_rm -f -- "$tmp" 2>/dev/null; return 1
  fi
  return 0
}
# WHY did a write fail? zsh 5.9 here never sets $ERRNO -- and reading it under
# `set -u` KILLED the governor on its first failed publication (measured with the
# runtime gate's full-volume scenario). So, on the failure path only: repeat the
# write once in a subshell, capture zsh's own message ("no space left on device"),
# and map it back to a number with zsh/system's syserror. -1 when unknown.
errno_of_write() { # errno_of_write TMPPATH CONTENT -> REPLY
  local msg reason m i
  REPLY=-1
  # the OUTER group's 2>&1 is what captures it: zsh reports a failed redirection
  # on the stderr in force around the command whose redirection failed
  msg=$( { { print -r -- "$2" } >| "$1" } 2>&1 ); zf_rm -f -- "$1" 2>/dev/null
  msg=${msg%": $1"}; reason=${msg##*: }
  [[ -n $reason ]] || return 0
  zmodload zsh/system 2>/dev/null || return 0
  for i in {1..127}; do
    syserror -e m $i 2>/dev/null && [[ ${m:l} == ${reason:l} ]] && { REPLY=$i; return 0; }
  done
  return 0
}

# The Law-7 directory (default /tmp/archie_health) lives in a world-writable
# parent. Write into it only when it is a real directory, owned by us, and not a
# symlink -- otherwise another user could aim our writes anywhere. Refusing is
# logged once per reason; it is a deliberate refusal, not a publication failure.
law7_dir_ok() {
  local why=""
  local -A st
  if [[ -L $AH_DIR ]]; then why="is a symlink"
  else
    [[ -e $AH_DIR ]] || zf_mkdir -m 700 -- "$AH_DIR" 2>/dev/null
    if [[ ! -d $AH_DIR ]]; then why="is not a directory (and could not be created)"
    elif ! zstat -L -H st -- "$AH_DIR" 2>/dev/null; then why="cannot be inspected"
    elif (( st[uid] != UID )); then why="is owned by uid $st[uid], not $UID"
    fi
  fi
  if [[ -n $why ]]; then
    [[ $LAW7_REFUSED == "$why" ]] || { log "REFUSING to write the Law-7 signal: $AH_DIR $why"; LAW7_REFUSED=$why; }
    return 1
  fi
  LAW7_REFUSED=""
  return 0
}

# ---- publication (SCHEMA §4) ---------------------------------------------------
# P_* are the PUBLISHED observables: -1 for anything not `ok`. Shared by state.json,
# the Law-7 status.json and history.jsonl so the three can never disagree.
pub_values() {
  P_VMP=-1; P_FREE=-1; P_SWU=-1; P_SWT=-1; P_PO=-1; P_DISK=-1; P_THERM=-1; P_LOAD=-1
  [[ $O_ST_VMP == ok ]]      && P_VMP=$O_VMP
  [[ $O_ST_FREE == ok ]]     && P_FREE=$O_FREE
  [[ $O_ST_SWAP == ok ]]     && { P_SWU=$O_SWU; P_SWT=$O_SWT_RAW; }
  [[ $O_ST_PAGEOUTS == ok ]] && P_PO=$O_PORATE
  [[ $O_ST_DISK == ok ]]     && P_DISK=$O_DISK
  # cpu_speed_limit_pct is pmset's v1 CPU_Speed_Limit: published only when MEASURED.
  [[ $O_ST_THERMAL == ok && $O_THERM_SRC == pct ]] && P_THERM=$O_THERM
  is_udec "$O_LOAD"          && P_LOAD=$O_LOAD
  local r_ok=1 b_ok=1
  if [[ $RES_FROM == sensor ]]; then
    P_RES_MILLI=$RES_RESERVED_MILLI; P_BUDGET_MILLI=$RES_BUDGET_MILLI; P_OVERCOMMIT=$RES_OVERCOMMIT; P_RES_JOBS=$RES_JOBS
    r_ok=$RES_RESERVED_OK; b_ok=$RES_BUDGET_OK
  else
    to_milli "${POL[memory_os_reserve_gb]}"
    P_RES_MILLI=$ENV_RESERVED_MILLI
    P_BUDGET_MILLI=$(( RAM_BYTES * 1000 / 1073741824 - REPLY ))
    P_OVERCOMMIT=$(( P_RES_MILLI > P_BUDGET_MILLI ))
    P_RES_JOBS=$O_JOBS
  fi
  # an unavailable registry (SCHEMA §6) has no reservation total and no job count
  if [[ $JOBS_ST != ok ]]; then r_ok=0; P_RES_JOBS=-1; fi
  if (( r_ok )); then milli_1dp $P_RES_MILLI; P_RES_GB=$REPLY; else P_RES_GB=-1; fi
  if (( b_ok )); then milli_1dp $P_BUDGET_MILLI; P_BUDGET_GB=$REPLY; else P_BUDGET_GB=-1; fi
  # overcommit is a comparison of the two: unknown (JSON null) when either side is
  (( r_ok && b_ok )) || P_OVERCOMMIT=-1
}

publish() {
  local st="$1" reason="$2" jmax="$3"
  local now=$EPOCHSECONDS iso r fail="" ec=false heavy=false spawn=false crit=false oc=false
  utc_iso $now; iso=$REPLY
  (( SEQ++ ))
  pub_values
  (( EVIDENCE_COMPLETE )) && ec=true
  [[ $st == GREEN && $ec == true ]] && heavy=true
  [[ ( $st == GREEN || $st == YELLOW ) && $ec == true ]] && spawn=true
  (( CRITICAL_NOW )) && crit=true
  if (( P_OVERCOMMIT < 0 )); then oc=null; elif (( P_OVERCOMMIT )); then oc=true; fi
  json_esc "$reason"; r=$REPLY
  # Who published this: a consumer checks that this pid is alive with this start time
  # and forge-guardian argv before trusting a fresh-looking file (review FO-4: a governor
  # killed by HUP/KILL left GREEN, heavy_jobs_ok=true and a fresh epoch behind).
  local gls; json_esc "$GUARD_LSTART"; gls=$REPLY
  local miss="" s vols="" i adm
  for s in $MISSING; do miss+="${miss:+, }\"$s\""; done
  for (( i = 1; i <= ${#VOL_MOUNT}; i++ )); do
    json_esc "$VOL_MOUNT[i]"
    vols+="${vols:+, }{\"mount\": \"$REPLY\", \"avail_gb\": $VOL_AVAIL[i], \"floor_gb\": $ADM_FLOOR, \"status\": \"$VOL_ST[i]\"}"
  done
  if [[ $heavy == true ]]; then adm="GREEN with complete evidence"
  elif [[ $ec == false ]]; then adm="state $st; evidence incomplete: ${MISSING_DESC:-starting}"
  else adm="state $st"; fi
  json_esc "$adm"; adm=$REPLY
  local sage=$SENSOR_AGE
  local body="{
  \"schema\": \"forge.guardian.state/2\",
  \"state\": \"$st\",
  \"reason\": \"$r\",
  \"ts\": \"$iso\",
  \"epoch\": $now,
  \"seq\": $SEQ,
  \"build_jobs_max\": $jmax,
  \"spawn_agents_ok\": $spawn,
  \"evidence_complete\": $ec,
  \"heavy_jobs_ok\": $heavy,
  \"evidence\": {\"source\": \"$EV_SOURCE\", \"sensor_age_s\": $sage, \"missing\": [$miss]},
  \"critical_now\": $crit,
  \"thermal_state\": \"$O_THERM_STATE\",
  \"admission\": {\"heavy_open\": $heavy, \"reason\": \"$adm\"},
  \"reservations\": {\"reserved_gb\": $P_RES_GB, \"budget_gb\": $P_BUDGET_GB, \"overcommit\": $oc, \"jobs\": $P_RES_JOBS, \"status\": \"$JOBS_ST\"},
  \"jobs_st\": \"$JOBS_ST\",
  \"volumes\": [$vols],
  \"disk_hardware\": \"$DISK_HW\",
  \"guardian\": {\"pid\": $$, \"version\": \"$GUARDIAN_VERSION\", \"started\": $GUARD_STARTED},
  \"guardian_pid\": $$,
  \"guardian_started\": \"$gls\",
  \"guardian_pstart\": $GUARD_PSTART,
  \"observables\": {
    \"vm_pressure_level\": $P_VMP,
    \"free_pct\": $P_FREE,
    \"swap_used_mb\": $P_SWU,
    \"swap_total_mb\": $P_SWT,
    \"pageout_rate_pages_per_poll\": $P_PO,
    \"disk_avail_gb\": $P_DISK,
    \"loadavg\": \"$P_LOAD\",
    \"cpu_speed_limit_pct\": $P_THERM,
    \"registered_jobs\": $O_JOBS
  },
  \"host\": {\"ram_gb\": $RAM_GB, \"ncpu\": $NCPU, \"nperf\": $NPERF}
}"
  write_atomic "$STATE_F" "$st"   || fail+="${fail:+ }state(errno $PUB_ERRNO)"
  write_atomic "$STATE_J" "$body" || fail+="${fail:+ }state.json(errno $PUB_ERRNO)"

  # ---- Law-7 producer -------------------------------------------------------
  # /tmp/archie_health/status.json had SEVENTEEN consumers across archdisc-Models
  # and NO producer anywhere. Five of them read it inside a bare try/except and
  # returned {"state":"GREEN"} when the file was missing -- so the training fleet's
  # memory guard was not merely absent, it actively asserted GREEN. Guardian already
  # computes this exact state, so it is the natural producer.
  #
  # gpu_jobs counts REGISTERED jobs that declared --gpu. GPU work that never
  # registered an envelope is invisible here, and consumers must not read a 0 as
  # proof the GPU is idle.
  local halt=false swg=-1
  [[ -f "$AH_DIR/HALT" ]] && halt=true
  [[ $O_ST_SWAP == ok ]] && printf -v swg '%d.%02d' $(( O_SWU / 1024 )) $(( (O_SWU % 1024) * 100 / 1024 ))
  if law7_dir_ok; then
    write_atomic "$AH_F" "{
  \"state\": \"$st\",
  \"reason\": \"$r\",
  \"swap_gib\": $swg,
  \"halt\": $halt,
  \"gpu_jobs\": $GPU_JOBS,
  \"registered_jobs\": $O_JOBS,
  \"free_pct\": $P_FREE,
  \"pageout_rate\": $P_PO,
  \"disk_avail_gb\": $P_DISK,
  \"producer\": \"forge-guardian\",
  \"ts\": $now,
  \"iso\": \"$iso\",
  \"evidence_complete\": $ec,
  \"guardian_pid\": $$,
  \"guardian_started\": \"$gls\",
  \"guardian_pstart\": $GUARD_PSTART
}" || fail+="${fail:+ }${AH_F:t}(errno $PUB_ERRNO)"
  fi
  if [[ -n $fail ]]; then
    # A governor that cannot publish is invisible: consumers go stale and fail
    # closed, but nothing has been TOLD anything. SCHEMA §4.4 makes a failed
    # publication a CRITICAL_NOW condition on the next decision.
    PUBLISH_FAILED=1; PUB_FAIL=$fail
    log "PUBLISH FAILED: $fail -- previous files left in place; CRITICAL_NOW on the next decision"
    local f1=${fail%% *}; json_esc "${f1%%\(*}"
    event publish_error "\"file\": \"$REPLY\", \"errno\": ${PUB_ERRNO:-0}"
  fi
  [[ -z $fail ]]
}

history_append() { # SCHEMA §4.3: one compact line per poll
  local r rs
  json_esc "$REASON"; r=$REPLY
  append_rec "$STATE_DIR/history.jsonl" "{\"t\":$EPOCHSECONDS,\"s\":\"$STATE\",\"r\":\"$r\",\"vmp\":$P_VMP,\"pe\":\"$O_PEVENT\",\"fp\":$P_FREE,\"sw\":[$P_SWU,$P_SWT],\"po\":$P_PO,\"th\":\"$O_THERM_STATE\",\"dk\":$P_DISK,\"rs\":[$P_RES_GB,$P_BUDGET_GB],\"j\":$O_JOBS,\"ev\":$EVIDENCE_COMPLETE}"
  return 0
}

# ---- registered-job helpers ---------------------------------------------------
# A job file is KEY=VALUE lines (SCHEMA §5): pid, name, priority(0=critical..
# 9=speculative), can_restart(0/1), peak_gb, gpu, started, [v2 keys], cmd LAST.
# Readers take the FIRST occurrence of a key. Builtin reads: no sed per field.
job_field() { read_envelope "$1" && print -r -- "${EV[$2]:-}"; return 0 }
# read_envelope FILE -> EV[key]=value, ENV_MTIME, ENV_OVERSIZE; 1 when FILE is not a
# regular file or cannot be opened.
#   * Opened O_RDONLY|O_NONBLOCK|O_NOFOLLOW and fstat'ed before a single byte is read:
#     a FIFO, directory, device or symlink named *.job is never read and never blocks
#     (review 2026-10-08 R1: a FIFO wedged the governor in open(2) indefinitely).
#   * At most the first 64 KiB is read. A larger envelope is NOT unreadable: ENV_OVERSIZE=1
#     and the caller treats it as `unverifiable` -- kept, its declared reservation counted
#     while its pid lives, never signalled (SCHEMA §6 registry limits; review R7: the
#     envelope of a live, verified 20 GiB job was deleted for holding a long cmd=).
ENV_MAX=65536; ENV_OVERSIZE=0; ENV_MTIME=0; RL_BUF=""; RL_MTIME=0; RL_BIG=0
typeset -ga RL_LINES
# safe_read FILE [MAX] -> RL_BUF (at most MAX bytes, default 64 KiB), RL_MTIME, RL_BIG
# (1 when the file is larger than MAX); 1 when FILE is not a regular file or cannot be
# opened. Never blocks, never follows a symlink.
safe_read() {
  local f=$1 fd chunk
  local -i max=${2:-$ENV_MAX} got=0 c=0
  local -A st
  RL_BUF=""; RL_MTIME=0; RL_BIG=0
  sysopen -r -o nonblock,nofollow -u fd "$f" 2>/dev/null || return 1
  if ! zstat -H st -f $fd 2>/dev/null || (( (st[mode] & 8#170000) != 8#100000 )); then
    exec {fd}<&- 2>/dev/null; return 1
  fi
  RL_MTIME=$st[mtime]
  (( st[size] > max )) && RL_BIG=1
  while (( got < max )); do
    chunk=""; c=0
    sysread -c c -s $(( max - got )) -i $fd chunk 2>/dev/null || break   # 5 = end of file
    (( c > 0 )) || break
    RL_BUF+=$chunk; (( got += c ))
  done
  exec {fd}<&- 2>/dev/null
  # a cut at MAX leaves a partial last line: it is not a value
  (( RL_BIG )) && [[ $RL_BUF == *$'\n'* && $RL_BUF != *$'\n' ]] && RL_BUF=${RL_BUF%$'\n'*}
  return 0
}
read_envelope_lines() { safe_read "$@" || { RL_LINES=(); return 1; }; RL_LINES=("${(@f)RL_BUF}"); return 0 }
read_envelope() {
  local f=$1 line k
  local -i n=0
  EV=(); ENV_OVERSIZE=0; ENV_MTIME=0
  safe_read "$f" || return 1
  ENV_MTIME=$RL_MTIME; ENV_OVERSIZE=$RL_BIG
  for line in "${(@f)RL_BUF}"; do
    (( ++n > 512 )) && break
    [[ $line == [a-z]*=* ]] || continue
    k=${line%%=*}
    (( ${+EV[$k]} )) || EV[$k]=${line#*=}
    [[ $k == cmd ]] && break
  done
  return 0
}
job_prio() { read_envelope "$1"; REPLY=${EV[priority]:-5}; is_uint "$REPLY" && (( REPLY <= 9 )) || REPLY=5 }

# Envelope paths sorted by priority DESC (most speculative first) -- shed order.
# Pure zsh: v1 piped through sort|awk, and awk's $2 cut every path at its first
# space, so a domain under a path with a space in it could never shed anything.
# `(N.)`: regular files only -- never a FIFO, directory or symlink (review R1).
# Over the registry limit (SCHEMA §6) only the first 1024 envelopes by name are read: the
# shed order is then partial, and says so in the log, rather than a poll that reads every
# file of a flooded jobs/ (each one is still identity-checked before any signal).
shed_list() {
  local f r; local -a rows envs
  SHED_LIST=()
  envs=("$JOBS_DIR"/*.job(N.))
  if (( ${#envs} > ENV_LIMIT )); then
    log "shed list: ${#envs} envelopes exceed the registry limit $ENV_LIMIT -- only the first $ENV_LIMIT by name are considered"
    envs=(${envs[1,ENV_LIMIT]})
  fi
  for f in $envs; do job_prio "$f"; rows+=("$REPLY $f"); done
  for r in ${(On)rows}; do SHED_LIST+=("${r#* }"); done
}
shed_order() { shed_list; (( ${#SHED_LIST} )) && print -rl -- $SHED_LIST; return 0 }

# ---- process identity (SCHEMA §5) ----------------------------------------------
# An envelope names a PROCESS, not a number: pids are reused. proc_info asks the
# sensor's `pidinfo` (proc_pidinfo, exact start second) when the binary exists,
# else `ps -o lstart=`. Called only on the actuation path, the reaper's fallback
# path, and once per new envelope (cached) -- never per poll in the steady state.
# NEVER `strftime -r -s REPLY`: when REPLY does not exist yet, strftime CREATES it as
# an INTEGER, and the next `REPLY=speculative` is then evaluated arithmetically --
# fatal under `set -u`. resilience_harness.mjs D5 died exactly so (json_esc:3:
# speculative: parameter not set), mid-shed, leaving its victims orphaned.
parse_lstart() { local LC_ALL=C v=""; strftime -r -s v '%a %b %d %H:%M:%S %Y' "$1" 2>/dev/null || return 1; REPLY=$v }
# pid_pstart PID -> REPLY = the process's start in EPOCH seconds; 1 when it is not
# running or its start cannot be read. Exact from the sensor's pidinfo (proc_pidinfo);
# else ps's lstart read back in the zone it was printed in (UTC for both, so no local
# zone or DST hour is involved). A NUMBER means the same to every reader: the lstart
# TEXT that guardian.lock/started holds is local time, so a reader in another time zone
# called a live governor "a reused pid" and every admission failed closed (review
# 2026-10-08 round 2, FO-4 regression). guardian.lock/pstart carries this value.
pid_pstart() {
  local out kv
  REPLY=""
  is_pid "$1" || return 1
  if [[ -n ${SENSOR_BIN:-} ]]; then
    out=$("$SENSOR_BIN" pidinfo "$1" 2>/dev/null)
    if [[ $out == *identity=alive* ]]; then
      for kv in ${=out}; do [[ $kv == pstart=<-> ]] && { REPLY=${kv#pstart=}; break; }; done
      is_uint "$REPLY" && (( REPLY > 0 )) && return 0
      REPLY=""
    fi
    [[ $out == *identity=dead* ]] && return 1
  fi
  out=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null)
  out=${(j: :)${=out}}
  [[ -n $out ]] || return 1
  local TZ=UTC
  parse_lstart "$out" && is_uint "$REPLY" && (( REPLY > 0 ))
}
# PI_COMM is the DECODED process name. pidinfo prints comm= percent-encoded (env_word:
# a space is %20, an empty name is `none`) and also prints protected=0|1 from SCHEMA §5's
# list. Review 2026-10-08 ACT-1: the governor matched `Claude Helper*` against the
# encoded `Claude%20Helper`, so with the sensor installed every Claude helper could be
# signalled. Now the name is decoded before matching AND protected=1 is honoured
# (PI_PROT): either one protects. pidinfo is asked WITH this domain (--state-dir), so its
# protected=1 also covers the guardian.lock holder, the governor's ancestors and the
# sensor.lock holder (SCHEMA §5) -- not only the names. A sensor too old for --state-dir
# answers with a usage error and the ps path below takes over.
proc_info() { # proc_info PID -> PI_ALIVE PI_PPID PI_PSTART PI_UID PI_COMM PI_PROT; 0 when alive
  local pid=$1 out kv c
  local -a w
  PI_ALIVE=0; PI_PPID=""; PI_PSTART=""; PI_UID=""; PI_COMM=""; PI_PROT=0
  is_pid "$pid" || return 1
  if [[ -n $SENSOR_BIN ]]; then
    out=$("$SENSOR_BIN" pidinfo --state-dir "$STATE_DIR" "$pid" 2>/dev/null)
    if [[ $out == *identity=alive* ]]; then
      for kv in ${=out}; do
        case $kv in
          ppid=*) PI_PPID=${kv#*=} ;; pstart=*) PI_PSTART=${kv#*=} ;; uid=*) PI_UID=${kv#*=} ;;
          protected=0) ;;
          protected=*) PI_PROT=1 ;;            # 1, or anything that is not a clear 0
        esac
      done
      c=""
      if [[ $out == comm=* || $out == *' comm='* ]]; then
        c=${out#*comm=}; c=${c%% identity=*}; c=${c%% protected=*}
      fi
      if [[ -z $c || $c == none ]]; then PI_COMM=""      # unknown name: protected
      else pct_decode "$c"; PI_COMM=$REPLY; fi
      is_uint "$PI_PSTART" || PI_PSTART=""
      PI_ALIVE=1; return 0
    fi
    [[ $out == *identity=dead* ]] && return 1
  fi
  out=$(LC_ALL=C ps -o ppid=,uid=,lstart=,comm= -p "$pid" 2>/dev/null)
  w=(${=out})
  (( ${#w} >= 8 )) || return 1
  PI_PPID=$w[1]; PI_UID=$w[2]
  parse_lstart "$w[3] $w[4] $w[5] $w[6] $w[7]" && is_uint "$REPLY" && PI_PSTART=$REPLY
  PI_COMM=${(j: :)w[8,-1]}
  PI_ALIVE=1
  return 0
}
boot_uuid() {
  [[ -n $BOOT_UUID ]] || BOOT_UUID=$(sysctl -n kern.bootsessionuuid 2>/dev/null)
  REPLY=$BOOT_UUID
}
# identity_verdict: uses EV (the envelope) and PI_* (the process) -> ID_VERDICT
# ok|dead|mismatch|unverifiable and ID_WHY, in exactly SCHEMA §5's order.
identity_verdict() {
  ID_VERDICT=unverifiable; ID_WHY=""
  (( PI_ALIVE )) || { ID_VERDICT=dead; ID_WHY="pid not running"; return 0; }
  local b=${EV[boot]:-} ps_=${EV[pstart]:-} stt=${EV[started]:-}
  if [[ -n $b ]]; then
    boot_uuid
    if [[ -n $REPLY && $b != "$REPLY" ]]; then ID_VERDICT=mismatch; ID_WHY="registered in boot $b, this is boot $REPLY"; return 0; fi
  fi
  is_uint "$PI_PSTART" || { ID_WHY="process start time unavailable"; return 0; }
  if is_uint "$ps_"; then
    if (( PI_PSTART - ps_ <= 1 && ps_ - PI_PSTART <= 1 )); then ID_VERDICT=ok
    else ID_VERDICT=mismatch; ID_WHY="pstart=$ps_ but the process started at $PI_PSTART (pid reused)"; fi
  elif is_uint "$stt"; then
    if (( PI_PSTART <= stt + 5 )); then ID_VERDICT=ok
    else ID_VERDICT=mismatch; ID_WHY="the process started at $PI_PSTART, after the envelope was written (started=$stt): pid reused"; fi
  else
    ID_WHY="envelope has neither pstart nor started"
  fi
  return 0
}
guardian_ancestors() { # walk our own ppid chain ONCE: never signal what runs us
  (( ANCESTORS_DONE )) && return 0
  ANCESTORS_DONE=1
  local p=$PPID out
  local -i d=0
  while is_uint "$p" && (( p > 1 && d++ < 64 )); do
    ANCESTORS[$p]=1
    out=$(ps -o ppid= -p "$p" 2>/dev/null); p=${out//[[:space:]]/}
  done
  return 0
}
# SCHEMA §5's ONE list, matched against the DECODED name (its basename: the ps fallback
# prints a path). `forge-guardian-s` is the sensor's 16-character p_comm truncation.
is_protected_comm() {
  local c=${1:t}
  case $c in
    claude|node|Claude|Claude\ Helper*|WindowServer|loginwindow|Finder|Dock|SystemUIServer|kernel_task|launchd|sshd) return 0 ;;
    forge-guardian|forge-guardian-sensor|forge-guardian-s) return 0 ;;
  esac
  [[ "$c" =~ $PROTECTED_RE ]] && return 0
  return 1
}
is_protected_pid() { # is_protected_pid PID COMM [PROT] -- PROT=1: pidinfo said protected=1
  local pid=$1 comm=$2
  is_pid "$pid" || return 0                       # not a canonical pid: never signalled
  (( pid <= 1 || pid == $$ )) && return 0
  (( ${3:-0} )) && return 0
  (( SENSOR_PID > 0 && pid == SENSOR_PID )) && return 0
  guardian_ancestors
  (( ${+ANCESTORS[$pid]} )) && return 0
  [[ -z $comm ]] && return 0                      # unknown -> treat as protected
  is_protected_comm "$comm"
}
is_protected() { # v1 name: is_protected PID -> 0 when the pid must never be signalled
  local pid="$1"
  is_pid "$pid" || return 0
  proc_info "$pid" || return 0
  is_protected_pid "$pid" "$PI_COMM" "$PI_PROT"
}

reap_one() { # reap_one FILE PID WHY
  local f=$1 pid=$2 why=$3
  zf_rm -f -- "$f" 2>/dev/null
  unset "IDCACHE[$f]"
  log "reaped envelope ${f:t} pid=$pid: $why"
  json_esc "$why"
  is_uint "$pid" || pid=-1
  event reap "\"pid\": $pid, \"why\": \"$REPLY\""
}

# envelope_identity FILE PID (EV loaded) -> ID_VERDICT [ok|dead|mismatch|unverifiable|deferred]
# With a fresh sensor the verdict is the sensor's (it recomputes identity every
# tick): no fork. An envelope newer than the snapshot is DEFERRED to the next one
# -- acting on an older snapshot could delete a brand-new envelope that merely
# reused the file name. Without a sensor: one proc_info per envelope, cached.
#
# The envelope's OWN pid is checked to be canonical BEFORE any sensor verdict is taken
# (SCHEMA §5; review 2026-10-08 ACT-3): a sensor that read `pid=0123` as 123 published
# "ok" for 123, and a pid-keyed lookup handed that verdict to the padded envelope. The
# verdict is then taken for THIS FILE (sensor.env job<j>_file) and only when the sensor
# read the same pid from it: two envelopes can name one pid (a reused pid's stale file
# beside the live job's), and a verdict keyed by pid alone either reaped the live job's
# envelope or kept the stale one. A sensor that publishes no job<j>_file (older) is
# looked up by pid, as before.
envelope_identity() {
  local f=$1 pid=$2 key c v
  local -a w
  ID_VERDICT=unverifiable; ID_WHY=""
  if ! is_pid "$pid"; then ID_VERDICT=invalid; ID_WHY="not a canonical pid"; return 0; fi
  if (( SENSOR_FRESH )); then
    ID_VERDICT=deferred
    (( ENV_MTIME < SNAP_TS )) || return 0
    if (( SJOB_HAS_FILE )); then
      v=${SJOB_FID[${f:t}]:-}
      [[ $v == "$pid "* ]] || return 0          # not in the snapshot, or it named another pid then
      ID_VERDICT=${v#* }; ID_WHY="sensor verdict"
    elif (( ${+SJOB_ID[$pid]} )); then
      ID_VERDICT=${SJOB_ID[$pid]}; ID_WHY="sensor verdict"
    else
      return 0
    fi
    [[ $ID_VERDICT == (ok|dead|mismatch|unverifiable) ]] || ID_VERDICT=unverifiable
    return 0
  fi
  key="$ENV_MTIME:$pid"
  c=${IDCACHE[$f]:-}
  if [[ $c == "$key "* ]]; then
    w=(${=c})
    if (( EPOCHSECONDS - w[3] < 60 )); then ID_VERDICT=$w[2]; ID_WHY="cached"; return 0; fi
  fi
  proc_info "$pid"
  identity_verdict
  IDCACHE[$f]="$key $ID_VERDICT $EPOCHSECONDS"
  return 0
}

# reap_batch -- the reaper ABOVE the registry limit (uses the caller's `envs`, the
# over-limit listing sorted by name). THE BUG THIS CLOSES (review 2026-10-08 round 2,
# verify 4c): with the walk skipped entirely above 1024 envelopes, 1100 envelopes of DEAD
# pids (crashed jobs, a runaway harness) stayed for ever -- jobs_st stayed unavailable and
# every `admit` exited 75 until a human deleted them, where c249d838 (which walked
# everything) had reaped them in one poll. Now each over-limit poll reads at most
# ENV_LIMIT envelopes -- no more work than a full legal registry -- starting where the
# previous batch stopped (REAP_CURSOR, wrapping round, so live envelopes that sort first
# cannot hide dead ones behind them for ever), and acts only on the verdicts that need no
# identity check: unreadable, no canonical pid (after the same 10 s grace), pid not
# running. A running pid's envelope is kept and never signalled from here: nothing is
# counted and no identity verdict is computed or trusted while the registry is
# unavailable. Once the count is back within the limit the normal walk resumes and
# jobs_st returns to ok on its own.
reap_batch() {
  local f pid now=$EPOCHSECONDS
  local -i n=${#envs} i k reaped=0 seen=0
  local -A hst
  (( REAP_CURSOR >= 0 && REAP_CURSOR < n )) || REAP_CURSOR=0
  for (( i = 0; i < ENV_LIMIT && i < n; i++ )); do
    k=$(( (REAP_CURSOR + i) % n + 1 ))
    f=${envs[k]}
    (( ++seen ))
    if ! read_envelope "$f"; then
      if zstat -L -H hst -- "$f" 2>/dev/null && (( (hst[mode] & 8#170000) == 8#100000 )); then
        reap_one "$f" "" "unreadable"; (( ++reaped ))
      fi
      continue
    fi
    pid=${EV[pid]:-}
    if ! is_pid "$pid" || (( pid <= 1 )); then
      if (( now - ENV_MTIME > 10 )); then reap_one "$f" "$pid" "no valid pid"; (( ++reaped )); fi
      continue
    fi
    if ! kill -0 "$pid" 2>/dev/null; then reap_one "$f" "$pid" "dead"; (( ++reaped )); fi
  done
  # the next batch starts right after this one (the files reaped here no longer hold an index)
  if (( n - reaped > 0 )); then REAP_CURSOR=$(( (REAP_CURSOR + seen - reaped) % (n - reaped) ))
  else REAP_CURSOR=0; fi
  (( reaped )) && log "registry over the limit: reaped $reaped of the $seen envelopes read this poll ($n present, limit $ENV_LIMIT)"
  return 0
}

# The reaper, and the ONE pass that counts the registry. registered_jobs, gpu_jobs
# and the envelope reservations are all taken here, after reaping, so two fields
# describing one set are always computed on the same side of the thing that
# changes it (v1 once published registered_jobs=1 beside gpu_jobs=0 for one set).
#
# REGISTRY LIMITS (SCHEMA §6; review 2026-10-08 R4, governor half): at most 1024
# envelopes. Above that -- or when the sensor's snapshot says it could not read the
# registry completely -- the registry is UNAVAILABLE: JOBS_ST=unavailable is published
# (state.json jobs_st and reservations.status, like the sensor's), registered_jobs /
# gpu_jobs / reserved_gb are -1 and overcommit null, never a silently shorter count.
# Over the limit the registry is NOT walked: a hostile 100k-file jobs/ used to be read
# envelope by envelope on every poll. It is still REAPED, in a bounded batch (reap_batch).
reap_dead_jobs() {
  local f pid now=$EPOCHSECONDS hb ss age was=$JOBS_ST
  local -a envs
  local -A seen hst
  O_JOBS=0; GPU_JOBS=0; ENV_RESERVED_MILLI=0; ENV_JOBS_OK=0
  # `(N.)`: regular files only. A FIFO, directory or symlink named *.job is never opened
  # (it could block, or point anywhere) and never deleted (SCHEMA §6 registry limits).
  envs=("$JOBS_DIR"/*.job(N.))
  JOBS_ST=ok; JOBS_WHY=""
  if (( ${#envs} > ENV_LIMIT )); then
    JOBS_ST=unavailable; JOBS_WHY="${#envs} envelopes, more than $ENV_LIMIT"
  elif (( SENSOR_FRESH )) && [[ $SJOBS_ST != ok ]]; then
    JOBS_ST=unavailable; JOBS_WHY="the sensor could not read the registry completely"
  fi
  if [[ $JOBS_ST != "$was" ]]; then
    if [[ $JOBS_ST == ok ]]; then log "registry readable again (jobs_st ok)"
    else log "REGISTRY UNAVAILABLE (jobs_st unavailable): $JOBS_WHY -- registered_jobs and reservations published as -1"; fi
  fi
  if (( ${#envs} > ENV_LIMIT )); then
    reap_batch
    O_JOBS=-1; GPU_JOBS=-1; ENV_RESERVED_MILLI=0; ENV_JOBS_OK=0
    return 0
  fi
  REAP_CURSOR=0
  for f in $envs; do
    if ! read_envelope "$f"; then
      # gone, replaced by a non-regular file since the glob, or cannot be opened
      zstat -L -H hst -- "$f" 2>/dev/null && (( (hst[mode] & 8#170000) == 8#100000 )) \
        && reap_one "$f" "" "unreadable"
      continue
    fi
    pid=${EV[pid]:-}
    if ! is_pid "$pid" || (( pid <= 1 )); then
      # Not a canonical pid (SCHEMA §5): invalid, never signalled, reaped. A legacy
      # writer creates the file before filling it: give it 10 s.
      if (( now - ENV_MTIME > 10 )); then reap_one "$f" "$pid" "no valid pid"; continue; fi
      (( O_JOBS++ )); continue
    fi
    if ! kill -0 "$pid" 2>/dev/null; then reap_one "$f" "$pid" "dead"; continue; fi
    if (( ENV_OVERSIZE )); then
      ID_VERDICT=unverifiable; ID_WHY="envelope larger than 64 KiB"
    else
      envelope_identity "$f" "$pid"
    fi
    case $ID_VERDICT in
      dead|mismatch) reap_one "$f" "$pid" "$ID_VERDICT${ID_WHY:+: $ID_WHY}"; continue ;;
      ok) (( ENV_JOBS_OK++ )) ;;
      unverifiable)
        if (( ! ${+UNVERIFIABLE_NOTED[$f]} )); then
          UNVERIFIABLE_NOTED[$f]=1
          log "envelope ${f:t} pid=$pid is UNVERIFIABLE (${ID_WHY}): kept, never signalled"
        fi ;;
    esac
    seen[$f]=1
    (( O_JOBS++ ))
    [[ ${EV[gpu]:-} == 1 ]] && (( GPU_JOBS++ ))
    if is_udec "${EV[peak_gb]:-}"; then to_milli "${EV[peak_gb]}"; (( ENV_RESERVED_MILLI += REPLY )); fi
    # stall: a declared heartbeat older than its declared stall_s
    hb=${EV[heartbeat]:-}; ss=${EV[stall_s]:-}
    if [[ -n $hb ]] && is_uint "$ss"; then
      age=-1
      if (( SENSOR_FRESH )) && is_int "${SJOB_HB[$pid]:-x}"; then age=${SJOB_HB[$pid]}
      elif zstat -H hst -- "$hb" 2>/dev/null; then age=$(( now - hst[mtime] )); fi
      if (( age > ss )); then
        if (( ! ${+STALLED[$pid]} )); then
          STALLED[$pid]=1
          json_esc "${EV[name]:-}"
          event stall "\"pid\": $pid, \"name\": \"$REPLY\", \"age_s\": $age"
          log "STALL: job '${EV[name]:-}' pid=$pid heartbeat ${age}s old > stall_s=$ss"
        fi
      elif (( age >= 0 )); then
        unset "STALLED[$pid]"
      fi
    fi
  done
  # forget cache entries for envelopes that are gone
  for f in ${(k)IDCACHE}; do (( ${+seen[$f]} )) || unset "IDCACHE[$f]"; done
  for f in ${(k)UNVERIFIABLE_NOTED}; do (( ${+seen[$f]} )) || unset "UNVERIFIABLE_NOTED[$f]"; done
  # an unreadable registry has no count: -1, never the part that happened to be read
  if [[ $JOBS_ST != ok ]]; then O_JOBS=-1; GPU_JOBS=-1; ENV_RESERVED_MILLI=0; ENV_JOBS_OK=0; fi
  return 0
}

# Cooperative shed: SIGUSR1 means "checkpoint now and reduce your footprint".
# IDENTITY BEFORE EVERY SIGNAL (SCHEMA §5): the pid must be alive, ours, not
# protected, and provably the process that registered -- a reused pid is a
# stranger that inherited a number.
signal_job() {
  local f="$1" sig="$2" pid name
  read_envelope "$f" || return 1
  pid=${EV[pid]:-}; name=${EV[name]:-}
  [[ -z "$pid" ]] && return 1
  if [[ $pid == <-> ]] && (( ${#pid} <= 18 && pid <= 1 )); then
    log "REFUSED to signal protected pid=$pid name=$name (sig=$sig): not a user pid"
    return 1
  fi
  if ! is_pid "$pid"; then
    # `kill 034023` signals 34023, but the protection checks keyed the STRING (ACT-3)
    log "REFUSED to signal pid=$pid name=$name (sig=$sig): not a canonical pid (SCHEMA §5)"
    return 1
  fi
  if (( ENV_OVERSIZE )); then
    log "REFUSED to signal pid=$pid name=$name (sig=$sig): identity unverifiable -- envelope larger than 64 KiB"
    return 1
  fi
  if ! proc_info "$pid"; then
    log "not signalling pid=$pid name=$name (sig=$sig): not running"
    return 1
  fi
  if is_protected_pid "$pid" "$PI_COMM" "$PI_PROT"; then
    log "REFUSED to signal protected pid=$pid name=$name comm='$PI_COMM' (sig=$sig)"
    return 1
  fi
  if [[ $PI_UID != "$UID" ]]; then
    log "REFUSED to signal pid=$pid name=$name (sig=$sig): owned by uid ${PI_UID:-?}, not $UID"
    return 1
  fi
  identity_verdict
  case $ID_VERDICT in
    ok) ;;
    dead|mismatch)
      log "REFUSED to signal pid=$pid name=$name (sig=$sig): identity $ID_VERDICT -- $ID_WHY"
      reap_one "$f" "$pid" "$ID_VERDICT: $ID_WHY"
      return 1 ;;
    *)
      log "REFUSED to signal pid=$pid name=$name (sig=$sig): identity unverifiable -- $ID_WHY"
      return 1 ;;
  esac
  kill -"$sig" "$pid" 2>/dev/null || return 1
  emit "🛡  GUARDIAN shed sig=$sig -> job='$name' pid=$pid"
  local js=null; [[ -n ${EV[sig]:-} ]] && { json_esc "${EV[sig]}"; js="\"$REPLY\""; }
  json_esc "$name"
  event shed "\"sig\": $js, \"signal\": \"$sig\", \"pid\": $pid, \"name\": \"$REPLY\""
  [[ $sig == TERM ]] && CANCEL_T0[$pid]=$EPOCHREALTIME
  return 0
}

# Cancel latency (SCHEMA §7): TERM sent -> pid gone, measured at poll resolution.
cancel_latency_check() {
  setopt localoptions extendedglob
  local pid t s
  for pid in ${(k)CANCEL_T0}; do
    t=${CANCEL_T0[$pid]}
    if ! kill -0 "$pid" 2>/dev/null; then
      s=$(( EPOCHREALTIME - t ))
      [[ $s == (#b)(<->).(<->)* ]] && s="$match[1].${match[2][1,3]}"
      event cancel_latency "\"pid\": $pid, \"s\": $s"
      log "cancel latency: pid=$pid gone ${s}s after TERM"
      unset "CANCEL_T0[$pid]"
    elif (( EPOCHREALTIME - t > 3600 )); then
      unset "CANCEL_T0[$pid]"
    fi
  done
}

# ---- observation: the sensor ---------------------------------------------------
read_sensor_env() { # builtin loop: parsing sensor.env forks nothing
  local line
  local -i n=0
  SV=()
  [[ -f $SENSOR_ENV && -r $SENSOR_ENV ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    (( ++n > 20000 )) && break
    [[ $line == [a-z]*=* ]] || continue
    SV[${line%%=*}]=${line#*=}
  done 2>/dev/null < "$SENSOR_ENV"
  (( ${#SV} > 0 ))
}
# Fresh = right schema, ts within sensor_stale_polls x POLL of now and not more
# than 5 s in the future (SCHEMA §3.3), and the writer still alive.
sensor_fresh_check() {
  local now=$1 ts=${SV[ts_s]:-} pid=${SV[pid]:-} age lim
  if [[ ${SV[schema]:-} != forge.guardian.sensor/1 ]]; then SENSOR_WHY="schema '${SV[schema]:-none}'"; SENSOR_AGE=-1; return 1; fi
  if ! is_uint "$ts"; then SENSOR_WHY="unparseable ts"; SENSOR_AGE=-1; return 1; fi
  age=$(( now - ts )); lim=$(( STALE_POLLS * POLL ))
  SENSOR_AGE=$age
  if (( age > lim )); then SENSOR_WHY="stale ${age}s > ${lim}s"; return 1; fi
  if (( age < -5 )); then SENSOR_WHY="clock skew: snapshot $(( -age ))s in the future"; return 1; fi
  if ! is_uint "$pid" || ! kill -0 "$pid" 2>/dev/null; then SENSOR_WHY="sensor pid ${pid:-?} not running"; return 1; fi
  (( age < 0 )) && SENSOR_AGE=0
  SENSOR_FRESH=1; SENSOR_WHY=fresh
  return 0
}
# Map one snapshot onto O_*. Every number is validated with a pattern BEFORE any
# arithmetic: a malformed value makes THAT signal `invalid`, never a crash and
# never a number.
map_sensor() {
  local v st u t i j n pid crit pts
  st_norm "${SV[vmp_st]:-unavailable}"; st=$REPLY; v=${SV[vmp]:-}
  if [[ $st == ok ]]; then [[ $v == (1|2|4) ]] && O_VMP=$v || st=invalid; fi
  O_ST_VMP=$st; [[ $st == ok ]] || O_VMP=1

  st_norm "${SV[freepct_st]:-unavailable}"; st=$REPLY; v=${SV[freepct]:-}
  if [[ $st == ok ]]; then if is_uint "$v" && (( v <= 100 )); then O_FREE=$v; else st=invalid; fi; fi
  O_ST_FREE=$st; [[ $st == ok ]] || O_FREE=100

  st_norm "${SV[swap_st]:-unavailable}"; st=$REPLY; u=${SV[swap_used_mb]:-}; t=${SV[swap_total_mb]:-}
  if [[ $st == ok ]]; then
    if is_uint "$u" && is_uint "$t" && (( u <= t )); then O_SWU=$u; O_SWT_RAW=$t; O_SWT=$(( t > 0 ? t : 1 ))
    else st=invalid; fi
  fi
  O_ST_SWAP=$st; [[ $st == ok ]] || { O_SWU=0; O_SWT=1; O_SWT_RAW=0; }

  st_norm "${SV[pageouts_st]:-unavailable}"; st=$REPLY; v=${SV[pageout_rate_ps]:-}
  if [[ $st == ok ]]; then
    if is_udec "$v"; then local -i r; (( r = v * 5 )); O_PORATE=$r; else st=invalid; fi   # pages per 5 s, whatever POLL is
  fi
  O_ST_PAGEOUTS=$st; [[ $st == ok ]] || O_PORATE=0

  st_norm "${SV[disk_st]:-unavailable}"; st=$REPLY; v=${SV[disk_min_avail_gib]:-}
  if [[ $st == ok ]]; then is_uint "$v" && O_DISK=$v || st=invalid; fi
  O_ST_DISK=$st; [[ $st == ok ]] || O_DISK=999
  VOL_MOUNT=(); VOL_AVAIL=(); VOL_ST=()
  n=${SV[vol_n]:-0}; is_uint "$n" && (( n <= 64 )) || n=0
  for (( i = 0; i < n; i++ )); do
    pct_decode "${SV[vol${i}_mount]:-${SV[vol${i}_path]:-?}}"   # sensor.env words are %XX-encoded (R11)
    VOL_MOUNT+=("$REPLY")
    st_norm "${SV[vol${i}_st]:-unavailable}"; st=$REPLY; v=${SV[vol${i}_avail_b]:-}
    if [[ $st == ok ]] && is_uint "$v"; then VOL_AVAIL+=($(( v / 1073741824 ))); VOL_ST+=(ok)
    else VOL_AVAIL+=(-1); [[ $st == ok ]] && VOL_ST+=(invalid) || VOL_ST+=($st); fi
  done

  st_norm "${SV[thermal_st]:-unavailable}"; st=$REPLY; v=${SV[thermal]:-none}
  if [[ $st == ok ]]; then
    if thermal_pct "$v"; then O_THERM=$REPLY; O_THERM_STATE=$v; else st=invalid; fi
  fi
  O_THERM_SRC=word        # the ladder value is internal to classify(); never published
  O_ST_THERMAL=$st; [[ $st == ok ]] || { O_THERM=100; O_THERM_STATE=none; }

  st_norm "${SV[pevent_st]:-unavailable}"; O_ST_PEVENT=$REPLY
  O_PEVENT=${SV[pevent]:-none}; [[ $O_PEVENT == (normal|warn|critical|none) ]] || O_PEVENT=none
  # A critical pressure event SINCE THE PREVIOUS POLL: pevent_crit_n counts since
  # this sensor process started, so compare against the last snapshot of the SAME
  # sensor pid; a new sensor's count only matters for events since our last poll.
  crit=${SV[pevent_crit_n]:-0}; is_uint "$crit" || crit=0
  pts=${SV[pevent_ts]:-}; is_uint "$pts" || pts=0
  PEVENT_CRIT_NEW=0
  if [[ ${SV[pid]:-} == "$SNAP_PID" ]]; then
    (( crit > LAST_CRIT_N )) && PEVENT_CRIT_NEW=1
  else
    (( crit > 0 && pts >= PREV_POLL_EPOCH - POLL && PREV_POLL_EPOCH > 0 )) && PEVENT_CRIT_NEW=1
  fi
  SNAP_PID=${SV[pid]:-}; LAST_CRIT_N=$crit

  st_norm "${SV[mem_st]:-unavailable}"; O_ST_MEM=$REPLY
  st_norm "${SV[cpu_st]:-unavailable}"; O_ST_CPU=$REPLY
  v=${SV[load1]:-}; is_udec "$v" && O_LOAD=$v || O_LOAD=-1

  # reservations (SCHEMA §9.1) and per-job identity from the same snapshot
  # A negative value is the sensor's "unavailable" (budget_b=-1 when memory is not
  # measured): published as -1, overcommit null -- never as a measured 0.0 (SEM-6).
  u=${SV[reserved_b]:-}; t=${SV[budget_b]:-}
  if is_int "$u" && is_int "$t"; then
    RES_FROM=sensor; RES_RESERVED_OK=1; RES_BUDGET_OK=1
    if [[ $u == -* ]]; then RES_RESERVED_OK=0; RES_RESERVED_MILLI=0
    else RES_RESERVED_MILLI=$(( u * 1000 / 1073741824 )); fi
    if [[ $t == -* ]]; then RES_BUDGET_OK=0; RES_BUDGET_MILLI=0
    else RES_BUDGET_MILLI=$(( t * 1000 / 1073741824 )); fi
    [[ ${SV[overcommit]:-0} == 1 ]] && RES_OVERCOMMIT=1 || RES_OVERCOMMIT=0
  else
    RES_FROM=envelopes; RES_RESERVED_OK=1; RES_BUDGET_OK=1
  fi
  SJOB_ID=(); SJOB_HB=(); SJOB_FID=(); SJOB_HAS_FILE=0; RES_JOBS=0
  n=${SV[jobs_n]:-0}; is_uint "$n" && (( n <= 4096 )) || n=0
  for (( j = 0; j < n; j++ )); do
    pid=${SV[job${j}_pid]:-}; is_pid "$pid" || continue
    v=${SV[job${j}_identity]:-unverifiable}
    SJOB_ID[$pid]=$v
    SJOB_HB[$pid]=${SV[job${j}_hb_age_s]:--1}
    t=${SV[job${j}_file]:-}
    if [[ -n $t && $t != none ]]; then pct_decode "$t"; SJOB_FID[$REPLY]="$pid $v"; SJOB_HAS_FILE=1; fi
    [[ $v == ok ]] && (( RES_JOBS++ ))
  done
  # The registry as the SENSOR read it (SCHEMA §6): unavailable above 1024 envelopes or
  # when an envelope cannot be read. A sensor that publishes no jobs_st said nothing.
  SJOBS_ST=ok; [[ ${SV[jobs_st]:-ok} == ok ]] || SJOBS_ST=unavailable
  SNAP_TS=${SV[ts_s]}
}

# ---- observation: the fallback sampler -------------------------------------------
# Used only while the sensor is down or stale, with EXACTLY the commands the gates
# shadow on PATH (sysctl, memory_pressure, vm_stat, df, pmset). Every parse
# failure makes that signal unavailable. Never a default that reads as healthy.
sample_fallback() {
  setopt localoptions extendedglob
  local out line v m mt now_r el
  local -a w lines
  local -A seenm
  # vm pressure: the OS's own verdict, 1 / 2 / 4
  out=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null); out=${out//[[:space:]]/}
  if [[ $out == (1|2|4) ]]; then O_VMP=$out; O_ST_VMP=ok
  else O_VMP=1; [[ -n $out ]] && O_ST_VMP=invalid || O_ST_VMP=unavailable; fi
  # free percentage: the sysctl memory_pressure itself reads; else memory_pressure
  out=$(sysctl -n kern.memorystatus_level 2>/dev/null); out=${out//[[:space:]]/}
  if ! { is_uint "$out" && (( out <= 100 )); }; then
    out=$(memory_pressure 2>/dev/null)
    [[ $out == (#b)*'free percentage: '(<->)'%'* ]] && out=$match[1] || out=""
  fi
  if is_uint "$out" && (( out <= 100 )); then O_FREE=$out; O_ST_FREE=ok; else O_FREE=100; O_ST_FREE=unavailable; fi
  # swap: "total = 19456.00M  used = 18022.06M  free = ..."
  out=$(sysctl -n vm.swapusage 2>/dev/null)
  if [[ $out == (#b)*total\ =\ ([0-9]##)(|.[0-9]#)M*used\ =\ ([0-9]##)(|.[0-9]#)M* ]] \
     && is_uint "$match[1]" && is_uint "$match[3]" && (( match[3] <= match[1] )); then
    O_SWT_RAW=$match[1]; O_SWU=$match[3]; O_SWT=$(( O_SWT_RAW > 0 ? O_SWT_RAW : 1 )); O_ST_SWAP=ok
  else
    O_SWU=0; O_SWT=1; O_SWT_RAW=0; [[ -n $out ]] && O_ST_SWAP=invalid || O_ST_SWAP=unavailable
  fi
  # pageouts: a RATE over the MEASURED elapsed time, in pages per 5 s whatever POLL
  # is. v1 published the raw per-poll delta, so a poll that ran late -- or a
  # governor that was stopped or asleep -- reported every page moved during the gap
  # as one poll's traffic: a spurious spike. A gap of a minute or more is not a
  # rate at all (sleep, SIGSTOP): rebaseline instead, as the sensor does on wake.
  out=$(vm_stat 2>/dev/null); v=""
  for line in ${(f)out}; do
    [[ $line == Pageouts:* ]] && { v=${${line##*[[:space:]]}%.}; break; }
  done
  now_r=$EPOCHREALTIME
  if is_uint "$v"; then
    O_ST_PAGEOUTS=ok; O_PORATE=0
    if is_uint "$PREV_PO" && [[ -n $PREV_PO_T ]]; then
      el=$(( now_r - PREV_PO_T ))
      if (( v < PREV_PO || el <= 0 )); then
        :                                           # counter reset or clock step: rebaseline
      elif (( el > (6 * POLL > 60 ? 6 * POLL : 60) )); then
        log "pageout sample gap of ${el%%.*}s (sleep or stop): rate rebaselined, not reported as a burst"
      else
        local -i r; (( r = (v - PREV_PO) * 5 / el )); O_PORATE=$r
      fi
    fi
    PREV_PO=$v; PREV_PO_T=$now_r
  else
    O_PORATE=0; [[ -n $out ]] && O_ST_PAGEOUTS=invalid || O_ST_PAGEOUTS=unavailable
    PREV_PO=""; PREV_PO_T=""
  fi
  # disk: every policy volume; ok only when every one of them is (SCHEMA §3.1)
  # A df line is "Filesystem 1G-blocks Used Avail Capacity [iused ifree %iused] Mounted
  # on". The mount point is EVERYTHING after the last NN% column and may contain spaces;
  # Avail is the column just before the first NN%. Review 2026-10-08 R11 (round 2): the
  # mount was taken as the last WORD, so '<dir>/my disk' was published as 'disk' and two
  # volumes whose mounts shared a last word were collapsed into one -- a 0 GiB volume
  # beside a 99 GiB one went unmeasured and its RED was missed.
  VOL_MOUNT=(); VOL_AVAIL=(); VOL_ST=(); O_DISK=999; O_ST_DISK=ok
  local -i pc; local av
  for v in $DISK_VOLUMES; do
    out=$(df -g "$v" 2>/dev/null); lines=(${(f)out})
    line=${lines[-1]:-}; w=(${=line}); m=""; av=""
    if (( ${#lines} >= 2 )); then
      for (( pc = 1; pc <= ${#w}; pc++ )); do [[ $w[pc] == <->% ]] && break; done
      (( pc > 1 && pc < ${#w} )) && av=$w[pc-1]
      [[ $line == *[0-9]%[[:space:]]##[^[:space:]]* ]] && m=${line##*[0-9]%[[:space:]]##}
    fi
    if [[ -n $m ]] && is_uint "$av"; then
      (( ${+seenm[$m]} )) && continue
      seenm[$m]=1
      VOL_MOUNT+=("$m"); VOL_AVAIL+=($av); VOL_ST+=(ok)
      (( av < O_DISK )) && O_DISK=$av
    else
      VOL_MOUNT+=("$v"); VOL_AVAIL+=(-1); VOL_ST+=(unavailable); O_ST_DISK=unavailable
    fi
  done
  [[ $O_ST_DISK == ok ]] || O_DISK=999
  # thermal: CPU_Speed_Limit. ABSENT on Apple Silicon -> UNAVAILABLE (T-173). v1
  # defaulted this to 100, and the governor called a machine it could not measure
  # thermally healthy for every poll it ever ran on this Mac.
  out=$(pmset -g therm 2>/dev/null); v=""
  for line in ${(f)out}; do
    [[ $line == *CPU_Speed_Limit*=* ]] && { m=${line##*=}; m=${m//[[:space:]]/}; is_uint "$m" && (( m <= 100 )) && v=$m; }
  done
  O_THERM_SRC=pct
  if [[ -n $v ]]; then O_THERM=$v; O_ST_THERMAL=ok; thermal_word $v; O_THERM_STATE=$REPLY
  else O_THERM=100; O_ST_THERMAL=unavailable; O_THERM_STATE=none; fi
  # load average (published only)
  out=$(sysctl -n vm.loadavg 2>/dev/null); w=(${=out})
  is_udec "${w[2]:-}" && O_LOAD=$w[2] || O_LOAD=-1
  O_ST_PEVENT=unavailable; O_PEVENT=none; PEVENT_CRIT_NEW=0
  O_ST_MEM=unavailable; O_ST_CPU=unavailable
  RES_FROM=envelopes; RES_RESERVED_OK=1; RES_BUDGET_OK=1
}

observe() {
  local now=$EPOCHSECONDS
  SENSOR_FRESH=0
  if (( SENSOR_ENABLED )); then
    if read_sensor_env; then sensor_fresh_check $now
    else SENSOR_WHY="no snapshot"; SENSOR_AGE=-1; fi
  else
    SENSOR_AGE=-1
  fi
  if (( SENSOR_FRESH )); then
    EV_SOURCE=sensor; SENSOR_LAST_FRESH=$now
    map_sensor
  else
    EV_SOURCE=fallback; SJOB_ID=(); SJOB_HB=(); SJOB_FID=(); SJOB_HAS_FILE=0; SJOBS_ST=ok
    sample_fallback
  fi
}

# ---- sensor supervision (the sensor is this daemon's CHILD) ----------------------
sensor_start() {
  (( SENSOR_ENABLED )) || return 1
  "$SENSOR_BIN" run --state-dir "$STATE_DIR" --parent $$ --poll $POLL >>"$STATE_DIR/log/sensor.log" 2>&1 </dev/null &
  SENSOR_PID=$!
  SENSOR_STARTED=$EPOCHSECONDS
  SENSOR_STARTS+=($EPOCHSECONDS)
  log "sensor started pid=$SENSOR_PID ($SENSOR_BIN, poll ${POLL}s)"
}
sensor_stop() { # orderly: TERM, wait <= 2 s
  (( SENSOR_PID > 0 )) || return 0
  if kill -0 "$SENSOR_PID" 2>/dev/null; then
    kill -TERM "$SENSOR_PID" 2>/dev/null
    local i
    for i in {1..40}; do kill -0 "$SENSOR_PID" 2>/dev/null || break; sleep 0.05; done
    kill -0 "$SENSOR_PID" 2>/dev/null && log "sensor pid=$SENSOR_PID still running 2s after TERM (it exits with its parent)"
  fi
  SENSOR_PID=0
}
SENSOR_RESTART_MIN_S=30
sensor_supervise() {
  (( SENSOR_ENABLED )) || return 0
  local now=$EPOCHSECONDS lim pp s
  local -a keep
  if (( SENSOR_PID > 0 )); then
    if kill -0 "$SENSOR_PID" 2>/dev/null; then
      lim=$(( STALE_POLLS * POLL + 10 ))
      (( SENSOR_FRESH || now - SENSOR_STARTED <= lim || now - SENSOR_LAST_FRESH <= lim )) && return 0
      # Alive but mute: wedged. Only OUR child is ever signalled -- check the ppid.
      pp=$(ps -o ppid= -p "$SENSOR_PID" 2>/dev/null); pp=${pp//[[:space:]]/}
      if [[ $pp == "$$" ]]; then
        log "sensor pid=$SENSOR_PID alive but no fresh snapshot ($SENSOR_WHY): terminating it for a restart"
        kill -TERM "$SENSOR_PID" 2>/dev/null
      fi
    else
      log "sensor pid=$SENSOR_PID exited"
    fi
    SENSOR_PID=0
  fi
  (( now < SENSOR_GIVEUP_UNTIL )) && return 0
  (( SENSOR_STARTED > 0 && now - SENSOR_STARTED < SENSOR_RESTART_MIN_S )) && return 0
  for s in $SENSOR_STARTS; do (( now - s < 600 )) && keep+=($s); done
  SENSOR_STARTS=($keep)
  if (( ${#SENSOR_STARTS} >= 5 )); then
    SENSOR_GIVEUP_UNTIL=$(( now + 600 )); SENSOR_STARTS=()
    log "sensor would not stay up: 5 starts within 10 min -- not restarting it for 10 min (fallback sampling; evidence incomplete meanwhile)"
    return 0
  fi
  sensor_start
}

# ---- classification -----------------------------------------------------------
# Each tier needs a VECTOR: OS pressure OR (corroborated swap thrash) OR disk OR thermal.
# Sets GLOBALS CLASS and REASON. Must NOT be called in $(...) — a command
# substitution is a subshell, so the REASON assignment would be lost and the
# caller would read an unset variable. That exact bug killed the daemon after
# one poll on 2026-09-09 while the stale state file still read GREEN.
#
# PURE: a function of O_VMP O_FREE O_SWU O_SWT O_PORATE O_DISK O_THERM (and the
# policy floors) only. resilience_harness.mjs sources this file, sets exactly
# those seven and calls it under `set -u`. It also sets CRITICAL_NOW: the two
# conditions that bypass hysteresis (SCHEMA §4.4) and are visible from these
# inputs -- the OS saying critical, and a volume below the red floor.
#
# Thermal REASON text names what was actually observed: the sensor's thermalState word
# ("thermal state serious") or, only when pmset measured one, the CPU_Speed_Limit
# percentage. The ladder value of a word is internal; quoting it as "speed 65%" invented
# a measurement (review 2026-10-08 SEM-5).
therm_why() { # therm_why FALLBACK_WORD -> REPLY
  if [[ $O_THERM_SRC == word && $O_THERM_STATE != none ]]; then REPLY="thermal state $O_THERM_STATE"
  else REPLY="thermal $1 (speed ${O_THERM}%)"; fi
}
classify() {
  local swpct=$(( 100 * O_SWU / O_SWT ))
  CRITICAL_NOW=$(( O_VMP >= 4 || O_DISK < DISK_FLOOR_RED ))
  # RED — the OS itself says critical, or genuine sustained thrash, or disk cliff.
  if (( O_VMP >= 4 )); then REASON="kern vm_pressure=CRITICAL"; CLASS=RED; return; fi
  if (( O_PORATE > 6000 && swpct >= 85 )); then REASON="pageouts +${O_PORATE}/poll with swap ${swpct}%"; CLASS=RED; return; fi
  if (( O_DISK < DISK_FLOOR_RED )); then REASON="disk ${O_DISK}Gi"; CLASS=RED; return; fi
  if (( O_THERM < 40 )); then therm_why critical; REASON=$REPLY; CLASS=RED; return; fi
  # ORANGE — OS warning, or real pageout traffic, or disk/thermal pressure.
  if (( O_VMP >= 2 )); then REASON="kern vm_pressure=WARNING"; CLASS=ORANGE; return; fi
  if (( O_PORATE > 1500 && swpct >= 60 )); then REASON="pageouts +${O_PORATE}/poll with swap ${swpct}%"; CLASS=ORANGE; return; fi
  if (( O_DISK < DISK_FLOOR_ORANGE )); then REASON="disk ${O_DISK}Gi"; CLASS=ORANGE; return; fi
  if (( O_THERM < 70 )); then therm_why serious; REASON=$REPLY; CLASS=ORANGE; return; fi
  # YELLOW — early warning: memory genuinely tight, or pageouts started, or disk low.
  if (( O_FREE <= 12 && O_PORATE > 300 )); then REASON="free ${O_FREE}% with pageouts +${O_PORATE}"; CLASS=YELLOW; return; fi
  if (( O_PORATE > 600 )); then REASON="pageouts +${O_PORATE}/poll"; CLASS=YELLOW; return; fi
  if (( O_DISK < DISK_FLOOR_YELLOW )); then REASON="disk ${O_DISK}Gi"; CLASS=YELLOW; return; fi
  if (( O_THERM < 90 )); then therm_why fair; REASON=$REPLY; CLASS=YELLOW; return; fi
  REASON="nominal"; CLASS=GREEN
}

# ---- the evidence step (NOT inside classify) -----------------------------------
# SCHEMA §3.3: GREEN or YELLOW may be published only when every required signal is
# `ok` and -- when a sensor is configured -- its snapshot is fresh. Otherwise
# UNKNOWN, unless the evidence that IS present says ORANGE or RED: missing evidence
# never hides real pressure.
sig_status() {
  case $1 in
    vm_pressure) REPLY=$O_ST_VMP ;; swap) REPLY=$O_ST_SWAP ;; pageouts) REPLY=$O_ST_PAGEOUTS ;;
    disk) REPLY=$O_ST_DISK ;; thermal) REPLY=$O_ST_THERMAL ;; free_pct) REPLY=$O_ST_FREE ;;
    pressure_event) REPLY=$O_ST_PEVENT ;; memory) REPLY=$O_ST_MEM ;; cpu) REPLY=$O_ST_CPU ;;
    *) REPLY="unknown-signal" ;;
  esac
}
evidence_step() {
  local s
  local -a d
  MISSING=()
  if (( SENSOR_ENABLED && ! SENSOR_FRESH )); then MISSING+=(sensor); d+=("sensor($SENSOR_WHY)"); fi
  for s in $REQUIRED_SIGNALS; do
    sig_status "$s"
    [[ $REPLY == ok ]] && continue
    MISSING+=("$s"); d+=("$s($REPLY)")
  done
  EVIDENCE_COMPLETE=$(( ${#MISSING} == 0 ))
  MISSING_DESC=${(j: :)d}
}
# The two CRITICAL_NOW conditions classify() cannot see (SCHEMA §4.4): a critical
# memory-pressure event since the previous poll, and a failed publication.
critical_inputs() {
  CRIT_WHY=""
  if (( PEVENT_CRIT_NEW )); then CRITICAL_NOW=1; CRIT_WHY="critical memory-pressure event since the last poll"; fi
  if (( PUBLISH_FAILED )); then CRITICAL_NOW=1; CRIT_WHY="state publication failed: $PUB_FAIL"; PUBLISH_FAILED=0; fi
  return 0
}
# decide: classify's CLASS + the evidence step + CRITICAL_NOW -> NEW (the candidate)
decide() {
  if [[ $CLASS == (ORANGE|RED) ]]; then
    NEW=$CLASS
    (( EVIDENCE_COMPLETE )) || REASON="$REASON (evidence incomplete: $MISSING_DESC)"
  elif (( ! EVIDENCE_COMPLETE )); then
    NEW=UNKNOWN; REASON="evidence incomplete: $MISSING_DESC"
  else
    NEW=$CLASS
  fi
  if (( CRITICAL_NOW )) && [[ $NEW != RED ]]; then NEW=RED; REASON=${CRIT_WHY:-$REASON}; fi
}

set_jmax() {
  case "$1" in
    GREEN)  JMAX=$(( NPERF > 2 ? NPERF - 2 : 1 )) ;;
    YELLOW) JMAX=$(( NPERF / 2 > 1 ? NPERF / 2 : 1 )) ;;
    ORANGE) JMAX=2 ;;
    RED)    JMAX=1 ;;
    *)      JMAX=2 ;;   # UNKNOWN: no evidence of health, so no evidence for -j8 either
  esac
}
build_jobs_for() { set_jmax "$1"; print $JMAX; }

# How many consecutive confirming polls a move from $1 to $2 needs.
#
# UNKNOWN is not a rung on the pressure ladder; it means "this governor has no
# sustained evidence yet". It is published at start, on stop, and (T-173) whenever a
# required observable is missing. Leaving it for a PRESSURE state is an escalation
# backed by evidence, so it takes the ordinary escalation count. Leaving it for
# GREEN or YELLOW is a recovery, so it takes the slow count: the absence of a bad
# sample is not a healthy sample. Entering UNKNOWN is immediate -- losing evidence
# must close admission on the poll it is lost, not two polls later.
#
# THE BUG THIS REPLACES (measured 2026-09-15): the daemon started in GREEN and
# published GREEN "armed" before its first classification, so each of 16 launchd
# respawns during a disk-11GiB RED episode re-opened heavy admission for ~10s.
need_for() { # -> NEED, and NEED_ESC=1 when the move is an escalation (or into UNKNOWN)
  NEED_ESC=1
  case "$1:$2" in
    *:UNKNOWN)                         NEED=1 ;;
    UNKNOWN:RED|UNKNOWN:ORANGE)        NEED=$ESCALATE_N ;;
    UNKNOWN:*)                         NEED=$DEESCALATE_N; NEED_ESC=0 ;;
    GREEN:*|YELLOW:ORANGE|YELLOW:RED|ORANGE:RED) NEED=$ESCALATE_N ;;
    *)                                 NEED=$DEESCALATE_N; NEED_ESC=0 ;;
  esac
}
confirm_needed() { need_for "$1" "$2"; print $NEED; }

# One step of the hysteresis machine. CRITICAL_NOW (OS critical, a critical
# pressure event since the last poll, a volume under the red floor, a failed
# publication) moves to RED on the poll that observes it: confirm_needed is
# bypassed for exactly that move and no other. Entering UNKNOWN is immediate too.
#
# A poll CONFIRMS a candidate only when it carries new evidence (POLL_FRESH: a new
# sensor seq, or a full POLL since the previous poll in fallback). A de-escalation
# additionally never counts a USR2 wake-up poll: a pressure-event storm re-polls up to
# five times a second, and each of those used to count as one of deescalate_polls --
# RED->ORANGE in 0.8 s instead of ~30 s (review 2026-10-08 R5). Wake-up polls with new
# evidence still count toward an escalation, and CRITICAL_NOW still bypasses at once.
advance() {
  local new=$1 counts=1
  TRANSITIONED=0
  if [[ "$new" == "$STATE" ]]; then CONFIRM=0; CAND="$STATE"; return 0; fi
  need_for "$STATE" "$new"
  if [[ $new == UNKNOWN ]] || { (( CRITICAL_NOW )) && [[ $new == RED ]]; }; then
    OLD="$STATE"; STATE="$new"; CAND="$new"; CONFIRM=0; TRANSITIONED=1   # immediate, whatever this poll's evidence
    return 0
  fi
  if (( ! POLL_FRESH )) || (( WAKE_POLL && ! NEED_ESC )); then counts=0; fi
  if [[ "$new" == "$CAND" ]]; then (( CONFIRM += counts )); else CAND="$new"; CONFIRM=$counts; fi
  if (( CONFIRM >= NEED )); then OLD="$STATE"; STATE="$CAND"; CONFIRM=0; TRANSITIONED=1; fi
  return 0
}
# poll_evidence: is this poll's evidence new? Sets POLL_FRESH; called once per poll,
# after observe(). The sensor's seq is per process: a new sensor pid is new evidence.
poll_evidence() {
  local s=${SV[seq]:-} p=${SV[pid]:-} now=$EPOCHREALTIME
  POLL_FRESH=1
  if [[ $EV_SOURCE == sensor ]]; then
    [[ -n $s && $s == "$LAST_SEQ" && $p == "$LAST_SEQ_PID" ]] && POLL_FRESH=0
    LAST_SEQ=$s; LAST_SEQ_PID=$p
  else
    # fallback samples the machine itself: a sample is new once a poll period has
    # passed (a clock stepped backwards counts as new rather than stalling hysteresis)
    (( LAST_POLL_T > 0 && now - LAST_POLL_T >= 0 && now - LAST_POLL_T < POLL * 0.9 )) && POLL_FRESH=0
    LAST_SEQ=""; LAST_SEQ_PID=""
  fi
  (( POLL_FRESH )) && LAST_POLL_T=$now
  return 0
}

# ---- the poll sleep ------------------------------------------------------------
# `sleep` as a FOREGROUND command defers every trap until it returns, so a TERM
# arriving one second into a 5-second poll waits out the other four before the
# lock is released and the domain de-published. Backgrounding it and `wait`ing
# makes the shell interruptible: zsh runs a trap the moment `wait` is signalled.
# MEASURED 2026-09-11: 4s deferral at the shipped POLL=5, ~0s after this change.
#
# v2: the sensor sends SIGUSR2 on every warn/critical pressure event; the trap sets
# WOKE and the interrupted wait returns 128+n, so the next poll runs AT ONCE rather
# than at the next tick. The interrupted sleep is reaped, not orphaned. A USR2 that
# lands while a poll is running re-polls immediately too. Five wake-ups in a row
# without a full sleep is a storm, not an event: then the sleep is finished.
# The backoff loop uses this same function, so the TERM property holds there too.
# WAKE_POLL=1 when the next poll runs early because of a wake-up (advance() never
# counts such a poll toward a de-escalation: R5).
poll_sleep() {
  WAKE_POLL=0
  if (( WOKE && WAKE_STREAK < 5 )); then WOKE=0; (( WAKE_STREAK++ )); WAKE_POLL=1; return 0; fi
  (( WOKE )) || WAKE_STREAK=0
  WOKE=0
  sleep "$POLL" & wait $!
  local rc=$? sp=$!
  if (( rc > 128 )); then
    if (( WAKE_STREAK >= 5 )); then
      while (( rc > 128 )) && kill -0 "$sp" 2>/dev/null; do wait "$sp"; rc=$?; done
      WAKE_STREAK=0
    else
      kill "$sp" 2>/dev/null; (( WAKE_STREAK++ )); WAKE_POLL=1
    fi
  fi
  WOKE=0
  return 0
}

# The TERM trap runs while poll_sleep is blocked in `wait` -- and zsh does NOT exit
# from inside a function until that wait returns, i.e. until the poll's sleep ends:
# MEASURED 4.3 s to release the lock at POLL=5 (guardian_single_instance_gate C15c,
# red) once the sleep moved into poll_sleep. So the stop path ends the in-flight
# poll sleep itself: the CURRENT job (+), the poll's own sleep (zsh records the
# job's SOURCE text, `sleep "$POLL"`, not its expansion), still running --
# never anything else from the job table, which holds only this shell's children.
zmodload zsh/parameter 2>/dev/null
stop_poll_sleep() {
  local j st
  (( ${+jobtexts} )) || return 0
  for j in ${(k)jobtexts}; do
    [[ ${jobtexts[$j]} == ('sleep "$POLL"'|"sleep $POLL") ]] || continue
    st=${jobstates[$j]:-}
    [[ $st == running:+:<->=* ]] || continue
    kill ${${st#running:+:}%%=*} 2>/dev/null
  done
  return 0
}

# ---- logs (SCHEMA §2) ----------------------------------------------------------
maybe_rotate() { # maybe_rotate FILE LIMIT_BYTES -> 0 when rotated
  local f=$1 lim=$2 g=$POL[logs_generations] i
  local -A st
  zstat -H st -- "$f" 2>/dev/null || return 1
  (( st[size] > lim )) || return 1
  if (( g < 1 )); then zf_rm -f -- "$f" 2>/dev/null; return 0; fi
  for (( i = g; i > 1; i-- )); do [[ -e "$f.$(( i - 1 ))" ]] && zf_mv -f -- "$f.$(( i - 1 ))" "$f.$i" 2>/dev/null; done
  zf_mv -f -- "$f" "$f.1" 2>/dev/null
  return 0
}
rotate_logs() {
  local mib=1048576 rot=$(( POL[logs_rotate_mib] * 1048576 )) f
  local -A st
  maybe_rotate "$LOG" $rot && log "log rotated (> $POL[logs_rotate_mib] MiB)"
  if maybe_rotate "$OUT_F" $rot; then exec >>"$OUT_F" 2>&1; log "guardian.out rotated and reopened"; fi
  maybe_rotate "$STATE_DIR/history.jsonl" $(( POL[logs_history_mib] * mib / (POL[logs_generations] + 1) ))
  # events.jsonl has two writers; while the sensor is healthy it owns the rotation.
  (( SENSOR_FRESH )) || maybe_rotate "$STATE_DIR/events.jsonl" $rot
  # launchd holds these open itself: truncate in place, never rename.
  for f in "$STATE_DIR/log/launchd.out" "$STATE_DIR/log/launchd.err"; do
    zstat -H st -- "$f" 2>/dev/null && (( st[size] > rot )) && { : >| "$f"; } 2>/dev/null && log "truncated ${f:t} in place (> $POL[logs_rotate_mib] MiB)"
  done
  return 0
}
dir_bytes() { local f t=0; local -A st; for f in "$1"/**/*(ND.); do zstat -H st -- "$f" 2>/dev/null && (( t += st[size] )); done; REPLY=$t }
# Every 10 min: hold log/, history.jsonl*, events.jsonl*, events/, incidents/,
# reservations.history.jsonl* and crashes/ under logs_cap_mib -- oldest ROTATED files
# first, then oldest incident dirs -- and drop incident dirs older than
# logs_retention_days. Live files are never deleted, and nothing outside those names is
# ever touched. The release ledgers (review 2026-10-08 R13, governor half) are COUNTED:
# `release` rotates reservations.history.jsonl and each crashes/<sig>.jsonl at 1 MiB and
# prunes crash ledgers past retention, but they were outside the cap's sum, so the
# evidence on disk could exceed logs.cap_mib unseen. A rotated reservations history is
# prunable like any rotated log; crash ledgers (and their .1) are never pruned here:
# they are the crash-loop evidence that admit's quarantine counts (release bounds them).
#
# THE FLOOR (review 2026-10-08 round 2, verify R13 regression): what this function never
# deletes -- live files, crash ledgers, events/ -- can by itself exceed the cap (enough
# crashing signatures within the retention window). No amount of pruning reaches the cap
# then, and pruning "while over the cap" deleted EVERY prunable item, the newest incident
# and history.jsonl.1 included: the freshest evidence was destroyed for nothing (c249d838,
# which did not count the ledgers, kept them). So when the floor alone is over the cap,
# the newest incident directory and every generation-1 rotated file (<name>.1) are KEPT;
# everything older is still pruned, which bounds what remains to the floor plus one
# incident (<= logs.incident_max_kib) plus one rotation of each log. When the cap is
# reachable, pruning is exactly as before (oldest rotated, then oldest incidents).
housekeeping() {
  local cap=$(( POL[logs_cap_mib] * 1048576 )) total=0 prunable=0 floor f n d base newest="" kept_txt=""
  local -i keep=0
  local -a files rotated incs
  local -A st
  files=("$STATE_DIR"/log/**/*(ND.) "$STATE_DIR"/history.jsonl*(N.) "$STATE_DIR"/events.jsonl*(N.) "$STATE_DIR"/events/**/*(ND.) "$STATE_DIR"/incidents/**/*(ND.)
         "$STATE_DIR"/reservations.history.jsonl*(N.) "$STATE_DIR"/crashes/**/*(ND.))
  for f in $files; do zstat -H st -- "$f" 2>/dev/null && (( total += st[size] )); done
  for d in "$STATE_DIR"/incidents/*(N/m+$POL[logs_retention_days]); do
    dir_bytes "$d"; zf_rm -rf -- "$d" 2>/dev/null && { (( total -= REPLY )); log "housekeeping: removed incident ${d:t} (older than $POL[logs_retention_days] days)"; }
  done
  # rotated generations beyond policy, then the oldest rotated files while over cap
  rotated=("$STATE_DIR"/log/*.<->(N.Om) "$STATE_DIR"/history.jsonl.<->(N.Om) "$STATE_DIR"/events.jsonl.<->(N.Om)
           "$STATE_DIR"/reservations.history.jsonl.<->(N.Om))
  incs=("$STATE_DIR"/incidents/*(N/Om))
  if (( total > cap )); then
    for f in $rotated; do zstat -H st -- "$f" 2>/dev/null && (( prunable += st[size] )); done
    for d in $incs; do dir_bytes "$d"; (( prunable += REPLY )); done
    floor=$(( total - prunable ))
    if (( floor > cap )); then
      keep=1; kept_txt=", crash ledgers, the newest incident and the .1 generations"; (( ${#incs} )) && newest=${incs[-1]}
      (( HK_FLOOR_LOGGED )) || log "housekeeping: live files and crash ledgers alone are $(( floor / 1048576 )) MiB > cap ${POL[logs_cap_mib]} MiB: no pruning reaches the cap, so the newest incident${newest:+ (${newest:t})} and the .1 generations are kept"
      HK_FLOOR_LOGGED=1
    fi
  fi
  (( keep )) || HK_FLOOR_LOGGED=0
  for f in $rotated; do
    n=${f##*.}
    if (( n > POL[logs_generations] || (total > cap && !(keep && n == 1)) )); then
      zstat -H st -- "$f" 2>/dev/null || continue
      zf_rm -f -- "$f" 2>/dev/null && { (( total -= st[size] )); log "housekeeping: removed rotated ${f:t} (${st[size]} bytes)"; }
    fi
  done
  if (( total > cap )); then
    for d in $incs; do
      (( total > cap )) || break
      [[ $d == "$newest" ]] && continue
      dir_bytes "$d"; zf_rm -rf -- "$d" 2>/dev/null && { (( total -= REPLY )); log "housekeeping: removed incident ${d:t} to stay under ${POL[logs_cap_mib]} MiB"; }
    done
  fi
  if (( total > cap )); then
    (( HK_OVER_LOGGED )) || log "housekeeping: evidence still $(( total / 1048576 )) MiB > cap ${POL[logs_cap_mib]} MiB after pruning everything prunable (live files${kept_txt} are kept)"
    HK_OVER_LOGGED=1
  else
    HK_OVER_LOGGED=0
  fi
  HK_TOTAL=$total
}
HK_OVER_LOGGED=0; HK_FLOOR_LOGGED=0; HK_TOTAL=0

# ---- notifications -------------------------------------------------------------
# Kinds: red, unknown, quarantine, incident -- each rate-limited by policy across
# restarts (the stamp is a file). The command runs in the background and is killed
# after 5 s; failures are logged and ignored. The real desktop notifier (osascript)
# is used only by the SUPERVISED governor (ppid 1, i.e. launchd) or when
# FORGE_GUARDIAN_NOTIFY=1: private test domains drive RED on purpose and must not
# pop banners on the user's desktop. $FORGE_GUARDIAN_NOTIFY_CMD always runs.
notify() { # notify KIND TITLE TEXT
  local kind=$1 title=$2 text=$3 stamp="$STATE_DIR/notify/$1" now=$EPOCHSECONDS pp
  local -A st
  [[ ${POL[notifications_enabled]} == 1 ]] || return 0
  if zstat -H st -- "$stamp" 2>/dev/null && (( now - st[mtime] < POL[notifications_min_interval_s] )); then
    log "notification '$kind' rate-limited: $title"
    return 0
  fi
  zf_mkdir -p -- "$STATE_DIR/notify" 2>/dev/null
  print -r -- $now 2>/dev/null >| "$stamp"
  if [[ -z ${FORGE_GUARDIAN_NOTIFY_CMD:-} && ${FORGE_GUARDIAN_NOTIFY:-} != 1 ]]; then
    pp=$(ps -o ppid= -p $$ 2>/dev/null); pp=${pp//[[:space:]]/}
    if [[ $pp != 1 ]]; then log "notification '$kind' (not sent: unsupervised governor, ppid=$pp): $title -- $text"; return 0; fi
  fi
  log "notification '$kind': $title -- $text"
  (
    trap - TERM INT USR2 EXIT $STOP_SIGNALS
    local np i rc t
    if [[ -n ${FORGE_GUARDIAN_NOTIFY_CMD:-} ]]; then
      "$FORGE_GUARDIAN_NOTIFY_CMD" "$title" "$text" </dev/null >/dev/null 2>&1 &
    else
      t=${text//\\/\\\\}; t=${t//\"/\\\"}
      /usr/bin/osascript -e "display notification \"$t\" with title \"Forge Guardian\"" </dev/null >/dev/null 2>&1 &
    fi
    np=$!
    for i in {1..50}; do kill -0 $np 2>/dev/null || break; sleep 0.1; done
    if kill -0 $np 2>/dev/null; then
      kill -TERM $np 2>/dev/null; sleep 0.5; kill -KILL $np 2>/dev/null
      log "notification '$kind' command killed after 5s"
      exit 0
    fi
    wait $np; rc=$?
    (( rc == 0 )) || log "notification '$kind' command failed (exit $rc) -- ignored"
  ) &!
  return 0
}
# ---- automatic `red` incident (SCHEMA §10; README "automatic on RED") ------------
# Every transition INTO RED asks the sensor for an evidence bundle, in the background
# (it can take seconds; a governor must never wait on it) and killed after 30 s. The
# sensor rate-limits `red` to one per 10 min, so a flapping RED does not flood
# incidents/. Review 2026-10-08 SEM-4: no producer existed -- RED left no bundle.
red_incident() { # red_incident REASON
  if [[ -z $SENSOR_BIN ]]; then log "red incident not recorded: no forge-guardian-sensor"; return 0; fi
  local note=${1[1,400]}
  (
    trap - TERM INT USR2 EXIT $STOP_SIGNALS
    local np i rc
    "$SENSOR_BIN" incident --state-dir "$STATE_DIR" --kind red --note "$note" </dev/null >/dev/null 2>&1 &
    np=$!
    for i in {1..300}; do kill -0 $np 2>/dev/null || break; sleep 0.1; done
    if kill -0 $np 2>/dev/null; then
      kill -TERM $np 2>/dev/null; sleep 0.5; kill -KILL $np 2>/dev/null
      log "red incident: forge-guardian-sensor incident still running after 30s: killed"
      exit 0
    fi
    wait $np; rc=$?
    (( rc == 0 )) || log "red incident: forge-guardian-sensor incident exited $rc (rate-limited or failed)"
  ) &!
  return 0
}
UNKNOWN_SINCE=$EPOCHSECONDS; UNKNOWN_NOTIFIED=0
UNKNOWN_NOTIFY_S=${FORGE_GUARDIAN_UNKNOWN_NOTIFY_S:-120}
typeset -gA KNOWN_Q KNOWN_I
notify_scan_init() {
  local x
  for x in "$STATE_DIR"/quarantine/*.json(N:t); do KNOWN_Q[$x]=1; done
  for x in "$STATE_DIR"/incidents/*(N/:t); do KNOWN_I[$x]=1; done
}
notify_checks() {
  local now=$EPOCHSECONDS x
  if [[ $STATE == UNKNOWN ]] && (( ! UNKNOWN_NOTIFIED && now - UNKNOWN_SINCE > UNKNOWN_NOTIFY_S )); then
    UNKNOWN_NOTIFIED=1
    notify unknown "Forge Guardian: state UNKNOWN" "No sustained evidence for $(( now - UNKNOWN_SINCE ))s; heavy admission closed. $REASON"
  fi
  for x in "$STATE_DIR"/quarantine/*.json(N:t); do
    (( ${+KNOWN_Q[$x]} )) && continue
    KNOWN_Q[$x]=1
    notify quarantine "Forge Guardian: job quarantined" "Crash loop: ${x%.json}. See: forge-guardian-ctl quarantine list"
  done
  for x in "$STATE_DIR"/incidents/*(N/:t); do
    (( ${+KNOWN_I[$x]} )) && continue
    KNOWN_I[$x]=1
    notify incident "Forge Guardian: incident recorded" "$x"
  done
}

# ---- SMART (disk hardware) -----------------------------------------------------
# `diskutil info -plist /` every smart_interval_s, in the BACKGROUND (a hung
# diskutil must never hang the governor), harvested on a later poll.
SMART_PID=0; SMART_T0=0; SMART_NEXT=0
smart_parse() {
  setopt localoptions extendedglob
  local c="" old=$DISK_HW
  [[ -s $1 ]] && c=$(<"$1")
  if [[ $c == (#b)*'<key>SMARTStatus</key>'[[:space:]]#'<string>'([^\<]#)'</string>'* ]]; then
    case $match[1] in
      Verified) DISK_HW=Verified ;;
      Failing|"About to Fail") DISK_HW=Failing ;;
      "Not Supported"|Unsupported) DISK_HW=Unsupported ;;
      *) DISK_HW=UNKNOWN ;;
    esac
  else
    DISK_HW=UNKNOWN
  fi
  [[ $DISK_HW == "$old" ]] || log "disk hardware (SMART): $old -> $DISK_HW"
}
smart_tick() {
  local now=$EPOCHSECONDS out="$STATE_DIR/smart.out"
  if (( SMART_PID > 0 )); then
    if kill -0 "$SMART_PID" 2>/dev/null; then
      if (( now - SMART_T0 > 30 )); then
        kill -KILL "$SMART_PID" 2>/dev/null; SMART_PID=0; DISK_HW=UNKNOWN
        log "SMART probe still running after 30s: killed; disk_hardware UNKNOWN"
      fi
      return 0
    fi
    SMART_PID=0
    smart_parse "$out"
  fi
  (( now >= SMART_NEXT )) || return 0
  SMART_NEXT=$(( now + SMART_S )); SMART_T0=$now
  ( trap - TERM INT USR2 EXIT $STOP_SIGNALS; exec "${FORGE_GUARDIAN_DISKUTIL:-diskutil}" info -plist / ) >| "$out" 2>/dev/null </dev/null &
  SMART_PID=$!
}

# ---- restart-loop breaker ------------------------------------------------------
# Only a REAL start inside the window counts: 0 <= now - s <= window. A future-dated
# entry (a backward clock step) used to count as in-window for ever and put every start
# into a 300 s UNKNOWN backoff (review 2026-10-08 R9); entries more than 60 s in the
# future are dropped when the file is rewritten. The file is read like an envelope --
# regular files only, never blocking (R1).
record_start() { # append to guardian.starts (bounded to 32), count those in the window
  local f="$STATE_DIR/guardian.starts" line s n=0 now=$EPOCHSECONDS
  local -a starts
  if read_envelope_lines "$f"; then
    for line in $RL_LINES; do
      is_uint "$line" || continue
      (( line - now > 60 )) && continue
      starts+=($line)
    done
  fi
  starts+=($now)
  (( ${#starts} > 32 )) && starts=(${starts[-32,-1]})
  write_atomic "$f" "${(F)starts}"
  for s in $starts; do (( now - s >= 0 && now - s <= POL[guardian_restart_loop_window_s] )) && (( n++ )); done
  STARTS_IN_WINDOW=$n
}

# ---- library mode -------------------------------------------------------------
# Sourcing with FORGE_GUARDIAN_LIB=1 defines every function and returns WITHOUT
# starting the loop, so the fault-injection suites exercise THIS code rather than
# a re-extracted copy. A test that re-implements the thing it tests proves nothing.
if [[ -n "${FORGE_GUARDIAN_LIB:-}" ]]; then return 0 2>/dev/null || exit 0; fi

# ---- single instance: ACQUIRE (never in library mode) -------------------------
trap 'release_lock' EXIT
trap 'release_lock; exit 143' TERM
trap 'release_lock; exit 130' INT

# 1. the lock
# guardian.lock/ holds three files, written in this order:
#   pid      this process's pid
#   pstart   its start in EPOCH seconds (pid_pstart: proc_pidinfo via the sensor, else
#            ps read back in UTC). THE identity every reader compares, as a number,
#            +-1 s: forge-gate, forge-nproc, forge-guardian-ctl, `sensor admit` and this
#            acquisition. It means the same in every time zone and locale (review
#            2026-10-08 round 2, FO-4 regression: the text below made `TZ=UTC admit`
#            refuse a live governor, and so did a system time-zone change).
#   started  ps's lstart text in the C locale ("Thu Oct  8 19:39:53 2026") -- LEGACY:
#            local time, so it matches only a reader in the writer's zone. Kept for v1
#            readers and published as guardian_started; a lock WITHOUT pstart (the v1
#            governor's) is still verified by this text, so admission keeps working
#            across an install.
for _try in 1 2; do
  if mkdir "$LOCK_D" 2>/dev/null; then
    print -r -- $$ > "$LOCK_D/pid"
    pid_pstart $$ && print -r -- $REPLY > "$LOCK_D/pstart"
    LC_ALL=C ps -p $$ -o lstart= 2>/dev/null > "$LOCK_D/started"
    LOCK_HELD=1; break
  fi
  holder=$(cat "$LOCK_D/pid" 2>/dev/null || true); holder=${holder//[[:space:]]/}
  # A pid alone cannot identify a process: pids are reused. If the recorded start
  # time no longer matches, this lock names a DIFFERENT process that merely
  # inherited the number, and treating it as a live peer would refuse for ever.
  held_ps=$(cat "$LOCK_D/pstart" 2>/dev/null || true); held_ps=${held_ps//[[:space:]]/}
  if is_uint "$held_ps" && (( ${#held_ps} <= 12 && held_ps > 0 )); then
    if ! pid_pstart "$holder" || (( REPLY - held_ps > 1 || held_ps - REPLY > 1 )); then
      rm -rf "$LOCK_D" 2>/dev/null; continue        # gone, or pid reused -> stale
    fi
  else
    held_start=$(cat "$LOCK_D/started" 2>/dev/null || true)
    now_start=$(LC_ALL=C ps -p "${holder:-0}" -o lstart= 2>/dev/null || true)
    if [[ -n "$held_start" && "$held_start" != "$now_start" ]]; then
      rm -rf "$LOCK_D" 2>/dev/null; continue        # pid reused -> stale
    fi
  fi
  if is_live_guardian "${holder:-}"; then refuse_duplicate "pid $holder"; fi
  # Not a live guardian: stale lock (crash, reboot, PID reuse). Reclaim it.
  # A STALE LOCK MUST NEVER KEEP THE GOVERNOR DOWN.
  rm -rf "$LOCK_D" 2>/dev/null
done
(( LOCK_HELD )) || print -u2 "forge-guardian: could not take the lock and could not confirm a live peer; starting anyway (fail-open)."

# 2. the upgrade window: we hold the lock, but a guardian from BEFORE this
#    version holds none and is still publishing. Fresh state is the evidence.
#    After a real crash nothing republishes, so this clears within 3 polls and
#    the replacement starts on its own -- bounded, self-healing, never permanent.
if domain_is_governed; then
  release_lock
  refuse_duplicate "$(name_a_guardian | head -1 | sed 's/^/pid /' | grep . || print 'an unlocked guardian')"
fi

# ---- daemon from here on ----------------------------------------------------------
# The SIGUSR2 wake-up must exist before the sensor that sends it: an untrapped
# USR2 TERMINATES a shell (its default action).
trap 'WOKE=1' USR2
export LC_ALL=C
if (( LOCK_HELD )); then GUARD_LSTART=$(<"$LOCK_D/started"); else GUARD_LSTART=$(ps -p $$ -o lstart= 2>/dev/null); fi
GUARD_LSTART=${(j: :)${=GUARD_LSTART}}
_ps=""; (( LOCK_HELD )) && [[ -r $LOCK_D/pstart ]] && _ps=$(<"$LOCK_D/pstart"); _ps=${_ps//[[:space:]]/}
if is_uint "$_ps" && (( _ps > 0 )); then GUARD_PSTART=$_ps; elif pid_pstart $$; then GUARD_PSTART=$REPLY; fi
unset _ps
DAEMON_UP=1               # from here on, ANY exit publishes UNKNOWN (release_lock)
# Own stdout/stderr (SCHEMA §2: log/guardian.out, rotated). Done only now, so a
# refusal above still reaches whoever started us.
# (A failed exec redirect leaves zsh running on the old fds; never wrap this in a
# redirected { } group -- zsh restores the group's fds when it ends.)
exec >>"$OUT_F" 2>&1
GUARD_STARTED=$EPOCHSECONDS
[[ -n $POLICY_ERRORS ]] && { log "POLICY ERROR ($POLICY_SOURCE): $POLICY_ERRORS -- using defaults for those keys"; json_esc "$POLICY_ERRORS"; event policy_error "\"source\": \"governor\", \"errors\": \"$REPLY\""; }
zstat -H _pst -- "$STATE_DIR/policy.env" 2>/dev/null && POLICY_MTIME=$_pst[mtime]
[[ ${FORGE_GUARDIAN_SENSOR:-1} != 0 && -n $SENSOR_BIN ]] && SENSOR_ENABLED=1
if [[ ${FORGE_GUARDIAN_SENSOR:-1} != 0 && -z $SENSOR_BIN ]]; then
  log "no forge-guardian-sensor found (FORGE_GUARDIAN_SENSOR_BIN / ${GUARD_SELF:h} / $STATE_DIR/bin): fallback sampling only"
fi
(( ${REQUIRED_SIGNALS[(Ie)thermal]} )) || log "policy: required_signals omits thermal ($POLICY_SOURCE) -- GREEN without thermal evidence is allowed only on a platform whose sensor reports thermal unavailable by design"
record_start
notify_scan_init
guardian_ancestors        # once, at start: whatever runs this governor is never signalled

# ---- main loop ----------------------------------------------------------------
# Start in UNKNOWN, not GREEN: a governor that has just (re)started has no sustained
# evidence, and confirm_needed() makes it earn GREEN over DEESCALATE_N polls.
STATE=UNKNOWN; CAND=UNKNOWN; CONFIRM=0; CLASS=UNKNOWN; REASON="starting: awaiting sustained evidence"
O_VMP=1; O_FREE=100; O_SWU=0; O_SWT=1; O_PORATE=0; O_DISK=999; O_LOAD=0; O_THERM=100; O_JOBS=0
RED_STAGE=0; RED_STAGE_HELD=0
# ---- eviction grace windows -------------------------------------------------
# SETTLE: forge-gate ADMITS a job on its declared peak_gb. Evicting it for
# reaching that envelope is not shedding load, it is a livelock: admission and
# actuation disagree about the same contract. A 30B model load trips
# vm_pressure=CRITICAL ~40s in, before a single iteration, so every such job was
# unwinnable. Measured 2026-09-14: 3 attempts, 0 of 8000 iterations banked.
# TERM_GRACE: one eviction DECISION must produce one TERM. The ladder reset
# RED_STAGE to 1 after a stage-3 TERM, so it re-reached 3 in two polls and
# re-signalled the same pid ~11s later -- 'knowing-v1-lora' took 5 TERMs in 44s,
# 'kernel-core' 6 and 'desktop-gates' 5. The header already promised "a TERM and
# a grace period"; this is that grace period, which had no implementation.
# (Values: FORGE_GUARDIAN_SETTLE / _TERM_GRACE, else policy eviction_*; see apply_policy.)
typeset -A TERMED_AT

# A STOPPED GOVERNOR IS NOT EVIDENCE OF A HEALTHY MACHINE. This trap used to publish
# GREEN "guardian stopped" -- into state.json and, with a fresh ts, into the Law-7
# status.json the training fleet reads -- so for a full staleness window every
# consumer saw GREEN from a governor that had just exited. Publish UNKNOWN (heavy
# admission closed); release_lock then back-dates the state file so forge-gate
# fails closed at once. v2: the sensor child is stopped too (TERM, <= 2 s).
guardian_stop() {
  trap '' USR2 $STOP_SIGNALS
  STOP_PUBLISHED=1
  publish "UNKNOWN" "guardian stopped${1:+ ($1)}" "$(build_jobs_for UNKNOWN)"
  stop_poll_sleep
  sensor_stop
  zf_rm -f -- "$STATE_DIR"/*.tmp.$$(N) "$AH_DIR"/*.tmp.$$(N) 2>/dev/null
  log "guardian stopped${1:+ ($1)}"
  exit 0
}
trap 'guardian_stop' TERM INT
# HUP, QUIT, ALRM, USR1, PIPE, XCPU, XFSZ used to end the daemon by their default
# action with no trap run at all: state.json and the Law-7 status.json kept a fresh
# GREEN behind a dead governor (review 2026-10-08 FO-4). Each is an orderly stop now.
for _sig in $STOP_SIGNALS; do trap "guardian_stop SIG$_sig" $_sig; done; unset _sig

publish "$STATE" "$REASON" "$(build_jobs_for "$STATE")"
emit "🛡  FORGE GUARDIAN ARMED $(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS) ram=${RAM_GB}G ncpu=${NCPU} poll=${POLL}s v${GUARDIAN_VERSION} sensor=${SENSOR_BIN:-none}$([[ $SENSOR_ENABLED == 1 ]] || print ' (fallback sampling)')"

# ---- restart-loop breaker ------------------------------------------------------
# launchd respawns a crashing governor every ThrottleInterval for ever. Each
# respawn used to re-run the whole start-up (and, before T-172, publish GREEN).
# Too many starts in the window: say so once, keep the gates CLOSED by publishing
# UNKNOWN every poll for the backoff, then govern normally.
if (( STARTS_IN_WINDOW >= POL[guardian_restart_loop_max_starts] )); then
  _until=$(( EPOCHSECONDS + POL[guardian_restart_loop_backoff_s] ))
  REASON="guardian restart loop: $STARTS_IN_WINDOW starts within ${POL[guardian_restart_loop_window_s]}s; backing off ${POL[guardian_restart_loop_backoff_s]}s"
  emit "⛔ GUARDIAN $REASON -- publishing UNKNOWN, gates closed"
  event guardian_restart_loop "\"starts\": $STARTS_IN_WINDOW, \"window_s\": ${POL[guardian_restart_loop_window_s]}, \"backoff_s\": ${POL[guardian_restart_loop_backoff_s]}"
  MISSING=(restart_loop); MISSING_DESC="guardian restart loop"; EVIDENCE_COMPLETE=0
  while (( EPOCHSECONDS < _until )); do
    publish UNKNOWN "$REASON" 2
    poll_sleep
  done
  log "restart-loop backoff over: governing normally"
  REASON="starting: awaiting sustained evidence"
fi

sensor_start
PREV_POLL_EPOCH=$EPOCHSECONDS
HK_NEXT=0

while true; do
  POLL_T0=$EPOCHREALTIME
  # policy.env is rewritten by the sensor when policy.json changes
  if zstat -H _pst -- "$STATE_DIR/policy.env" 2>/dev/null; then
    if (( _pst[mtime] != POLICY_MTIME )); then
      POLICY_MTIME=$_pst[mtime]; load_policy
      log "policy reloaded from $POLICY_SOURCE${POLICY_ERRORS:+ -- ERRORS: $POLICY_ERRORS}"
      [[ -n $POLICY_ERRORS ]] && { json_esc "$POLICY_ERRORS"; event policy_error "\"source\": \"governor\", \"errors\": \"$REPLY\""; }
    fi
  elif (( POLICY_MTIME != -1 )); then
    POLICY_MTIME=-1; load_policy; log "policy.env removed: built-in defaults"
  fi

  # READ THE SNAPSHOT, THEN REAP, THEN COUNT. The reaper takes its identity
  # verdicts from the snapshot just read, and registered_jobs / gpu_jobs are both
  # counted in the reaper's own pass. v1 once published registered_jobs=1 beside
  # gpu_jobs=0 for ONE set because the reaper ran between the two counts. Two
  # fields describing one set must be computed on the same side of the thing that
  # changes it.
  observe
  poll_evidence
  sensor_supervise
  reap_dead_jobs
  classify
  evidence_step
  critical_inputs
  decide
  if (( CRITICAL_NOW )) && [[ $STATE != RED ]]; then log "CRITICAL_NOW: ${CRIT_WHY:-$REASON} -- bypassing hysteresis"; fi
  advance "$NEW"
  set_jmax "$STATE"
  if (( TRANSITIONED )); then
    case "$STATE" in
      YELLOW) emit "🟡 GUARDIAN $OLD→YELLOW ($REASON) — no speculative work, build -j$JMAX" ;;
      ORANGE) emit "🟠 GUARDIAN $OLD→ORANGE ($REASON) — shedding speculative jobs, build -j$JMAX" ;;
      RED)    emit "🔴 GUARDIAN $OLD→RED ($REASON) — halting new work, checkpointing"; RED_STAGE=0 ;;
      GREEN)  emit "🟢 GUARDIAN $OLD→GREEN (recovered) — build -j$JMAX"; RED_STAGE=0 ;;
      *)      emit "⚪ GUARDIAN $OLD→$STATE ($REASON) — heavy admission closed, build -j$JMAX"; RED_STAGE=0 ;;
    esac
    json_esc "$REASON"; event transition "\"from\": \"$OLD\", \"to\": \"$STATE\", \"reason\": \"$REPLY\""
    [[ $STATE == RED ]] && { red_incident "$OLD->RED: $REASON"; notify red "Forge Guardian: RED" "$REASON -- shedding registered jobs"; }
    [[ $STATE == UNKNOWN ]] && { UNKNOWN_SINCE=$EPOCHSECONDS; UNKNOWN_NOTIFIED=0; }
  fi
  PUB_REASON=$REASON
  if [[ $STATE == UNKNOWN && $NEW != UNKNOWN ]]; then
    PUB_REASON="awaiting sustained evidence ($CONFIRM/$NEED polls): $REASON"
  fi
  publish "$STATE" "$PUB_REASON" "$JMAX"
  history_append
  PREV_POLL_EPOCH=$EPOCHSECONDS

  # ---- actuation ----
  # UNKNOWN never actuates: the absence of evidence is not evidence of pressure.
  case "$STATE" in
    ORANGE)
      RED_STAGE=0
      # Cooperative only: ask the most speculative registered jobs to checkpoint
      # and shrink. Nothing is killed at ORANGE.
      shed_list
      for f in "${SHED_LIST[@]}"; do
        job_prio "$f"
        (( REPLY >= 7 )) || continue
        signal_job "$f" USR1
      done
      ;;
    RED)
      # Staged. Stage 1: everyone checkpoints. Stage 2: TERM the single most
      # speculative restartable job. Stage 3: TERM the next. Never SIGKILL a job
      # that has not first had a TERM and a grace period; never touch anything
      # unregistered or protected.
      # The ladder climbs one rung per poll that carries NEW evidence and is not a
      # USR2 wake-up (R5: a critical-event storm took a job from its stage-1 USR1 to
      # its stage-3 TERM in 0.48 s, against >= 2 x POLL by design). Entering RED takes
      # stage 1 at once, whatever the poll.
      if (( RED_STAGE == 0 )) || (( POLL_FRESH && ! WAKE_POLL )); then (( RED_STAGE++ ))
      else
        RED_STAGE_HELD=1
      fi
      shed_list
      if (( RED_STAGE_HELD )); then
        RED_STAGE_HELD=0                              # this poll is no new rung
      elif (( RED_STAGE == 1 )); then
        for f in "${SHED_LIST[@]}"; do signal_job "$f" USR1; done
        emit "🔴 GUARDIAN RED stage1: all registered jobs asked to checkpoint"
      elif (( RED_STAGE >= 3 )); then
        local _now=$EPOCHSECONDS _jpid _jstart _jname
        for f in "${SHED_LIST[@]}"; do
          read_envelope "$f" || continue
          [[ "${EV[can_restart]:-}" == "1" ]] || continue
          _jpid=${EV[pid]:-}
          _jstart=${EV[started]:-}; is_uint "$_jstart" || _jstart=""
          _jname=${EV[name]:-}

          # SETTLING GRACE. The gate accepted this job's declared envelope; it may
          # not be evicted while it is still reaching it.
          if [[ -n "$_jstart" ]] && (( _now - _jstart < GRACE_SETTLE )); then
            emit "🔴 GUARDIAN RED stage${RED_STAGE}: '$_jname' is settling ($(( _now - _jstart ))s < ${GRACE_SETTLE}s) — not evicting a job for filling the envelope admission accepted"
            continue
          fi

          # ONE TERM PER DECISION. A pid already inside its TERM grace is being
          # asked to die; re-signalling it does not make it die faster.
          # ${TERMED_AT[$_jpid]:-}, never ${TERMED_AT[$_jpid]}: the key does not exist
          # until the first TERM, and under this file's `set -u` reading it killed the
          # daemon the first time stage 3 tried to evict anything -- 16 launchd
          # respawns on 2026-09-15, each dying at this line ("parameter not set").
          if [[ -n "$_jpid" && -n "${TERMED_AT[$_jpid]:-}" ]] \
             && (( _now - ${TERMED_AT[$_jpid]:-0} < GRACE_TERM )); then
            continue
          fi

          if signal_job "$f" TERM; then
            [[ -n "$_jpid" ]] && TERMED_AT[$_jpid]=$_now
            emit "🔴 GUARDIAN RED stage${RED_STAGE}: terminated '$_jname' to relieve pressure"
            break
          fi
        done
        RED_STAGE=1
      fi
      ;;
  esac

  cancel_latency_check
  notify_checks
  smart_tick
  if (( EPOCHSECONDS >= HK_NEXT )); then housekeeping; HK_NEXT=$(( EPOCHSECONDS + 600 )); fi
  rotate_logs
  poll_sleep
done
