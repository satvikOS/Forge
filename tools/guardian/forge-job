#!/bin/zsh
# forge-job — run a heavy command under Guardian supervision.
#   forge-job --name build-kernel --priority 5 --peak-gb 6 [--restartable] [--need green] -- cmd args...
# Registers an envelope so Guardian can shed THIS job (and only registered jobs)
# under pressure, then deregisters on exit no matter how the command ends.
set -u
STATE_DIR=${FORGE_HEALTH_DIR:-$HOME/.forge-health}
JOBS_DIR="$STATE_DIR/jobs"; mkdir -p "$JOBS_DIR"
NAME="job"; PRIO=5; PEAK=2; RESTART=0; NEED=green; GPU=0
while (( $# )); do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --priority) PRIO="$2"; shift 2 ;;
    --peak-gb) PEAK="$2"; shift 2 ;;
    --restartable) RESTART=1; shift ;;
    --gpu) GPU=1; shift ;;
    --need) NEED="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
(( $# )) || { print -u2 "forge-job: no command given"; exit 2; }

"$STATE_DIR/bin/forge-gate" --need "$NEED" --wait 900 --why "$NAME" || exit 75   # EX_TEMPFAIL

JF="$JOBS_DIR/$$.job"
cleanup() { rm -f "$JF"; }
trap cleanup EXIT INT TERM
cat > "$JF" <<J
pid=$$
name=$NAME
priority=$PRIO
can_restart=$RESTART
peak_gb=$PEAK
gpu=$GPU
started=$(date +%s)
cmd=$*
J
# Run the command as a CHILD and forward Guardian's signals to it.
#
# Guardian's stage-1 shed is SIGUSR1, documented in forge-guardian as "checkpoint
# now and reduce your footprint" -- the COOPERATIVE step before the coercive TERM.
# The default disposition of SIGUSR1 is *terminate*, so a wrapper that does not trap
# it dies on the politest signal in the system and takes the job with it, before the
# job can checkpoint. Measured 2026-09-14: guardian.log "shed sig=USR1 ->
# job='knowing-v1-lora' pid=78851" at 17:31:57 and the trainer recording rc=158
# (128+30, SIGUSR1) in the same second; 'measure-red' shows the same shape with a
# USR1 at 17:21:22 and a different pid under the same name 22s later. Every job
# registered through this wrapper had that property, which is a large part of why
# "registered jobs" read 0 all session: jobs registered, were asked to checkpoint,
# and died.
"$@" &
CHILD=$!
forward_usr1() { kill -USR1 "$CHILD" 2>/dev/null }
forward_term() { kill -TERM "$CHILD" 2>/dev/null }
trap forward_usr1 USR1
trap forward_term TERM INT
rc=0
while :; do
  wait "$CHILD"; rc=$?
  kill -0 "$CHILD" 2>/dev/null || break   # a signal interrupted wait; child lives, resume
done
cleanup
exit $rc
