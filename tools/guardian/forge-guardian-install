#!/bin/zsh
# ============================================================================
# forge-guardian-install — install, upgrade, roll back or remove the Forge Guardian.
#
#   forge-guardian-install install|upgrade [--from DIR] [--no-service] [--run-tests] [--dry-run]
#   forge-guardian-install rollback [--no-service]
#   forge-guardian-install uninstall [--purge] [--no-service]
#   forge-guardian-install status
#
# exit: 0 done; 1 failed (a failed install/rollback is rolled back to the state before
# the run); 2 usage or refused; 3 another install holds the lock; 4 INSTALLED and
# running, but its evidence did not become complete within FORGE_GUARDIAN_EVIDENCE_S
# (left running: see "service verification"); 70 internal error.
#
# Every path derives from $FORGE_GUARDIAN_HOME (default $HOME); launchctl is
# $FORGE_GUARDIAN_LAUNCHCTL (default /bin/launchctl). The gates point both at a fake
# home and a stub, and this file refuses to drive the REAL launchd for any home that
# is not the user's own (the label is per-user: that would replace the live service).
#
# LAYOUT
#   $APP = ~/Library/Application Support/ForgeGuardian
#   $APP/releases/<version>/{bin/*, share/*, MANIFEST.json}   immutable (files 0555/0444)
#   $APP/current, $APP/previous                               symlinks, switched by rename
#   ~/.forge-health/bin/<tool>  -> $APP/current/bin/<tool>     (symlinks, never files)
#   ~/.local/bin/{forge-job,forge-gate,forge-nproc,forge-guardian-ctl} -> ~/.forge-health/bin/<tool>
#   ~/Library/LaunchAgents/com.archdisc.forge.guardian.plist  (generated for this user)
#
# NEVER WRITE INTO AN EXISTING FILE IN PLACE. zsh reads a script incrementally while it
# runs: the live archie-sidecar wrapper is executing ~/.forge-health/bin/forge-job right
# now, and overwriting those bytes would splice new code into a running wrapper. Every
# switch here is a rename(2) of a complete new file or symlink; a running script keeps
# the inode it opened.
#
# version = <VERSION>+<first 12 hex of sha256 over the sorted "path sha256" lines of the
# release files>. The sensor binary is NOT hashed when it is built here: a clang build
# is not guaranteed byte-reproducible (debug-map object mtimes, linker UUIDs), so its
# line is "src/sensor <sha256 over the sorted 'path sha256' lines of sensor/ sources>".
# A prebuilt sensor ($FORGE_GUARDIAN_SENSOR_PREBUILT) is hashed as the binary it is.
# Identical inputs => identical version => a second install is a no-op.
# ============================================================================
set -u
setopt NULL_GLOB EXTENDED_GLOB PIPE_FAIL
zmodload zsh/datetime || { print -u2 "forge-guardian-install: zsh/datetime unavailable"; exit 70; }
zmodload -F zsh/stat b:zstat || { print -u2 "forge-guardian-install: zsh/stat unavailable"; exit 70; }
zmodload zsh/system 2>/dev/null     # sysopen -o nonblock (preflight requires the module)
umask 077
export LC_ALL=C      # deterministic sort order for the version hash, whatever the caller's locale

VERSION=2.0.0
SELF=${0:A}
H=${FORGE_GUARDIAN_HOME:-$HOME}
H=${H%/}
APP="$H/Library/Application Support/ForgeGuardian"
FH="$H/.forge-health"
LA="$H/Library/LaunchAgents"
LABEL=com.archdisc.forge.guardian
PLIST="$LA/$LABEL.plist"
LOCALBIN="$H/.local/bin"
LAUNCHCTL=${FORGE_GUARDIAN_LAUNCHCTL:-/bin/launchctl}
TARGET="gui/$UID"
PLUTIL=/usr/bin/plutil
VERIFY_S=${FORGE_GUARDIAN_VERIFY_S:-40}
EVIDENCE_S=${FORGE_GUARDIAN_EVIDENCE_S:-120}
# The Law-7 directory the governor publishes into (the plist sets no ARCHIE_HEALTH_DIR,
# so the service uses the default).
AH_DIR=${ARCHIE_HEALTH_DIR:-/tmp/archie_health}
ZSH_TOOLS=(forge-guardian forge-gate forge-job forge-nproc forge-guardian-ctl forge-guardian-install
           forge-stallguard forge-guardian-selftest forge-guardian-actuator-test)
ALL_TOOLS=($ZSH_TOOLS forge-guardian-sensor)
SHARE=(policy.default.json SCHEMA.md)
LOCAL_TOOLS=(forge-job forge-gate forge-nproc forge-guardian-ctl)
DEFAULT_TESTS=(forge_job_usage_gate.sh forge_job_usr1_gate.sh forge_job_admission_gate.sh
               guardian_red_survival_gate.sh governor_policy_gate.sh)

say()  { print -r -- "forge-guardian-install: $*"; }
warn() { print -u2 -r -- "forge-guardian-install: WARNING: $*"; }
die()  { local c=$1; shift; print -u2 -r -- "forge-guardian-install: $*"; exit $c; }

usage() {
  print -r -- "usage: forge-guardian-install install|upgrade [--from DIR] [--no-service] [--run-tests] [--dry-run]"
  print -r -- "       forge-guardian-install rollback [--no-service]"
  print -r -- "       forge-guardian-install uninstall [--purge] [--no-service]"
  print -r -- "       forge-guardian-install status"
  print -r -- "env:   FORGE_GUARDIAN_HOME (default \$HOME), FORGE_GUARDIAN_LAUNCHCTL (default /bin/launchctl),"
  print -r -- "       FORGE_GUARDIAN_SENSOR_PREBUILT (a sensor binary to install instead of building one),"
  print -r -- "       FORGE_GUARDIAN_VERIFY_S (service verification budget, default 40),"
  print -r -- "       FORGE_GUARDIAN_EVIDENCE_S (how long install waits for complete evidence, default 120)"
  print -r -- "exit:  0 done, 1 failed and rolled back, 2 usage/refused, 3 locked,"
  print -r -- "       4 installed and running but evidence incomplete (left running), 70 internal"
}

# ---- helpers --------------------------------------------------------------------
json_str() {   # a JSON string literal, correctly escaped
  local s=$1 out="" c i
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  if [[ $s == *[[:cntrl:]]* ]]; then
    for (( i = 1; i <= ${#s}; i++ )); do
      c=${s[i]}
      if [[ $c == [[:cntrl:]] ]]; then out+=$(printf '\\u%04x' "'$c"); else out+=$c; fi
    done
    s=$out
  fi
  print -rn -- "\"$s\""
}
mtime_of() { local -a m; zstat -A m +mtime -- "$1" 2>/dev/null && print -r -- $m[1] || print 0; }
sha_of()   { local o; o=$(/usr/bin/shasum -a 256 -- "$1" 2>/dev/null) || return 1; print -r -- ${o[1,64]}; }
sha_str()  { local o; o=$(print -rn -- "$1" | /usr/bin/shasum -a 256) || return 1; print -r -- ${o[1,64]}; }
iso_now()  { TZ=UTC strftime '%Y-%m-%dT%H:%M:%SZ' $EPOCHSECONDS; }
# Atomic symlink switch: build the new link beside the old one, then rename over it.
# `mv -h` renames the link itself even when it points at a directory.
swap_link() {   # swap_link <link> <target>
  local tmp="${1:h}/.${1:t}.new.$$"
  /bin/rm -f "$tmp" && /bin/ln -s "$2" "$tmp" && /bin/mv -fh "$tmp" "$1"
}
# Atomic file install: copy beside, set the mode, rename over.
place_file() {  # place_file <src> <dest> <mode>
  local tmp="${2:h}/.${2:t}.new.$$"
  /bin/cp "$1" "$tmp" && /bin/chmod "$3" "$tmp" && /bin/mv -f "$tmp" "$2" || { /bin/rm -f "$tmp"; return 1; }
}
write_atomic() {  # write_atomic <dest> <mode> <content>
  local tmp="${1:h}/.${1:t}.new.$$"
  print -r -- "$3" > "$tmp" && /bin/chmod "$2" "$tmp" && /bin/mv -f "$tmp" "$1" || { /bin/rm -f "$tmp"; return 1; }
}
link_target() { [[ -L $1 ]] && readlink "$1"; }
release_of()   { local t; t=$(link_target "$APP/$1") || return 1; [[ -n $t ]] && print -r -- ${t:t}; }

# The user's REAL home from the directory service, never from $HOME (a test sets HOME
# to its fake home). zsh's $userdirs is filled lazily and reads EMPTY here, which once
# silently disabled this interlock. If it cannot be determined, assume the home is
# fake: refusing a service operation is recoverable, replacing the live one is not.
REAL_HOME=$(/usr/bin/dscl . -read "/Users/$USERNAME" NFSHomeDirectory 2>/dev/null)
REAL_HOME=${REAL_HOME#NFSHomeDirectory: }
real_launchctl() { [[ ${LAUNCHCTL:A} == /bin/launchctl ]]; }
fake_home()      { [[ -z $REAL_HOME || ${H:A} != ${REAL_HOME:A} ]]; }
guard_service() {
  if fake_home && real_launchctl; then
    die 2 "refusing to drive the REAL launchd for FORGE_GUARDIAN_HOME=$H (this user's home is $REAL_HOME): the label $LABEL is per-user, so this would replace the live service. Use --no-service, or FORGE_GUARDIAN_LAUNCHCTL=<stub>."
  fi
}

lc_print() { $LAUNCHCTL print "$TARGET/$LABEL" 2>/dev/null; }

# ---- the plist ------------------------------------------------------------------
gen_plist() {   # gen_plist <out.xml> ; JSON with correct escaping -> plutil xml1 -> lint
  local js="$1.json"
  {
    print -r -- "{"
    print -r -- "  \"Label\": $(json_str $LABEL),"
    print -r -- "  \"ProgramArguments\": [\"/bin/zsh\", $(json_str "$APP/current/bin/forge-guardian")],"
    print -r -- "  \"EnvironmentVariables\": {\"PATH\": \"/usr/bin:/bin:/usr/sbin:/sbin\", \"FORGE_HEALTH_DIR\": $(json_str "$FH"), \"LC_ALL\": \"C\"},"
    print -r -- "  \"RunAtLoad\": true,"
    print -r -- "  \"KeepAlive\": true,"
    print -r -- "  \"ThrottleInterval\": 30,"
    print -r -- "  \"ProcessType\": \"Standard\","
    print -r -- "  \"Nice\": 5,"
    print -r -- "  \"ExitTimeOut\": 10,"
    print -r -- "  \"StandardOutPath\": $(json_str "$FH/log/launchd.out"),"
    print -r -- "  \"StandardErrorPath\": $(json_str "$FH/log/launchd.err")"
    print -r -- "}"
  } > "$js" || return 1
  $PLUTIL -convert xml1 -o "$1" "$js" >/dev/null 2>&1 || { /bin/rm -f "$js"; return 1; }
  /bin/rm -f "$js"
  $PLUTIL -lint -s "$1" >/dev/null 2>&1 || return 1
  # Round-trip: the program path must parse back EXACTLY (quotes, &, <, > in a home).
  [[ "$($PLUTIL -extract ProgramArguments.1 raw -o - "$1" 2>/dev/null)" == "$APP/current/bin/forge-guardian" ]] || return 1
  /bin/chmod 0644 "$1"
}

# ---- service verification ---------------------------------------------------------
# A service is up only when ALL of these hold at once: launchd says running with a pid;
# that pid's argv names the program the plist names; the domain's state file was
# published after the bootstrap; and the pid holding guardian.lock is that same pid
# (exactly one governor). "A guardian is running" is not enough -- an earlier check
# passed by finding a stale second instance.
VERIFY_WHY=""
verify_service() {   # verify_service <program> <t0> <pre-mtime>
  local prog=$1 t0=$2 pre=$3 deadline=$(( EPOCHSECONDS + VERIFY_S )) out st pid args sm lk n line
  while :; do
    out=$(lc_print)
    st=$(print -r -- "$out" | sed -n 's/^	state = //p' | head -1)
    pid=$(print -r -- "$out" | sed -n 's/^	pid = \([0-9][0-9]*\)$/\1/p' | head -1)
    if [[ $st != running || -z $pid ]]; then VERIFY_WHY="launchd reports state='${st:-not loaded}' pid='${pid:-none}'"
    else
      args=$(ps -ww -o args= -p $pid 2>/dev/null)
      if [[ $args != "/bin/zsh $prog" && $args != *" $prog" && $args != "$prog" ]]; then VERIFY_WHY="pid $pid runs '$args', not $prog"
      else
        sm=$(mtime_of "$FH/state")
        if (( sm < t0 || sm <= pre )); then VERIFY_WHY="$FH/state has not been published since the bootstrap (mtime $sm < $t0)"
        else
          lk=""; [[ -r $FH/guardian.lock/pid ]] && lk=$(<$FH/guardian.lock/pid)
          if [[ $lk != $pid ]]; then VERIFY_WHY="guardian.lock is held by '${lk:-nobody}', not the service pid $pid"
          else
            n=0
            for line in ${(f)"$(ps -axww -o pid=,args= 2>/dev/null)"}; do
              [[ $line == *" $prog" ]] && (( n++ ))
            done
            if (( n != 1 )); then VERIFY_WHY="$n processes run $prog (want exactly 1)"
            else VERIFIED_PID=$pid; return 0; fi
          fi
        fi
      fi
    fi
    (( EPOCHSECONDS >= deadline )) && return 1
    sleep 0.5
  done
}

# PUBLISHING IS NOT EVIDENCE (review 2026-10-08 INS-2). verify_service passed ~0.6 s
# after bootstrap, while the governor still said UNKNOWN "evidence incomplete": an
# install whose sensor could never run reported "verified" and left heavy admission
# closed for good. So, after verify_service, wait (<= EVIDENCE_S) for state.json to
# say evidence_complete=true with a state other than UNKNOWN (the governor needs
# deescalate_polls of complete evidence to leave UNKNOWN). Outcomes:
#   0  complete evidence, state EVIDENCE_STATE;
#   4  the service runs and publishes but its evidence stayed incomplete
#      (EVIDENCE_WHY names what is missing). NOT rolled back: the v1 it would roll back
#      to fabricated health (thermal defaulted to 100, GREEN on every start and stop),
#      which is less safe than a governor that keeps the gates closed and says why;
#   1  the service stopped running or stopped publishing (VERIFY_WHY) -> roll back.
EVIDENCE_WHY=""; EVIDENCE_STATE=""
policy_poll_s() {   # the governor's poll from policy.env (1..60), default 5
  local line p=5
  if [[ -f $FH/policy.env ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == poll_s=<1-60> ]] && { p=${line#poll_s=}; break; }
    done < "$FH/policy.env"
  fi
  print -r -- $p
}
verify_evidence() {
  local deadline=$(( EPOCHSECONDS + EVIDENCE_S )) out st pid sm lim ec state reason miss
  lim=$(( 3 * $(policy_poll_s) + 10 ))
  while :; do
    out=$(lc_print)
    st=$(print -r -- "$out" | sed -n 's/^	state = //p' | head -1)
    pid=$(print -r -- "$out" | sed -n 's/^	pid = \([0-9][0-9]*\)$/\1/p' | head -1)
    if [[ $st != running || -z $pid ]]; then
      VERIFY_WHY="stopped running while its evidence was awaited (launchd state='${st:-not loaded}')"; return 1
    fi
    sm=$(mtime_of "$FH/state")
    if (( EPOCHSECONDS - sm > lim )); then
      VERIFY_WHY="stopped publishing while its evidence was awaited: $FH/state is $(( EPOCHSECONDS - sm ))s old (> ${lim}s)"; return 1
    fi
    ec=""; state=""; reason=""; miss=""
    if [[ -f $FH/state.json ]]; then
      ec=$($PLUTIL -extract evidence_complete raw -o - "$FH/state.json" 2>/dev/null)
      state=$($PLUTIL -extract state raw -o - "$FH/state.json" 2>/dev/null)
      reason=$($PLUTIL -extract reason raw -o - "$FH/state.json" 2>/dev/null)
      miss=$($PLUTIL -extract evidence.missing json -o - "$FH/state.json" 2>/dev/null)
      miss=${${miss//[\[\]\"[:space:]]/}//,/ }
    fi
    if [[ $ec == true && -n $state && $state != UNKNOWN ]]; then EVIDENCE_STATE=$state; return 0; fi
    if [[ $ec == true ]]; then EVIDENCE_WHY="the evidence is complete but the state is still ${state:-?} ($reason)"
    else EVIDENCE_WHY="${miss:-not reported} (state ${state:-?}: ${reason:-?})"; fi
    (( EPOCHSECONDS >= deadline )) && return 4
    sleep 1
  done
}

# THE CUTOVER IS NOT EVIDENCE EITHER (review 2026-10-08 INS-3). v1's TERM trap
# publishes GREEN "guardian stopped" -- heavy_jobs_ok=true, a FRESH ts and epoch -- into
# state.json and the Law-7 status.json, and back-dates only the `state` file. forge-gate
# fails closed on that mtime, but every reader of the JSON alone (forge-nproc,
# forge_law7.admission_blocked, the app) saw GREEN until v2's first publication. Only
# the installer stands between the two governors, so after EVERY bootout and before
# anything is bootstrapped it publishes UNKNOWN itself: state.json and status.json
# (atomic tmp+rename; the Law-7 directory only when it is a real directory owned by
# this user, the governor's rule) and `state`, back-dated so forge-gate keeps failing
# closed and the new governor's upgrade-window guard (fresh `state` = "already
# governed") does not refuse to start. Never while a live governor holds the lock: its
# publication is the truth, not ours.
#
# Process start as EPOCH seconds: ps prints lstart in UTC here and it is parsed back in
# UTC (C locale), so neither the caller's time zone nor a DST fold enters. Comparing the
# lstart TEXT is what made a caller in another TZ call a live governor "reused" (review
# 2026-10-08 FO-4, round 2); guardian.lock/pstart (epoch, written by the v2 governor) is
# compared this way, ±1 s -- as the sensor, forge-gate, forge-nproc and ctl do.
proc_pstart() {   # proc_pstart <pid> -> REPLY = start epoch second; 1 if not running
  local s; REPLY=""
  s=$(TZ=UTC ps -p $1 -o lstart= 2>/dev/null); s=${(j: :)${=s}}
  [[ -n $s ]] || return 1
  local TZ=UTC v=""
  strftime -r -s v '%a %b %d %H:%M:%S %Y' "$s" 2>/dev/null
  REPLY=$v
  [[ $REPLY == <-> ]]
}
same_start() {    # same_start <pid> <epoch>: the pid's process started in that second (±1)
  [[ $2 == <-> ]] && proc_pstart $1 && (( REPLY - $2 <= 1 && $2 - REPLY <= 1 ))
}
proc_args() { local a; a=$(ps -ww -p $1 -o args= 2>/dev/null); print -r -- ${a%%[[:space:]]##}; }
lock_holder() {   # prints the pid of a LIVE governor holding $FH/guardian.lock (canonical pid, start, argv)
  local p s now ps_
  [[ -f $FH/guardian.lock/pid ]] || return 1
  p=$(<"$FH/guardian.lock/pid"); p=${p//[[:space:]]/}
  [[ $p == [1-9][0-9](#c0,4) ]] && kill -0 $p 2>/dev/null || return 1
  [[ $(proc_args $p) == (*/|)forge-guardian ]] || return 1
  # A pstart that is present is the identity: an unreadable or non-epoch one proves
  # nothing and is never a reason to fall back to the weaker text (the sensor's
  # governor_check rule). Only a lock WITHOUT pstart -- a v1 governor's -- uses `started`.
  if [[ -e $FH/guardian.lock/pstart || -L $FH/guardian.lock/pstart ]]; then
    [[ -f $FH/guardian.lock/pstart && ! -L $FH/guardian.lock/pstart ]] || return 1
    ps_=$(<"$FH/guardian.lock/pstart"); ps_=${ps_//[[:space:]]/}
    [[ $ps_ == [1-9][0-9](#c0,11) ]] || return 1
    same_start $p $ps_ || return 1                     # TZ-safe: epoch seconds
  else                                                  # an older lock: lstart text only
    [[ -f $FH/guardian.lock/started ]] || return 1
    s=$(<"$FH/guardian.lock/started"); s=${(j: :)${=s}}
    [[ -n $s ]] || return 1
    now=$(ps -p $p -o lstart= 2>/dev/null); now=${(j: :)${=now}}
    [[ $now == "$s" ]] || return 1
  fi
  print -r -- $p
}
law7_dir_ok() {
  # A fake home (a test) that did not name its own Law-7 directory must never write
  # the workstation's /tmp/archie_health.
  if [[ -z ${ARCHIE_HEALTH_DIR:-} ]] && fake_home; then return 1; fi
  [[ -d $AH_DIR && ! -L $AH_DIR ]] || return 1          # absent: nothing to neutralize
  local -A st
  zstat -L -H st -- "$AH_DIR" 2>/dev/null && (( st[uid] == UID ))
}
pub_atomic() {   # pub_atomic <path> <content>: SCHEMA §2 <name>.tmp.<pid> + rename
  local tmp="$1.tmp.$$"
  print -r -- "$2" >| "$tmp" 2>/dev/null && /bin/mv -f "$tmp" "$1" || { /bin/rm -f "$tmp"; return 1; }
}
publish_unknown() {   # publish_unknown <reason> [<frozen pid> fresh]
  # With a frozen pid: that SIGSTOPped old governor may still hold the lock -- it can
  # no longer publish, and is about to be killed -- and `state` is left FRESH (not
  # back-dated) so that a launchd KeepAlive respawn of it in the next milliseconds
  # finds the domain governed and refuses (exit 3) before it installs its GREEN trap.
  local holder
  [[ -d $FH && ! -L $FH ]] || return 0
  if holder=$(lock_holder) && [[ $holder != ${2:-none} ]]; then
    warn "a governor (pid $holder) still holds $FH/guardian.lock; its publication is left alone"; return 0
  fi
  local now=$EPOCHSECONDS iso r f line k v pid gpu jobs=0 gjobs=0 halt=false ram ncpu nperf fd
  iso=$(TZ=UTC strftime '%Y-%m-%dT%H:%M:%SZ' $now)
  r=$(json_str "$1")
  # registered_jobs / gpu_jobs as the governor counts them: envelopes (regular files
  # only, read without blocking) whose pid is alive. A 0 would read as "GPU idle".
  for f in "$FH"/jobs/*.job(N.); do
    pid=""; gpu=""
    sysopen -r -o nonblock -u fd "$f" 2>/dev/null || continue
    while IFS= read -r -u $fd line; do
      k=${line%%=*}; v=${line#*=}
      [[ $k == pid && -z $pid ]] && pid=$v
      [[ $k == gpu && -z $gpu ]] && gpu=$v
      [[ -n $pid && -n $gpu ]] && break
    done
    exec {fd}<&-
    [[ $pid == [1-9][0-9](#c0,4) ]] && kill -0 $pid 2>/dev/null || continue
    (( jobs++ )); [[ $gpu == 1 ]] && (( gjobs++ ))
  done
  ram=$(( $(sysctl -n hw.memsize 2>/dev/null || print 0) / 1073741824 ))
  ncpu=$(sysctl -n hw.ncpu 2>/dev/null); [[ $ncpu == <-> ]] || ncpu=-1
  nperf=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null); [[ $nperf == <-> ]] || nperf=-1
  pub_atomic "$FH/state.json" "{
  \"schema\": \"forge.guardian.state/2\",
  \"state\": \"UNKNOWN\",
  \"reason\": $r,
  \"ts\": \"$iso\",
  \"epoch\": $now,
  \"seq\": 0,
  \"build_jobs_max\": 2,
  \"spawn_agents_ok\": false,
  \"evidence_complete\": false,
  \"heavy_jobs_ok\": false,
  \"evidence\": {\"source\": \"fallback\", \"sensor_age_s\": -1, \"missing\": [\"guardian\"]},
  \"critical_now\": false,
  \"thermal_state\": \"none\",
  \"admission\": {\"heavy_open\": false, \"reason\": $r},
  \"reservations\": {\"reserved_gb\": -1, \"budget_gb\": -1, \"overcommit\": null, \"jobs\": -1},
  \"volumes\": [],
  \"disk_hardware\": \"UNKNOWN\",
  \"observables\": {
    \"vm_pressure_level\": -1,
    \"free_pct\": -1,
    \"swap_used_mb\": -1,
    \"swap_total_mb\": -1,
    \"pageout_rate_pages_per_poll\": -1,
    \"disk_avail_gb\": -1,
    \"loadavg\": \"-1\",
    \"cpu_speed_limit_pct\": -1,
    \"registered_jobs\": $jobs
  },
  \"host\": {\"ram_gb\": $ram, \"ncpu\": $ncpu, \"nperf\": $nperf}
}" || warn "could not publish UNKNOWN into $FH/state.json"
  if law7_dir_ok; then
    [[ -e $AH_DIR/HALT ]] && halt=true
    pub_atomic "$AH_DIR/status.json" "{
  \"state\": \"UNKNOWN\",
  \"reason\": $r,
  \"swap_gib\": -1,
  \"halt\": $halt,
  \"gpu_jobs\": $gjobs,
  \"registered_jobs\": $jobs,
  \"free_pct\": -1,
  \"pageout_rate\": -1,
  \"disk_avail_gb\": -1,
  \"producer\": \"forge-guardian-install\",
  \"ts\": $now,
  \"iso\": \"$iso\",
  \"evidence_complete\": false
}" || warn "could not publish UNKNOWN into $AH_DIR/status.json"
  fi
  if [[ ${3:-} == fresh ]]; then
    pub_atomic "$FH/state" "UNKNOWN" || warn "could not publish UNKNOWN into $FH/state"
  else
    pub_atomic "$FH/state" "UNKNOWN" && /usr/bin/touch -t 197001020000 "$FH/state" 2>/dev/null \
      || warn "could not publish UNKNOWN into $FH/state"
  fi
  return 0
}

bootout_service() {
  local i
  $LAUNCHCTL bootout "$TARGET/$LABEL" >/dev/null 2>&1   # "not loaded" is fine
  for i in {1..40}; do lc_print >/dev/null || return 0; sleep 0.5; done
  warn "$LABEL still listed by launchd 20s after bootout"
  return 1
}

# NO STOP-TIME GREEN AT ALL (review 2026-10-08 INS-3, round 2). Publishing UNKNOWN after
# the bootout left a window: bootout TERMs the old governor, a v1 governor's TERM trap
# publishes GREEN "guardian stopped" (heavy_jobs_ok=true, fresh epoch) into state.json
# and the Law-7 status.json, and that GREEN stood for 0.07-0.38 s (measured) until the
# installer's UNKNOWN replaced it. A trap cannot run on SIGKILL. So a governor that is
# not POSITIVELY known to publish UNKNOWN when stopped (its script carries the v2 stop
# publication `publish "UNKNOWN" "guardian stopped`) is stopped like this:
#   1. its identity is proven: launchd's pid for this label, argv = the plist's program,
#      start second recorded BEFORE any file was switched (capture_service);
#   2. SIGSTOP (cannot be caught), then the identity is checked AGAIN -- a stopped
#      process keeps its pid, so what is killed below is exactly what was verified (a
#      mismatch is SIGCONTed and left to an ordinary bootout);
#   3. its whole process tree is frozen too, level by level (freeze_tree): a child it
#      forked -- a `mv` of a publication, a background publisher -- must not land a
#      GREEN after step 4, nor go on publishing once its parent is dead;
#   4. UNKNOWN is published into state.json, status.json and a FRESH `state` -- the
#      tree is frozen, so nothing of it can overwrite this; a KeepAlive respawn in the
#      next milliseconds sees a governed domain and refuses before installing its
#      GREEN trap;
#   5. SIGKILL to the frozen tree, then bootout, then publish_unknown again (back-dating
#      `state`). From step 2 on, no process of the old governor runs another instruction.
# A v2 governor is stopped by bootout as before: its TERM trap publishes UNKNOWN,
# releases its lock, records an orderly stop and stops its sensor.
CAP_PID=""; CAP_PSTART=""; CAP_ARGS=""; CAP_KIND=""; SWITCHED=0
svc_pid() {   # the pid launchd reports for this label, when running
  local out st p
  out=$(lc_print) || return 1
  st=$(print -r -- "$out" | sed -n 's/^	state = //p' | head -1)
  p=$(print -r -- "$out" | sed -n 's/^	pid = \([0-9][0-9]*\)$/\1/p' | head -1)
  [[ $st == running && $p == [1-9][0-9](#c0,4) ]] && print -r -- $p
}
gov_kind() {   # gov_kind <governor script>: v2 (publishes UNKNOWN when stopped) | legacy
  [[ -f $1 && -r $1 ]] && grep -qF 'publish "UNKNOWN" "guardian stopped' "$1" 2>/dev/null && print v2 || print legacy
}
capture_service() {   # record the running service's identity and stop behaviour -- BEFORE any switch
  local p a prog
  CAP_PID=""; CAP_PSTART=""; CAP_ARGS=""; CAP_KIND=""
  p=$(svc_pid) || return 0
  a=$(proc_args $p)
  prog=$($PLUTIL -extract ProgramArguments.1 raw -o - "$PLIST" 2>/dev/null)
  [[ -n $prog && ( $a == "/bin/zsh $prog" || $a == "$prog" ) ]] || prog=${a#/bin/zsh }
  [[ ${prog:t} == forge-guardian ]] || return 0          # not a governor: no identity to prove
  proc_pstart $p || return 0
  CAP_PID=$p; CAP_PSTART=$REPLY; CAP_ARGS=$a; CAP_KIND=$(gov_kind "${prog:A}")
}
proc_gone() { [[ $(ps -p $1 -o stat= 2>/dev/null) == (|Z*) ]]; }
proc_frozen() { [[ $(ps -p $1 -o stat= 2>/dev/null) == (|T*|Z*) ]]; }   # stopped, a zombie, or gone
# freeze_tree <root>: <root> is already SIGSTOPped and verified. Its descendants are
# stopped level by level, each level only once every process of the level above has
# reached the stopped state: a stopped process can neither fork nor reap, so every pid
# listed under it stays that same process (alive or a zombie) until it is killed --
# signalling them is identity-safe without a start-time check. A process stopped while
# inside rename(2) completes it first (stop takes effect on the way out of the kernel),
# so once the tree is stopped every publication it began has landed. Sets FROZEN
# (root first); returns 1 if some process did not reach the stopped state within ~2 s
# (e.g. blocked in uninterruptible I/O) -- reported, never ignored.
FROZEN=()
freeze_tree() {
  local -a level next; local q i tbl ok=0 depth
  FROZEN=($1); level=($1)
  for depth in {1..32}; do
    for i in {1..200}; do
      ok=1; for q in $level; do proc_frozen $q || { ok=0; break; }; done
      (( ok )) && break
      sleep 0.01
    done
    (( ok )) || { warn "pid $q of the old governor's tree did not stop within 2s"; return 1; }
    tbl=$(ps -ax -o pid=,ppid= 2>/dev/null)
    next=()
    for q in $level; do next+=(${(f)"$(print -r -- "$tbl" | awk -v p=$q '$2 == p { print $1 }')"}); done
    next=(${next:#$$})
    (( ${#next} )) || return 0
    kill -STOP $next 2>/dev/null
    FROZEN+=($next); level=($next)
  done
  warn "the old governor's process tree is deeper than 32 levels"; return 1
}
quiesce_legacy() {   # quiesce_legacy <pid> <pstart> <args> <reason>: steps 2-5 up to the bootout
  local p=$1 i
  kill -STOP $p 2>/dev/null || return 1
  # An interruption (^C, TERM, HUP) between the SIGSTOP and the SIGKILL must not leave the
  # machine with a frozen old governor and no new one: resume the frozen tree, say so, and
  # stop -- the install did not happen and the old service runs on as before.
  FROZEN=($p)
  trap 'kill -CONT $FROZEN 2>/dev/null; warn "interrupted while the old governor (pid $p) was frozen: resumed it and its tree; nothing was installed"; exit 130' INT TERM HUP
  if [[ $(proc_args $p) != "$3" ]] || ! same_start $p $2; then
    kill -CONT $p 2>/dev/null
    trap - INT TERM HUP
    warn "pid $p is no longer the governor that was verified; left to launchd's bootout"
    return 1
  fi
  freeze_tree $p || warn "publishing UNKNOWN anyway; a process of the old tree may still be running"
  publish_unknown "$4" $p fresh
  kill -KILL $FROZEN 2>/dev/null
  trap - INT TERM HUP
  for i in {1..300}; do proc_gone $p && break; sleep 0.01; done
  say "stopped the old governor (pid $p) with SIGKILL after publishing UNKNOWN: its TERM trap would have published GREEN 'guardian stopped'$( (( ${#FROZEN} > 1 )) && print " (its tree, $(( ${#FROZEN} - 1 )) more process(es), was frozen and killed with it)")"
  return 0
}
stop_service() {   # stop_service <UNKNOWN reason>: stop the service, never leaving a stop-time GREEN
  local p a kind="" pst="" rc
  if p=$(svc_pid); then
    a=$(proc_args $p)
    if [[ -n $CAP_PID && $p == $CAP_PID && $a == "$CAP_ARGS" ]] && same_start $p $CAP_PSTART; then
      kind=$CAP_KIND; pst=$CAP_PSTART
    elif [[ ${a##*/} == forge-guardian ]] && proc_pstart $p; then
      pst=$REPLY
      # Not the process captured before the switch (launchd restarted it meanwhile):
      # its script can no longer be read as it was, so it is treated as legacy -- a
      # SIGKILL leaves no GREEN, a TERM to an old governor might.
      if (( SWITCHED )); then kind=legacy; else kind=$(gov_kind "${${a#/bin/zsh }:A}"); fi
    fi
    [[ $kind == legacy ]] && quiesce_legacy $p $pst "$a" "$1"
  fi
  bootout_service; rc=$?
  publish_unknown "$1"
  return $rc
}
# bootstrap + verify. Returns 0 with VERIFIED_PID set, or 1 with VERIFY_WHY.
start_service() {
  local prog t0 pre r
  prog=$($PLUTIL -extract ProgramArguments.1 raw -o - "$PLIST" 2>/dev/null)
  pre=$(mtime_of "$FH/state"); t0=$EPOCHSECONDS
  $LAUNCHCTL bootstrap "$TARGET" "$PLIST" >/dev/null 2>"$APP/.bootstrap.err.$$"; r=$?
  if (( r != 0 )); then
    VERIFY_WHY="launchctl bootstrap failed (rc=$r): $(<$APP/.bootstrap.err.$$)"
    /bin/rm -f "$APP/.bootstrap.err.$$"; return 1
  fi
  /bin/rm -f "$APP/.bootstrap.err.$$"
  verify_service "$prog" $t0 $pre || return 1
  # The service now running is the one a later stop_service (a rollback) must stop.
  CAP_PID=$VERIFIED_PID; CAP_ARGS=$(proc_args $VERIFIED_PID); CAP_KIND=$(gov_kind "${prog:A}")
  proc_pstart $VERIFIED_PID && CAP_PSTART=$REPLY || CAP_PID=""
  return 0
}

# ---- transaction: snapshot of everything a switch changes ------------------------
typeset -A TXBIN TXMODE
TX=""; TX_CUR=""; TX_PREV=""; TX_HAD_PLIST=0; TX_HAD_INST=0; TX_LEGACY=""
# The domain directory's mode and whether policy.json existed are part of "the state
# before this run": ensure_links tightens the directory to 0700 and installs
# policy.json, and a failed run used to leave both behind while claiming to have
# restored everything (review 2026-10-08 INS-4).
TX_FH_MODE=""; TX_HAD_POLICY=1; POLICY_INSTALLED_SHA=""
tx_begin() {
  local t f
  TX="$APP/tx.$$"; /bin/rm -rf "$TX"; mkdir -p "$TX" || die 70 "cannot create $TX"
  (( NO_SERVICE )) || capture_service       # what runs NOW, read before any file is switched
  TX_CUR=$(link_target "$APP/current"); TX_PREV=$(link_target "$APP/previous")
  TX_FH_MODE=""; [[ -d $FH && ! -L $FH ]] && TX_FH_MODE=$(stat -f %Lp "$FH" 2>/dev/null)
  TX_HAD_POLICY=0; [[ -e $FH/policy.json || -L $FH/policy.json ]] && TX_HAD_POLICY=1
  POLICY_INSTALLED_SHA=""
  TX_HAD_PLIST=0; [[ -f $PLIST ]] && { /bin/cp -p "$PLIST" "$TX/plist" && TX_HAD_PLIST=1; }
  TX_HAD_INST=0; [[ -f $FH/guardian.installed.json ]] && { /bin/cp -p "$FH/guardian.installed.json" "$TX/installed.json" && TX_HAD_INST=1; }
  for t in $ALL_TOOLS; do
    f="$FH/bin/$t"
    if [[ -L $f ]]; then TXBIN[$t]="L:$(readlink "$f")"
    elif [[ -f $f ]]; then TXBIN[$t]="F"; TXMODE[$t]=$(stat -f %Lp "$f"); /bin/cp -p "$f" "$TX/bin.$t"
    else TXBIN[$t]="none"; fi
  done
}
tx_restore_files() {   # put every link, bin entry, plist and record back as it was
  local t f e
  if [[ -n $TX_CUR ]]; then swap_link "$APP/current" "$TX_CUR"; else /bin/rm -f "$APP/current"; fi
  if [[ -n $TX_PREV ]]; then swap_link "$APP/previous" "$TX_PREV"; else /bin/rm -f "$APP/previous"; fi
  for t in $ALL_TOOLS; do
    f="$FH/bin/$t"; e=${TXBIN[$t]:-none}
    case $e in
      L:*)  swap_link "$f" "${e#L:}" ;;
      F)    place_file "$TX/bin.$t" "$f" "${TXMODE[$t]:-755}" ;;
      none) [[ -L $f ]] && /bin/rm -f "$f" ;;
    esac
  done
  if (( TX_HAD_PLIST )); then place_file "$TX/plist" "$PLIST" 0644; else /bin/rm -f "$PLIST"; fi
  if (( TX_HAD_INST )); then place_file "$TX/installed.json" "$FH/guardian.installed.json" 0600; else /bin/rm -f "$FH/guardian.installed.json"; fi
  # policy.json: removed only when THIS run created it and it is still byte-for-byte
  # what was installed (an edit made meanwhile is the user's, and is kept).
  if (( ! TX_HAD_POLICY )) && [[ -n $POLICY_INSTALLED_SHA && -f $FH/policy.json && ! -L $FH/policy.json ]] \
     && [[ "$(sha_of "$FH/policy.json")" == "$POLICY_INSTALLED_SHA" ]]; then
    /bin/rm -f "$FH/policy.json"
  fi
  [[ -n $TX_FH_MODE && -d $FH && ! -L $FH ]] && /bin/chmod "$TX_FH_MODE" "$FH"
  return 0
}
tx_end() { [[ -n $TX ]] && /bin/rm -rf "$TX"; TX=""; }

# Roll a failed switch back and restart whatever was there before. Always exits 1.
fail_and_rollback() {
  local why=$1
  print -u2 -r -- "forge-guardian-install: FAILED: $why"
  print -u2 -r -- "forge-guardian-install: rolling back to the state before this run"
  tx_restore_files
  if (( ! NO_SERVICE )); then
    stop_service "guardian rollback in progress"
    if (( TX_HAD_PLIST )); then
      if start_service; then
        print -u2 -r -- "forge-guardian-install: rolled back; the previous service is running and verified (pid $VERIFIED_PID)"
      else
        print -u2 -r -- "forge-guardian-install: rolled back the files, but the previous service did not verify either: $VERIFY_WHY"
        print -u2 -r -- "  inspect: forge-guardian-ctl diagnose"
      fi
    else
      print -u2 -r -- "forge-guardian-install: rolled back; there was no service before this run, none is loaded now"
    fi
  fi
  tx_end
  exit 1
}

# ---- links in ~/.forge-health/bin and ~/.local/bin --------------------------------
ensure_links() {   # prints what changed; returns the number of problems
  local t f want n=0
  [[ -d $FH ]] || mkdir -m 700 -p "$FH" || return 1
  /bin/chmod 700 "$FH"
  mkdir -m 700 -p "$FH/bin" "$FH/log" || return 1
  for t in $ALL_TOOLS; do
    f="$FH/bin/$t"; want="$APP/current/bin/$t"
    [[ -L $f && "$(readlink "$f")" == "$want" ]] && continue
    swap_link "$f" "$want" || { warn "could not link $f"; (( n++ )); continue; }
    say "linked $f -> $want"
  done
  if [[ ! -e $FH/policy.json && -f $APP/current/share/policy.default.json ]]; then
    place_file "$APP/current/share/policy.default.json" "$FH/policy.json" 0600 && say "installed $FH/policy.json from policy.default.json" \
      && POLICY_INSTALLED_SHA=$(sha_of "$FH/policy.json")
  fi
  mkdir -p "$LOCALBIN" 2>/dev/null
  for t in $LOCAL_TOOLS; do
    f="$LOCALBIN/$t"; want="$FH/bin/$t"
    if [[ -L $f ]]; then
      [[ "$(readlink "$f")" == "$want" ]] && continue
      swap_link "$f" "$want" && say "relinked $f -> $want"
    elif [[ -e $f ]]; then
      warn "$f is a regular file, not replaced; it should be a symlink to $want (RUNBOOK §0)"
    else
      swap_link "$f" "$want" && say "linked $f -> $want"
    fi
  done
  return $n
}

# ---- staging ----------------------------------------------------------------------
STG=""; BUILD=""
cleanup_staging() { [[ -n $STG ]] && /bin/rm -rf "$STG"; [[ -n $BUILD ]] && /bin/rm -rf "$BUILD"; STG=""; BUILD=""; return 0; }

sensor_src_digest() {   # sha256 over sorted "path sha256" lines of $FROM/sensor sources
  local f rel lines=""
  local -a files; files=("$FROM"/sensor/**/*(.N))
  for f in ${(o)files}; do
    rel=${f#$FROM/}
    [[ $rel == sensor/build/* || $rel == */.* || $rel == *.o ]] && continue
    lines+="$rel $(sha_of "$f")"$'\n'
  done
  [[ -n $lines ]] || return 1
  sha_str "$lines"
}

stage_release() {   # sets STG, V, BASIS, MANIFEST_FILES
  local t f out lines="" rel h
  STG="$APP/staging.$$"
  /bin/rm -rf "$STG"; mkdir -p "$STG/bin" "$STG/share" || die 70 "cannot create $STG"
  for t in $ZSH_TOOLS; do /bin/cp "$FROM/$t" "$STG/bin/$t" || die 70 "copy failed: $FROM/$t"; done
  for t in $SHARE; do /bin/cp "$FROM/$t" "$STG/share/$t" || die 70 "copy failed: $FROM/$t"; done
  if [[ -n ${FORGE_GUARDIAN_SENSOR_PREBUILT:-} ]]; then
    /bin/cp "$FORGE_GUARDIAN_SENSOR_PREBUILT" "$STG/bin/forge-guardian-sensor" || die 70 "cannot copy the prebuilt sensor"
    BASIS=binary
  else
    BUILD="$APP/build.$$"; /bin/rm -rf "$BUILD"; mkdir -p "$BUILD"
    say "building the sensor: $FROM/sensor/build.sh --out $BUILD"
    out=$("$FROM/sensor/build.sh" --out "$BUILD" 2>"$BUILD.log") || { cat "$BUILD.log" >&2; /bin/rm -f "$BUILD.log"; die 1 "sensor build failed"; }
    /bin/rm -f "$BUILD.log"
    f="$BUILD/forge-guardian-sensor"
    [[ -x $f ]] || f=${${(f)out}[-1]}
    [[ -n $f && -x $f ]] || die 1 "sensor build produced no executable (looked for $BUILD/forge-guardian-sensor and '$f')"
    /bin/cp "$f" "$STG/bin/forge-guardian-sensor" || die 70 "cannot copy the built sensor"
    BASIS=sources
  fi
  /bin/chmod 0755 "$STG" "$STG/bin" "$STG/share"
  /bin/chmod 0555 "$STG"/bin/*
  /bin/chmod 0444 "$STG"/share/*
  # version
  typeset -gA MANIFEST_FILES; MANIFEST_FILES=()
  for f in "$STG"/bin/*(.) "$STG"/share/*(.); do
    rel=${f#$STG/}
    MANIFEST_FILES[$rel]=$(sha_of "$f") || die 70 "cannot hash $f"
  done
  for rel in ${(ko)MANIFEST_FILES}; do
    if [[ $rel == bin/forge-guardian-sensor && $BASIS == sources ]]; then
      h=$(sensor_src_digest) || die 70 "cannot hash the sensor sources"
      lines+="src/sensor $h"$'\n'
    else
      lines+="$rel ${MANIFEST_FILES[$rel]}"$'\n'
    fi
  done
  h=$(sha_str "$lines") || die 70 "cannot hash the release"
  V="$VERSION+${h[1,12]}"
}

validate_staging() {
  local t out r tmpd
  for t in $ZSH_TOOLS; do
    /bin/zsh -n "$STG/bin/$t" 2>"$STG.err" || { cat "$STG.err" >&2; /bin/rm -f "$STG.err"; return 1; }
  done
  /bin/rm -f "$STG.err"
  out=$("$STG/bin/forge-guardian-sensor" --version 2>&1) || { print -u2 -r -- "sensor --version failed: $out"; return 1; }
  say "staged sensor: $out"
  tmpd=$(mktemp -d "${TMPDIR:-/tmp}/fginstall-snap.XXXXXX") || return 1
  out=$("$STG/bin/forge-guardian-sensor" snapshot --state-dir "$tmpd" 2>/dev/null); r=$?
  /bin/rm -rf "$tmpd"
  (( r == 0 )) || { print -u2 -r -- "sensor snapshot exited $r"; return 1; }
  [[ "$(print -r -- "$out" | $PLUTIL -extract schema raw -o - - 2>/dev/null)" == forge.guardian.sensor/* ]] \
    || { print -u2 -r -- "sensor snapshot is not a forge.guardian.sensor JSON document: ${out[1,120]}"; return 1; }
  return 0
}

# --run-tests: the hermetic gates against the STAGED files. The gates find the tools as
# ${0:A:h}/../<tool>, so they run from a flat copy of the staged bin/ with test/ beside it.
# The sensor is left out of that copy on purpose: the forge-job gates exercise the
# legacy (forge-gate) path and inject their own stub sensor where they need one.
run_staged_tests() {
  local rt g pid rc i log failed=0 budget=${FORGE_GUARDIAN_TEST_TIMEOUT:-600} f
  local -a tests; tests=(${=${FORGE_GUARDIAN_INSTALL_TESTS:-$DEFAULT_TESTS}})
  [[ -d $FROM/test ]] || { print -u2 -r -- "--run-tests: no $FROM/test"; return 1; }
  rt=$(mktemp -d "${TMPDIR:-/tmp}/fginstall-tests.XXXXXX") || return 1
  mkdir -p "$rt/test"
  for f in "$STG"/bin/*(.); do [[ ${f:t} == forge-guardian-sensor ]] || /bin/cp -p "$f" "$rt/${f:t}"; done
  /bin/chmod u+w "$rt"/*(.)
  /bin/cp -p "$STG"/share/*(.) "$rt/"
  for f in "$FROM"/test/*(.); do /bin/cp -p "$f" "$rt/test/${f:t}"; done
  for g in $tests; do
    [[ -f $rt/test/$g ]] || { say "--run-tests: $g not present, skipped"; continue; }
    log="$rt/$g.log"
    env -u FORGE_HEALTH_DIR -u FORGE_GUARDIAN_SENSOR_BIN FJ_SKIP_COMPANIONS=1 /bin/zsh "$rt/test/$g" >"$log" 2>&1 &
    pid=$!
    for (( i = 0; i < budget * 2; i++ )); do kill -0 $pid 2>/dev/null || break; sleep 0.5; done
    if kill -0 $pid 2>/dev/null; then kill -TERM $pid 2>/dev/null; sleep 1; kill -KILL $pid 2>/dev/null; rc=TIMEOUT
    else wait $pid; rc=$?; fi
    if [[ $rc == 0 ]]; then say "--run-tests: PASS $g ($(grep -Eo '[0-9]+ passed, [0-9]+ failed' "$log" | tail -1))"
    else
      failed=1
      print -u2 -r -- "forge-guardian-install: --run-tests: FAIL $g (rc=$rc); last lines:"
      tail -15 "$log" | sed 's/^/    /' >&2
    fi
  done
  /bin/rm -rf "$rt"
  return $failed
}

write_manifest() {   # write_manifest <release-dir>
  local rel body="" first=1 commit
  for rel in ${(ko)MANIFEST_FILES}; do
    (( first )) || body+=","$'\n'
    first=0
    body+="    $(json_str $rel): $(json_str ${MANIFEST_FILES[$rel]})"
  done
  write_atomic "$1/MANIFEST.json" 0444 "{
  \"schema\": \"forge.guardian.manifest/1\",
  \"version\": $(json_str $V),
  \"source_commit\": $(json_str $SOURCE_COMMIT),
  \"built_at\": $(json_str "$(iso_now)"),
  \"version_basis\": $(json_str "$([[ $BASIS == sources ]] && print 'bin/* and share/* by content; sensor by its sources (src/sensor)' || print 'bin/* and share/* by content')"),
  \"files\": {
$body
  }
}"
}

manifest_matches() {   # manifest_matches <release-dir> : every MANIFEST file hash still holds
  local d=$1 rel want
  [[ -r $d/MANIFEST.json ]] || return 1
  for rel in ${(k)MANIFEST_FILES}; do
    want=$($PLUTIL -extract "files.${rel//./\\.}" raw -o - "$d/MANIFEST.json" 2>/dev/null) || return 1
    [[ $want == $(sha_of "$d/$rel") ]] || return 1
  done
  return 0
}

write_installed() {   # write_installed <version> <previous>
  local psha; psha=$(sha_of "$PLIST" 2>/dev/null) || psha=""
  write_atomic "$FH/guardian.installed.json" 0600 "{
  \"schema\": \"forge.guardian.installed/1\",
  \"version\": $(json_str $1),
  \"release\": $(json_str "$APP/releases/$1"),
  \"installed_at\": $(json_str "$(iso_now)"),
  \"source_commit\": $(json_str ${SOURCE_COMMIT:-unknown}),
  \"plist_sha256\": $(json_str $psha),
  \"previous\": $([[ -n $2 ]] && json_str $2 || print -rn null)
}"
}

source_commit_of() {
  local c d
  command -v git >/dev/null 2>&1 || { print -r -- unknown; return; }
  c=$(git -C "$FROM" rev-parse HEAD 2>/dev/null) || { print -r -- unknown; return; }
  d=$(git -C "$FROM" status --porcelain -- . 2>/dev/null)
  print -r -- "$c${d:+-dirty}"
}

take_lock() {
  zmodload zsh/system 2>/dev/null || die 70 "zsh/system unavailable"
  mkdir -p "$APP" && /bin/chmod 755 "$APP" || die 70 "cannot create $APP"
  [[ -e $APP/.install.lock ]] || : >> "$APP/.install.lock"     # flock needs an existing file
  zsystem flock -t 0 -f LOCKFD "$APP/.install.lock" 2>/dev/null \
    || die 3 "another forge-guardian-install holds $APP/.install.lock"
}

preflight() {
  [[ $OSTYPE == darwin* ]] || die 1 "preflight: not macOS ($OSTYPE)"
  (( EUID != 0 )) || die 1 "preflight: do not run as root (a LaunchAgent belongs to the user)"
  local m t
  for m in zsh/system zsh/datetime zsh/stat zsh/files; do
    /bin/zsh -c "zmodload $m" 2>/dev/null || die 1 "preflight: zsh module $m does not load"
  done
  [[ -x $PLUTIL ]] || die 1 "preflight: $PLUTIL missing"
  [[ -x /usr/bin/shasum ]] || die 1 "preflight: /usr/bin/shasum missing"
  for t in $ZSH_TOOLS $SHARE; do [[ -f $FROM/$t ]] || die 1 "preflight: $FROM/$t missing"; done
  if [[ -n ${FORGE_GUARDIAN_SENSOR_PREBUILT:-} ]]; then
    [[ -f $FORGE_GUARDIAN_SENSOR_PREBUILT && -x $FORGE_GUARDIAN_SENSOR_PREBUILT ]] || die 1 "preflight: FORGE_GUARDIAN_SENSOR_PREBUILT=$FORGE_GUARDIAN_SENSOR_PREBUILT is not executable"
  else
    [[ -x $FROM/sensor/build.sh ]] || die 1 "preflight: no sensor sources ($FROM/sensor/build.sh); set FORGE_GUARDIAN_SENSOR_PREBUILT to install a built sensor"
  fi
  [[ -d $H ]] || die 1 "preflight: home $H does not exist"
}

# ---- reservation preflight: REPORT ONLY ----------------------------------------------
# v2 admission holds every LIVE envelope's reservation, max(declared peak_gb, measured),
# against the heavy budget RAM - memory.os_reserve_gb (SCHEMA §9.1). A live envelope
# whose declaration ALONE exceeds that budget closes heavy admission for as long as it
# is registered -- measured on this workstation: the archie-sidecar's v1 envelope
# declares 31 GiB against a 36 - 6 = 30 GiB budget. That is the engine working as
# specified, but an install must not leave the operator to discover it as "denied".
# So install (after staging, before the cutover), install --dry-run and status say so,
# with the consequence. Nothing here writes, re-registers or signals anything. The
# envelopes are read as the engine reads them (pf_envelope and below: oversize ones
# counted, strtod for peak_gb, the registry limits); install_gate 0c compares the two.
#
# The budget must be the ENGINE's: `admit` evaluates $FH/policy.json at every call, and a
# file with ANY key outside SCHEMA §6's bounds is rejected whole (the built-in defaults
# apply). So the preflight asks a sensor -- $PF_SENSOR: the staged one in install (the
# sensor that admits after this run), else FORGE_GUARDIAN_SENSOR_PREBUILT (dry run), else
# the installed one -- `policy --state-dir $FH --env`, which IS that evaluation
# (read-only). Only when no sensor answers (a dry run from sources before the first v2
# install, a legacy current, a stand-in) is the one key reconstructed here, with the
# engine's bound 2 .. RAM-2 GiB. It was RAM/2 here while the engine accepted RAM-2, and a
# rejected value's note was overwritten: a false all-clear (review 2026-10-09, round 2).
PF_SENSOR=""
pf_sensor_default() {   # the installed release's sensor, when it is one
  local s="$APP/current/bin/forge-guardian-sensor"
  [[ -f $s && -x $s ]] && PF_SENSOR=$s
  return 0
}
os_num() {   # os_num <text>: REPLY = a plain decimal (plutil prints 33.500000), or 1
  REPLY=$1
  [[ $REPLY == <->(|.<->) ]] && (( ${#REPLY} <= 16 )) || return 1
  [[ $REPLY == *.* ]] && { REPLY=${REPLY%%0##}; REPLY=${REPLY%.}; }
  return 0
}
os_reserve_gb() {   # os_reserve_gb <RAM bytes> -> REPLY (GiB), RES_SRC
  local ramb=$1 v="" src="" out why line rc def ty pj="$FH/policy.json" cur
  local -F hi
  hi=$(( ramb / 1073741824.0 - 2 ))
  RES_SRC=""
  if [[ -n $PF_SENSOR && -f $PF_SENSOR && -x $PF_SENSOR ]]; then
    out=$("$PF_SENSOR" policy --state-dir "$FH" --env 2>/dev/null); rc=$?
    if (( rc == 0 || rc == 1 )); then
      for line in ${(f)out}; do
        case $line in
          memory_os_reserve_gb=*) v=${line#*=} ;;
          policy_source=*)        src=${line#*=} ;;
        esac
      done
      if os_num "$v"; then
        v=$REPLY
        if (( rc == 1 )); then
          why=$("$PF_SENSOR" policy --state-dir "$FH" --env 2>&1 >/dev/null)
          why=${${${why#*rejected, using defaults: }#$pj: }//$pj/policy.json}
          RES_SRC="the built-in default: the sensor rejects $pj whole (${${why//$'\n'/ }[1,160]})"
        elif [[ $src != /* ]]; then     # "builtin": no policy.json to evaluate
          RES_SRC="the built-in default: there is no $pj"
        else
          RES_SRC="$pj, as the sensor evaluates it"
        fi
        REPLY=$v; return 0
      fi
    fi
    v=""
  fi
  # No sensor answered: reconstruct the one key as load_policy does (exists -> regular
  # file -> JSON -> a NUMBER in 2 .. RAM-2), else the default.
  if [[ -e $pj || -L $pj ]]; then
    if [[ ! -f $pj ]]; then
      RES_SRC="the built-in default: $pj is not a regular file, so the sensor rejects it"
    elif ! cur=$($PLUTIL -extract memory.os_reserve_gb raw -o - "$pj" 2>/dev/null); then
      RES_SRC="the built-in default: $pj sets no memory.os_reserve_gb (or is not valid JSON)"
    elif ty=$($PLUTIL -type memory.os_reserve_gb "$pj" 2>/dev/null) && [[ $ty != (integer|float) ]] || ! os_num "$cur"; then
      RES_SRC="the built-in default: $pj sets memory.os_reserve_gb to a non-number (${ty:-?} '${cur[1,24]}'), so the sensor rejects that file whole"
    elif (( REPLY >= 2 && REPLY <= hi )); then
      RES_SRC="$pj (memory.os_reserve_gb only: no sensor answered, so the rest of the file is not validated here)"
      return 0
    else
      RES_SRC="the built-in default: $pj sets memory.os_reserve_gb=$REPLY, outside 2..$(printf '%.1f' $hi) (RAM-2), so the sensor rejects that file whole"
    fi
  else
    RES_SRC="the built-in default: there is no $pj"
  fi
  # The sensor's built-in defaults ARE policy.default.json (sensor_gate proves it).
  for def in "${FROM:+$FROM/policy.default.json}" "$APP/current/share/policy.default.json"; do
    [[ -n $def && -f $def ]] || continue
    os_num "$($PLUTIL -extract memory.os_reserve_gb raw -o - "$def" 2>/dev/null)" && { v=$REPLY; break; }
  done
  [[ -n $v ]] && (( ${#v} <= 8 )) || v=6
  REPLY=$v
}
# The registry as the ENGINE reads it -- sensor/procinfo.mm read_registry, SCHEMA §5/§6 --
# rule for rule, so the report says what admission will do. (Review 2026-10-09, round 2:
# this walk skipped envelopes over 64 KiB, which the engine COUNTS -- unverifiable, its
# declared reservation held while the pid lives -- a false all-clear; and it read peak_gb
# as `<->(|.<->)` where the engine uses strtod, so '31.0000000000000', '3.1e1', ' 31' and
# '31.' were called unreadable (exit 75) while the engine reserves 31 GiB, and a fitting
# '2.0e1' raised a false alarm.) Read-only: nothing here writes or signals anything.
PF_WS=$' \t\r\n'            # util.mm trim()
typeset -gA PF_KV
pf_envelope() {   # pf_envelope <file> <lstat size> -> PF_KV, PF_OVER; 1 = skip it, 2 = unreadable (PF_ERR)
  # read_file(path, 64 KiB, no follow): O_NONBLOCK|O_NOFOLLOW, a regular file, at most
  # min(64 KiB, size + 1) bytes. Larger than 64 KiB: its first 64 KiB, and "oversize".
  local f=$1 size=$2 fd buf="" chunk line k n=0
  local -i want
  local -A fs
  PF_KV=(); PF_OVER=0; PF_ERR=""
  if ! sysopen -r -o nonblock,nofollow -u fd "$f" 2>/dev/null; then
    # Released since the walk (ENOENT) or replaced by a symlink or a non-regular file
    # (ELOOP, EINVAL): the engine skips it. Any other error (EACCES, EIO) makes the
    # engine's whole registry unreadable.
    [[ -f $f && ! -L $f ]] || return 1
    PF_ERR="cannot read envelope $f"
    return 2
  fi
  if ! zstat -H fs -f $fd 2>/dev/null || (( (fs[mode] & 0xF000) != 0x8000 )); then exec {fd}<&-; return 1; fi
  want=$(( fs[size] + 1 )); (( want > 65536 )) && want=65536
  while (( ${#buf} < want )); do                       # LC_ALL=C: ${#buf} counts bytes
    sysread -s $(( want - ${#buf} )) -i $fd chunk || break
    buf+=$chunk
  done
  exec {fd}<&-
  (( size > 65536 || ( ${#buf} >= 65536 && ${#buf} > fs[size] ) )) && PF_OVER=1
  # parse_kv: '\n'-separated lines cut at 4096 bytes, one trailing CR dropped, a key of
  # [A-Za-z0-9_]{1,64} before the FIRST '=', the FIRST occurrence wins -- keys after
  # `cmd` included.
  for line in "${(@f)buf}"; do
    line=${line[1,4096]}; line=${line%$'\r'}
    [[ $line == (#b)([A-Za-z0-9_](#c1,64))=(*) ]] || continue
    k=$match[1]
    [[ $k == (pid|name|peak_gb|pstart|started|boot) ]] && (( ! ${+PF_KV[$k]} )) || continue
    PF_KV[$k]=$match[2]
    (( ++n == 6 )) && break
  done
  return 0
}
pf_i64() {   # pf_i64 <text>: parse_i64 (trim, 1..20 bytes, strtoll base 10, whole, in range) -> REPLY = [-]digits
  local t=${${1##[$PF_WS]##}%%[$PF_WS]##} s d
  (( ${#t} >= 1 && ${#t} <= 20 )) || return 1
  t=${t##[$' \t\n\v\f\r']##}                           # strtoll skips isspace itself
  [[ $t == (#b)([+-]|)([0-9]##) ]] || return 1
  s=${match[1]#+}; d=${match[2]##0##}; d=${d:-0}
  (( ${#d} < 19 )) || [[ ${#d} == 19 && ( $d < 9223372036854775808 || ( $s == - && $d == 9223372036854775808 ) ) ]] || return 1
  REPLY=$s$d
}
pf_dbl() {   # pf_dbl <text>: parse_dbl (trim, 1..64 bytes, strtod whole, no ERANGE, finite) -> REPLY (%.17g), PF_TXT (trimmed)
  local t=${${1##[$PF_WS]##}%%[$PF_WS]##} o
  PF_TXT=$t
  (( ${#t} >= 1 && ${#t} <= 64 )) || return 1
  # printf(1) IS strtod (+ an ERANGE and a whole-string check), except that it reads a
  # leading quote as a character constant, which strtod does not convert.
  [[ $t == [\'\"]* ]] && return 1
  o=$(/usr/bin/printf '%.17g' "$t" 2>/dev/null) || return 1
  [[ $o == (|-)[0-9]##(|.[0-9]##)(|e[-+][0-9]##) ]] || return 1    # inf, nan: not finite
  REPLY=$o
}
pf_proc() {   # pf_proc <pid>: running and not a zombie (proc_info: a zombie is dead) -> PF_START (epoch, -1 unknown)
  local o v; local -a w
  PF_START=-1
  o=$(TZ=UTC ps -o stat= -o lstart= -p $1 2>/dev/null); w=(${=o})   # ps sees another uid's process too, as proc_info does
  (( ${#w} )) && [[ $w[1] != Z* ]] || return 1
  local TZ=UTC
  strftime -r -s v '%a %b %d %H:%M:%S %Y' "${(j: :)w[2,-1]}" 2>/dev/null && [[ $v == <-> ]] && PF_START=$v
  return 0
}
reservation_preflight() {
  local ramb res f jd="$FH/jobs" regerr="" pidv idn ido name pk val boot="" n=0 over=0 bad=0
  local -F sum=0 budget
  local -A st
  local -a ents envs msgs
  ramb=$(sysctl -n hw.memsize 2>/dev/null)
  [[ $ramb == <-> ]] || { say "preflight: reservations not checked (hw.memsize unreadable)"; return 0; }
  os_reserve_gb $ramb; res=$REPLY
  budget=$(( ramb / 1073741824.0 - res ))
  say "preflight: heavy admission budget = RAM $(printf '%.1f' $(( ramb / 1073741824.0 ))) GiB - os_reserve $res GiB = $(printf '%.1f' $budget) GiB (os_reserve from $RES_SRC)"
  (( ${+builtins[sysopen]} && ${+builtins[sysread]} )) || { say "preflight: envelopes not checked (zsh/system unavailable: no non-blocking read)"; return 0; }
  # SCHEMA §6 registry limits: a registry that cannot be read completely is an error for
  # the engine (every admission exits 75), never a shorter registry. No jobs/ is empty.
  if [[ -e $jd ]]; then
    if [[ ! -d $jd ]]; then regerr="$jd is not a directory"
    elif [[ ! -r $jd ]]; then regerr="cannot read $jd"
    else
      ents=("$jd"/*(DN)); envs=("$jd"/*.job(N.))      # envelopes: REGULAR *.job, no dot name (lstat)
      if (( ${#ents} > 4096 )); then regerr="$jd has more than 4096 entries"
      elif (( ${#envs} > 1024 )); then regerr="$jd holds ${#envs} envelopes, more than 1024"; fi
    fi
  fi
  [[ -n $regerr ]] && envs=()
  for f in $envs; do
    zstat -L -H st -- "$f" 2>/dev/null || continue     # released since the walk
    pf_envelope "$f" $st[size]
    case $? in 1) continue ;; 2) regerr=$PF_ERR; break ;; esac
    # Identity (§5), in the engine's order: canonical pid (the file stem only while the
    # pid key is ABSENT); running and not a zombie; boot; pstart ±1, else started + 5,
    # else unverifiable. Larger than 64 KiB: unverifiable whatever its keys. LIVE = ok or
    # unverifiable; both hold their reservation (FO-5).
    pidv=${PF_KV[pid]-${${f:t}%.job}}
    [[ $pidv == [1-9][0-9](#c0,4) ]] || continue     # invalid: dead, never counted
    pf_proc $pidv || continue                          # dead
    idn=""
    if [[ -n ${PF_KV[boot]:-} ]]; then
      [[ -n $boot ]] || boot=$(sysctl -n kern.bootsessionuuid 2>/dev/null)
      [[ -n $boot && $PF_KV[boot] != $boot ]] && idn=mismatch
    fi
    if [[ -n $idn ]]; then :
    elif (( ${+PF_KV[pstart]} )) && pf_i64 "$PF_KV[pstart]"; then
      if (( PF_START < 0 )); then idn=unverifiable
      elif [[ $REPLY == -* ]] || (( ${#REPLY} > 12 )); then idn=mismatch
      elif (( PF_START - REPLY <= 1 && REPLY - PF_START <= 1 )); then idn=ok
      else idn=mismatch; fi
    elif (( ${+PF_KV[started]} )) && pf_i64 "$PF_KV[started]"; then
      if (( PF_START < 0 )); then idn=unverifiable
      elif [[ $REPLY == -* ]]; then idn=mismatch      # a process younger than started + 5 <= 5
      elif (( ${#REPLY} > 15 || PF_START <= REPLY + 5 )); then idn=ok
      else idn=mismatch; fi
    else idn=unverifiable; fi
    (( PF_OVER )) && idn=unverifiable
    [[ $idn == mismatch ]] && continue
    ido=$idn; (( PF_OVER )) && ido+=", larger than 64 KiB"
    (( n++ ))
    name=${(V)${${PF_KV[name]:-?}[1,64]}}
    if ! (( ${+PF_KV[peak_gb]} )); then
      (( bad++ ))
      msgs+=("UNREADABLE RESERVATION: jobs/${(V)f:t} '$name' (pid $pidv, identity $ido) declares no peak_gb: every admission is undecidable (exit 75) while it is registered.")
      continue
    fi
    if ! pf_dbl "$PF_KV[peak_gb]" || (( REPLY < 0 )); then
      (( bad++ ))
      msgs+=("UNREADABLE RESERVATION: jobs/${(V)f:t} '$name' (pid $pidv, identity $ido) declares peak_gb='${(V)${PF_KV[peak_gb][1,32]}}': every admission is undecidable (exit 75) while it is registered.")
      continue
    fi
    val=$REPLY; pk=${(V)PF_TXT}
    [[ $PF_TXT == [0-9]##(|.[0-9]##) ]] || pk+=" (= $val GiB)"
    (( sum += val ))
    if (( val > budget )); then
      (( over++ ))
      msgs+=("RESERVATION EXCEEDS THE HEAVY BUDGET: jobs/${(V)f:t} '$name' (pid $pidv, live, identity $ido) declares peak_gb=$pk > $(printf '%.1f' $budget) GiB: heavy admission will be denied while it is registered.")
    fi
  done
  if [[ -n $regerr ]]; then
    print -r -- "forge-guardian-install: preflight: UNREADABLE REGISTRY: ${(V)regerr}: every admission is undecidable (exit 75) until it is fixed (report only: nothing was changed)."
    return 0
  fi
  for f in $msgs; do print -r -- "forge-guardian-install: preflight: $f"; done
  if (( over )); then
    print -r -- "forge-guardian-install: preflight:   every job declaring more than memory.light_job_gb fails the budget test while it holds that reservation. Report only: nothing was changed or signalled. To reopen heavy admission, re-register it with a declaration that fits (<= $(printf '%.1f' $budget) GiB) or stop it."
  elif (( sum > budget )); then
    print -r -- "forge-guardian-install: preflight: the live envelopes together declare $(printf '%.1f' $sum) GiB > $(printf '%.1f' $budget) GiB: heavy admission will be denied while they are registered (report only)."
  elif (( ! bad )); then
    say "preflight: $n live envelope(s), $(printf '%.1f' $sum) GiB declared: within the heavy budget"
  fi
  return 0
}

# ---- install / upgrade ---------------------------------------------------------------
cmd_install_dry_run() {   # read-only: what install would do, and the reservation preflight
  local cur prev t f p a prog kind
  local -a legacy
  say "dry run: nothing is written, built, started or signalled"
  say "dry run: source $FROM; home $H"
  cur=$(release_of current) || cur=""; prev=$(release_of previous) || prev=""
  say "dry run: current release: ${cur:-none}; previous: ${prev:-none}"
  for t in $ALL_TOOLS; do f="$FH/bin/$t"; [[ -f $f && ! -L $f ]] && legacy+=($t); done
  (( ${#legacy} )) && say "dry run: hand-copied tools in $FH/bin would be snapshotted as the rollback target: ${(j: :)${(o)legacy}}"
  say "dry run: plist $PLIST: $([[ -f $PLIST ]] && print 'present; replaced by a generated one if it differs' || print 'absent; would be generated')"
  if (( NO_SERVICE )); then say "dry run: service not touched (--no-service)"
  elif p=$(svc_pid); then
    capture_service
    if [[ $CAP_PID == $p && $CAP_KIND == legacy ]]; then
      say "dry run: the running governor (pid $p, $CAP_ARGS) is not known to publish UNKNOWN when stopped (v1's TERM trap publishes GREEN): it would be SIGSTOPped, re-verified, its process tree frozen, UNKNOWN published, then the tree SIGKILLed before the bootout"
    elif [[ $CAP_PID == $p ]]; then
      say "dry run: the running governor (pid $p) publishes UNKNOWN when stopped: launchctl bootout"
    else
      say "dry run: launchd runs pid $p for $LABEL, which is not a forge-guardian: launchctl bootout"
    fi
  else
    say "dry run: no service running for $LABEL"
  fi
  # The sensor that would admit: the prebuilt one this install would stage, else the
  # installed one (a dry run builds nothing, so from sources the key is reconstructed).
  if [[ -n ${FORGE_GUARDIAN_SENSOR_PREBUILT:-} ]]; then PF_SENSOR=$FORGE_GUARDIAN_SENSOR_PREBUILT; else pf_sensor_default; fi
  reservation_preflight
  say "dry run: preflight passed; 'install' would build, stage, validate and switch"
}

cmd_install() {
  FROM=${FROM:-${SELF:h}}; FROM=${FROM:A}
  preflight
  (( NO_SERVICE )) || guard_service
  if (( DRY_RUN )); then cmd_install_dry_run; return 0; fi
  take_lock
  SOURCE_COMMIT=$(source_commit_of)
  stage_release
  validate_staging || die 1 "validation of the staged release failed; nothing was changed"
  # Report only, BEFORE the cutover, judged by the STAGED sensor: the one that admits
  # once this install is done.
  PF_SENSOR="$STG/bin/forge-guardian-sensor"
  reservation_preflight
  if (( RUN_TESTS )); then
    run_staged_tests || die 1 "--run-tests: a gate failed against the staged release; nothing was changed"
  fi
  local newplist="$APP/plist.$$.xml"
  gen_plist "$newplist" || { /bin/rm -f "$newplist" "$newplist.json"; die 70 "could not generate a valid plist for $H"; }

  local cur; cur=$(release_of current)
  if [[ $cur == $V ]] && [[ -f $PLIST ]] && cmp -s "$newplist" "$PLIST"; then
    /bin/rm -f "$newplist"
    ensure_links >/dev/null || warn "some links could not be repaired"
    say "already installed $V"
    return 0
  fi

  # Promote: staging -> releases/<V> (or reuse an intact identical release).
  mkdir -p "$APP/releases" && /bin/chmod 755 "$APP/releases"
  local REL="$APP/releases/$V"
  if [[ -d $REL ]]; then
    if manifest_matches "$REL"; then say "release $V already present and intact; reusing it"; /bin/rm -rf "$STG"
    else /bin/mv "$REL" "$REL.corrupt.$EPOCHSECONDS"; warn "release $V was damaged; moved aside"; fi
  fi
  if [[ ! -d $REL ]]; then
    write_manifest "$STG" || die 70 "cannot write MANIFEST.json"
    /bin/mv "$STG" "$REL" || die 70 "cannot rename staging to $REL"
    say "release $V staged and validated (sensor basis: $BASIS)"
  fi
  STG=""

  tx_begin

  # First install over a hand-copied ~/.forge-health/bin: keep those files.
  local -a legacy; local t f lines="" hex LEG=""
  for t in $ALL_TOOLS; do f="$FH/bin/$t"; [[ -f $f && ! -L $f ]] && legacy+=($t); done
  if (( ${#legacy} )); then
    for t in ${(o)legacy}; do lines+="bin/$t $(sha_of "$FH/bin/$t")"$'\n'; done
    hex=$(sha_str "$lines"); hex=${hex[1,12]}
    LEG="$APP/releases/legacy-$hex"
    if [[ ! -d $LEG ]]; then
      mkdir -p "$LEG/bin" || fail_and_rollback "cannot create $LEG"
      for t in $legacy; do /bin/cp -p "$FH/bin/$t" "$LEG/bin/$t" || fail_and_rollback "cannot snapshot $FH/bin/$t"; done
      /bin/chmod 0755 "$LEG" "$LEG/bin"; /bin/chmod 0555 "$LEG"/bin/*
      (( TX_HAD_PLIST )) && /bin/cp "$TX/plist" "$LEG/launchd.plist.previous"
      write_atomic "$LEG/MANIFEST.json" 0444 "{\"schema\": \"forge.guardian.manifest/1\", \"version\": $(json_str legacy-$hex), \"source\": $(json_str "snapshot of hand-copied $FH/bin"), \"built_at\": $(json_str "$(iso_now)")}"
      say "snapshotted the hand-copied tools in $FH/bin into $LEG (rollback target)"
    fi
  fi

  # Switch: current <- V, previous <- old current (or the legacy snapshot).
  local prev_new=""
  if [[ -n $TX_CUR && ${TX_CUR:t} != $V ]]; then prev_new="releases/${TX_CUR:t}"
  elif [[ -z $TX_CUR && -n $LEG ]]; then prev_new="releases/${LEG:t}"
  fi
  SWITCHED=1
  swap_link "$APP/current" "releases/$V" || fail_and_rollback "cannot switch $APP/current"
  [[ -n $prev_new ]] && { swap_link "$APP/previous" "$prev_new" || fail_and_rollback "cannot switch $APP/previous"; }
  ensure_links || fail_and_rollback "could not create the tool links in $FH/bin"

  # The plist, keeping the one it replaces beside the release it served.
  mkdir -p "$LA" 2>/dev/null
  if ! { [[ -f $PLIST ]] && cmp -s "$newplist" "$PLIST"; }; then
    if (( TX_HAD_PLIST )); then
      if [[ -n $TX_CUR && -d $APP/releases/${TX_CUR:t} ]]; then /bin/cp "$TX/plist" "$APP/releases/${TX_CUR:t}/launchd.plist.previous"
      elif [[ -n $LEG ]]; then :   # already kept with the legacy snapshot
      else /bin/cp "$TX/plist" "$APP/launchd.plist.previous"; fi
    fi
    place_file "$newplist" "$PLIST" 0644 || fail_and_rollback "cannot write $PLIST"
    say "wrote $PLIST"
  fi
  /bin/rm -f "$newplist"

  local incomplete=0 erc
  if (( NO_SERVICE )); then
    say "service not touched (--no-service)"
  else
    stop_service "guardian upgrade in progress"
    start_service || fail_and_rollback "the new service did not verify within ${VERIFY_S}s: $VERIFY_WHY"
    say "service running: $LABEL pid=$VERIFIED_PID runs $APP/current/bin/forge-guardian and publishes (evidence not yet confirmed)"
    say "waiting up to ${EVIDENCE_S}s for complete evidence and a state other than UNKNOWN"
    verify_evidence; erc=$?
    case $erc in
      0) say "evidence complete: the governor publishes $EVIDENCE_STATE" ;;
      4) incomplete=1 ;;
      *) fail_and_rollback "the new service $VERIFY_WHY" ;;
    esac
  fi
  write_installed "$V" "$(release_of previous)" || warn "could not write $FH/guardian.installed.json"
  tx_end
  say "installed $V$( [[ -n $(release_of previous) ]] && print " (previous: $(release_of previous))")"
  if (( incomplete )); then
    print -u2 -r -- "forge-guardian-install: installed, but evidence is incomplete: $EVIDENCE_WHY"
    print -u2 -r -- "  after ${EVIDENCE_S}s. The service is LEFT RUNNING -- it publishes UNKNOWN and keeps heavy admission closed,"
    print -u2 -r -- "  which is safer than rolling back to a governor that reports health it never measured."
    print -u2 -r -- "  inspect: forge-guardian-ctl status; forge-guardian-ctl diagnose"
    exit 4
  fi
}

# ---- rollback ---------------------------------------------------------------------
cmd_rollback() {
  (( NO_SERVICE )) || guard_service
  take_lock
  local cur prev
  cur=$(release_of current); prev=$(release_of previous)
  [[ -n $prev && -d $APP/releases/$prev ]] || die 1 "nothing to roll back to (no $APP/previous)"
  [[ -n $cur ]] || die 1 "no current release"
  tx_begin
  SWITCHED=1
  swap_link "$APP/current" "releases/$prev" || fail_and_rollback "cannot switch current"
  swap_link "$APP/previous" "releases/$cur" || fail_and_rollback "cannot switch previous"
  ensure_links || fail_and_rollback "could not create the tool links"
  for t in $ALL_TOOLS; do [[ -e $APP/current/bin/$t ]] || warn "release $prev has no $t: $FH/bin/$t dangles until the next install"; done
  local newplist="$APP/plist.$$.xml"
  gen_plist "$newplist" || fail_and_rollback "could not generate the plist"
  if ! { [[ -f $PLIST ]] && cmp -s "$newplist" "$PLIST"; }; then
    place_file "$newplist" "$PLIST" 0644 || fail_and_rollback "cannot write $PLIST"
  fi
  /bin/rm -f "$newplist"
  if (( ! NO_SERVICE )); then
    stop_service "guardian rollback in progress"
    start_service || fail_and_rollback "the rolled-back service did not verify: $VERIFY_WHY"
    say "service verified: pid=$VERIFIED_PID"
  fi
  SOURCE_COMMIT=unknown
  [[ -r $APP/releases/$prev/MANIFEST.json ]] && SOURCE_COMMIT=$($PLUTIL -extract source_commit raw -o - "$APP/releases/$prev/MANIFEST.json" 2>/dev/null || print unknown)
  write_installed "$prev" "$cur"
  tx_end
  say "rolled back: current $prev, previous $cur"
}
jx_installed() { $PLUTIL -extract "$1" raw -o - "$FH/guardian.installed.json" 2>/dev/null || print unknown; }

# ---- uninstall --------------------------------------------------------------------
cmd_uninstall() {
  (( NO_SERVICE )) || guard_service
  take_lock
  local t f n=0
  if (( ! NO_SERVICE )); then
    stop_service "guardian uninstalled: this domain is not governed" && say "service stopped ($LABEL booted out)"
  fi
  if [[ -f $PLIST ]]; then /bin/rm -f "$PLIST" && say "removed $PLIST"; fi
  for t in $LOCAL_TOOLS; do
    f="$LOCALBIN/$t"
    [[ -L $f && "$(readlink "$f")" == "$FH/bin/$t" ]] && /bin/rm -f "$f" && say "removed $f"
  done
  for t in $ALL_TOOLS; do
    f="$FH/bin/$t"
    if [[ -L $f && "$(readlink "$f")" == "$APP/"* ]]; then /bin/rm -f "$f" && (( n++ ))
    elif [[ -f $f && ! -L $f ]]; then warn "kept the regular file $f (not installed by this tool)"; fi
  done
  say "removed $n tool links from $FH/bin"
  /bin/rm -f "$FH/guardian.installed.json"
  local -a live; local p
  # `(N.)`: regular files only -- sed on a FIFO named *.job blocks for ever (R1).
  for f in "$FH"/jobs/*.job(N.); do
    p=$(sed -n 's/^pid=//p' "$f" | head -1)
    [[ $p == [1-9][0-9](#c0,4) ]] && kill -0 $p 2>/dev/null && live+=("${f:t} ($(sed -n 's/^name=//p' "$f" | head -1))")
  done
  (( ${#live} )) && warn "kept the envelopes of live jobs: ${(j:, :)live} -- they are no longer governed"
  if (( PURGE )); then
    /bin/rm -rf "$APP" && say "purged $APP"
  else
    say "releases kept in $APP (uninstall --purge removes them)"
  fi
  say "forge-job, forge-gate, forge-nproc and forge-guardian-ctl are now UNAVAILABLE; $FH (state, evidence, policy) is kept."
}

cmd_status() {
  print -r -- "home:     $H"
  print -r -- "current:  $(release_of current || print none)"
  print -r -- "previous: $(release_of previous || print none)"
  print -r -- "releases: ${(j: :)${(@)${(@f)$(print -l "$APP"/releases/*(N/:t))}}}"
  print -r -- "plist:    $([[ -f $PLIST ]] && print $PLIST || print none)"
  print -r -- "installed: $([[ -r $FH/guardian.installed.json ]] && jx_installed version || print none)"
  pf_sensor_default            # the installed sensor judges the budget it enforces
  reservation_preflight
}

# ---- main -------------------------------------------------------------------------
SUB=${1:-}
(( $# )) && shift
NO_SERVICE=0; RUN_TESTS=0; PURGE=0; DRY_RUN=0; FROM=""
while (( $# )); do
  case $1 in
    --from)       (( $# >= 2 )) || die 2 "--from needs a directory"; FROM=$2; shift 2 ;;
    --no-service) NO_SERVICE=1; shift ;;
    --run-tests)  RUN_TESTS=1; shift ;;
    --dry-run)    DRY_RUN=1; shift ;;
    --purge)      PURGE=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; die 2 "unknown argument '$1'" ;;
  esac
done
[[ -z $FROM || -d $FROM ]] || die 2 "--from $FROM is not a directory"
(( DRY_RUN )) && [[ $SUB != (install|upgrade) ]] && die 2 "--dry-run is for install|upgrade"
trap 'cleanup_staging; /bin/rm -f "$APP/plist.$$.xml" "$APP/plist.$$.xml.json" 2>/dev/null' EXIT
case $SUB in
  install|upgrade) cmd_install ;;
  rollback)        cmd_rollback ;;
  uninstall)       cmd_uninstall ;;
  status)          cmd_status ;;
  -h|--help|help)  usage ;;
  *)               usage >&2; exit 2 ;;
esac
