#
# Writes the C++ include that carries every file component.json lists, byte for
# byte, as string literals of \xHH escapes. Run as a build step:
#
#   cmake -DCOMPONENT=<this component's directory> -DOUT=<fcmat_resources.inc> -P embed_resources.cmake
#
# The list comes from component.json and NOT from a directory glob, so the library
# carries exactly the recorded import: a file that is listed and missing stops the
# build, and a file that is on disk but unlisted is refused by
# tools/gates/freecad_derived_compliance_gate.sh.
cmake_minimum_required(VERSION 3.20)

if(NOT COMPONENT OR NOT OUT)
    message(FATAL_ERROR "embed_resources.cmake needs -DCOMPONENT and -DOUT")
endif()

file(READ "${COMPONENT}/component.json" _record)
string(JSON _commit GET "${_record}" upstream commit)
if(NOT _commit MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "component.json records no upstream commit")
endif()
string(LENGTH "${_commit}" _commit_len)
if(NOT _commit_len EQUAL 40)
    message(FATAL_ERROR "component.json's upstream commit is not a full 40-digit hash")
endif()
string(JSON _count LENGTH "${_record}" files)
if(_count EQUAL 0)
    message(FATAL_ERROR "component.json lists no files")
endif()

set(_text "// GENERATED by cmake/embed_resources.cmake from component.json -- do not edit.\n")
string(APPEND _text "// SPDX-License-Identifier: LGPL-2.1-or-later (the embedded files keep their own\n")
string(APPEND _text "// licences, recorded per file in component.json).\n")
string(APPEND _text "#include <cstddef>\nnamespace {\n")
string(APPEND _text "const char kFcmatUpstreamCommit[] = \"${_commit}\";\n")
string(APPEND _text "struct FcmatEntry { const char* path; const char* bytes; std::size_t size; };\n")

# 80 bytes (160 hex digits) per source line keeps the generated file readable in
# a diff viewer and well inside every compiler's line limits.
string(REPEAT "." 160 _line)
math(EXPR _last "${_count} - 1")
set(_table "const FcmatEntry kFcmatFiles[] = {\n")
foreach(_i RANGE ${_last})
    string(JSON _path GET "${_record}" files ${_i} path)
    set(_file "${COMPONENT}/${_path}")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "component.json lists ${_path}, which is not in ${COMPONENT}")
    endif()
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _digits)
    math(EXPR _bytes "${_digits} / 2")
    string(REGEX REPLACE "(${_line})" "\\1\n" _hex "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" _hex "${_hex}")
    string(REPLACE "\n" "\"\n    \"" _hex "${_hex}")
    string(APPEND _text "const char kFile${_i}[] =\n    \"${_hex}\";\n")
    # A path is plain ASCII by construction of the importer; a quote or a
    # backslash in one would break the literal, so it is refused, not escaped.
    if(_path MATCHES "[\"\\\\]")
        message(FATAL_ERROR "refusing a path that needs escaping: ${_path}")
    endif()
    string(APPEND _table "    {\"${_path}\", kFile${_i}, ${_bytes}u},\n")
endforeach()
string(APPEND _table "};\n")
string(APPEND _text "${_table}}  // namespace\n")

# Written only when it changed, so an unrelated reconfigure does not recompile the
# library and relink everything that loads it.
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
