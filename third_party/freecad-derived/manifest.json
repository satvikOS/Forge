{
  "$schema_version": "forge-freecad-derived/1",
  "$doc": [
    "Every component under third_party/freecad-derived/. One entry per component.",
    "tools/gates/freecad_derived_lgpl_gate.sh reads this file and fails when a",
    "component directory exists without an entry, an entry names a directory that",
    "does not exist, or a component lacks COPYING.LGPL, MODIFICATIONS.md, NOTICE or",
    "its THIRD_PARTY_NOTICES.md section. A component is always a SHARED library",
    "linked dynamically by Forge; `library` is its file name in",
    "Forge.app/Contents/Frameworks."
  ],
  "upstream": {
    "project": "FreeCAD",
    "repository": "https://github.com/FreeCAD/FreeCAD"
  },
  "components": [
