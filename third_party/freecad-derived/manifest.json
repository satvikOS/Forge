      "license": "LGPL-2.1-or-later",
      "upstream_commit": "0a45a0a008d4af7a85601016c5ab31bd26c25b22",
      "upstream_paths": [
        "src/App/Expression.h",
        "src/App/Expression.cpp",
        "src/App/Expression.y",
