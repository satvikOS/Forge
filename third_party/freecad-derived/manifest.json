        "src/App/ExpressionParser.h",
        "src/App/ExpressionParser.sh",
        "src/App/ObjectIdentifier.cpp (App::quote only)",
        "src/Base/Unit.h",
        "src/Base/Unit.cpp",
        "src/Base/Quantity.h",
        "src/Base/Quantity.cpp",
        "src/Base/UnitsConvData.h",
        "src/Base/Exception.h (subset)",
        "tests/src/App/Expression.cpp (cases)",
