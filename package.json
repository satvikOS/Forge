{
  "name": "archdiscv1",
  "version": "1.11.0",
  "description": "ArchDisc - Professional 3D Architectural Design Platform",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "install": "npm install --prefix backend && npm install --prefix frontend",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "electron:dev": "cd frontend && npx vite --port 3000 & sleep 3 && npx electron . --dev",
    "electron:build": "cd frontend && npx vite build && npx electron-builder --win --x64",
    "electron:start": "npx electron .",
    "vercel-build": "cd frontend && npm run build"
  },
  "keywords": [
    "architecture",
    "3d",
    "design",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/vertexai": "^1.7.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "serverless": "^3.38.0",
    "serverless-cloudfront-invalidate": "^1.12.2",
    "serverless-offline": "^13.3.3",
    "serverless-s3-sync": "^3.5.1"
  }
}
